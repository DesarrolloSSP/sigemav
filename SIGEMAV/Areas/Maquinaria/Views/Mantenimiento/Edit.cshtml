       required />
    <span asp-validation-for="FechaInicioTrabajo" class="text-danger small"></span>
    <div class="form-text extra-small">
        Fecha y hora en que inició el mantenimiento.
    </div>
</div>




<!-- FECHA FIN TRABAJO -->
<div class="col-lg-3 col-md-6">
    <label asp-for="FechaFinTrabajo" class="form-label fw-semibold text-dark">
        Fin de Trabajo <span class="text-danger">*</span>
    </label>

      <input asp-for="FechaFinTrabajo"
       type="datetime-local"
       id="FechaFinTrabajo"
       class="form-control rounded-2"
       value="@(Model.FechaFinTrabajo?.ToString("yyyy-MM-ddTHH:mm", System.Globalization.CultureInfo.InvariantCulture))"

    <script>
        function formatoMoneda(valor) {
            return valor.toLocaleString("es-MX", {
                style: "currency",
                currency: "MXN",
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function recalcularTotales() {
            let totalGeneralConIva = 0;

            $("#tablaServicios tbody tr").each(function () {
                const cantidad = parseFloat($(this).find("input[name*='Cantidad']").val()) || 0;
                const moBase = parseFloat($(this).find(".costoManoObraBase").val()) || 0;
                const refBase = parseFloat($(this).find(".costoRefaccionesBase").val()) || 0;

                // Cálculo base renglón + IVA 16%
                const baseFila = cantidad * (moBase + refBase);
                const ivaFila = baseFila * 0.16;
                const totalFila = baseFila + ivaFila;

                $(this).find(".totalLinea").val(totalFila.toLocaleString("es-MX", { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                totalGeneralConIva += totalFila;
            });

            // Si tienes un input general para el costo total real
            const inputCostoReal = $("#CostoRealTotal");
            if (inputCostoReal.length) {
                inputCostoReal.val(formatoMoneda(totalGeneralConIva));
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            recalcularTotales();

            const fechaInicio = document.getElementById("FechaInicioTrabajo");
            const fechaFin = document.getElementById("FechaFinTrabajo");

            function obtenerDateTimeLocalLimpio(val) {
                if (!val) return "";
                let limpia = val.replace(" ", "T");
                return limpia.length > 16 ? limpia.substring(0, 16) : limpia;
            }

            if (fechaInicio && fechaFin) {
                fechaInicio.removeAttribute("max");
                fechaFin.removeAttribute("max");

                if (fechaInicio.value) {
                    fechaInicio.value = obtenerDateTimeLocalLimpio(fechaInicio.value);
                    fechaFin.setAttribute("min", fechaInicio.value);
                }

                if (fechaFin.value) {
                    fechaFin.value = obtenerDateTimeLocalLimpio(fechaFin.value);
                    fechaInicio.setAttribute("max", fechaFin.value);
                }

                fechaInicio.addEventListener("change", function () {
                    if (fechaInicio.value) {
                        const valInicio = obtenerDateTimeLocalLimpio(fechaInicio.value);
                        fechaFin.setAttribute("min", valInicio);

                        if (fechaFin.value && fechaFin.value < valInicio) {
                            fechaFin.value = valInicio;
                        }
                    } else {
                        fechaFin.removeAttribute("min");
                    }
                });

                fechaFin.addEventListener("change", function () {
                    if (fechaFin.value) {
                        const valFin = obtenerDateTimeLocalLimpio(fechaFin.value);
                        fechaInicio.setAttribute("max", valFin);
                    } else {
                        fechaInicio.removeAttribute("max");
                    }
                });
            }
        });

        // Validación al enviar el formulario
        $("#formEditMantenimiento").on("submit", function (e) {
            const fechaInicioVal = $("#FechaInicioTrabajo").val();
            const fechaFinVal = $("#FechaFinTrabajo").val();

            const kmEntrada = parseInt($("#KilometrajeEntrada").val() || $("input[name='KilometrajeEntrada']").val()) || 0;
            const kmSalidaVal = $("#KilometrajeSalida").val();
            const kmSalida = parseInt(kmSalidaVal) || 0;
            const observacionesVal = $.trim($("#Observaciones").val());

            if (!fechaInicioVal) {
                e.preventDefault();
                Swal.fire({ icon: "warning", title: "Campo requerido", text: "Debe ingresar la fecha y hora de inicio del trabajo.", confirmButtonColor: '#800705' });
                return;
            }

            if (!fechaFinVal) {
                e.preventDefault();
                Swal.fire({ icon: "warning", title: "Campo requerido", text: "Debe ingresar la fecha y hora de fin del trabajo.", confirmButtonColor: '#800705' });
                return;
            }

            if (fechaFinVal < fechaInicioVal) {
                e.preventDefault();
                Swal.fire({ icon: "error", title: "Rango de fechas inválido", text: "La fecha y hora de fin del trabajo no puede ser anterior a la fecha de inicio.", confirmButtonColor: '#800705' });
                return;
            }

            if (!kmSalidaVal || isNaN(kmSalida)) {
                e.preventDefault();
                Swal.fire({ icon: "warning", title: "Campo requerido", text: "Debe registrar el kilometraje de salida del vehículo.", confirmButtonColor: '#800705' });
                return;
            }

            if (kmSalida < kmEntrada) {
                e.preventDefault();
                Swal.fire({ icon: "error", title: "Kilometraje inválido", text: `El kilometraje de salida (${kmSalida.toLocaleString()} km) no puede ser menor al kilometraje de entrada (${kmEntrada.toLocaleString()} km).`, confirmButtonColor: '#800705' });
                return;
            }

            if (!observacionesVal) {
                e.preventDefault();
                Swal.fire({ icon: "warning", title: "Campo requerido", text: "Los comentarios finales u observaciones técnicas son obligatorios.", confirmButtonColor: '#800705' });
                return;
            }
        });
    </script>
}
@model SIGEMAV.Models.ViewModels.Maquinaria.MantenimientoEditViewModel

<div class="container-fluid px-3">
    <div class="card shadow-sm border-0 rounded-3">

        <!-- ENCABEZADO PRINCIPAL -->
        <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-gear-wide-connected text-primary fs-4"></i>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        Mantenimiento en proceso
                    </h5>
                    <small class="text-muted extra-small">
                        Seguimiento operativo, registro de ejecución y cierre técnico
                    </small>
                </div>
            </div>
            <a asp-controller="SolicitudMantenimiento"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm px-3 rounded-2 d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Regresar</span>
            </a>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post" id="formEditMantenimiento">
                @Html.AntiForgeryToken()
                <input asp-for="MantenimientoId" type="hidden" />
                <input asp-for="SolicitudMantenimientoId" type="hidden" />

                <!-- ============================================== -->
                <!-- DATOS GENERALES Y RESUMEN UNIDAD -->
                <!-- ============================================== -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                    <div class="card-header bg-light border-bottom py-3 px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-car-front text-primary fs-6"></i>
                        <h6 class="fw-bold mb-0 text-dark">
                            Información de la unidad vehicular
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row align-items-center g-4">

                            <!-- MARCA / MODELO E IDENTIFICADORES -->
                            <div class="col-lg-7 border-end-lg pe-lg-4">
                                <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                                    Unidad Vehicular
                                </div>
                                <h3 class="fw-bold text-dark mb-3">
                                    @Model.Marca <span class="fw-normal text-secondary">@Model.Modelo</span>
                                </h3>

                                <div class="row g-2 text-center">
                                    <!-- NÚMERO DE SERIE -->
                                    <div class="col-md-4">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                                                No. de Serie
                                            </div>
                                            <div class="fw-semibold text-dark text-truncate" title="@Model.NumeroSerie">
                                                @(string.IsNullOrWhiteSpace(Model.NumeroSerie) ? "N/A" : Model.NumeroSerie)
                                            </div>
                                        </div>
                                    </div>

                                    <!-- PLACA -->
                                    <div class="col-md-4">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                                                Placa
                                            </div>
                                            <div class="fw-semibold text-dark">
                                                @(string.IsNullOrWhiteSpace(Model.PlacaActual) ? "Sin placa" : Model.PlacaActual)
                                            </div>
                                        </div>
                                    </div>

                                    <!-- NÚMERO ECONÓMICO -->
                                    <div class="col-md-4">
                                        <div class="p-2 rounded bg-light border">
                                            <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                                                No. Económico
                                            </div>
                                            <div class="fw-semibold text-dark">
                                                @(string.IsNullOrWhiteSpace(Model.NumeroEconomico) ? "N/A" : Model.NumeroEconomico)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- DATOS DEL OFICIO Y TALLER -->
                            <div class="col-lg-5 ps-lg-4">
                                <div class="p-3 rounded-3 bg-light border">
                                    <div class="mb-3">
                                        <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                                            Número de Oficio
                                        </div>
                                        <div class="fw-bold text-dark fs-6">
                                            <i class="bi bi-file-earmark-text text-secondary me-1"></i>@Model.NumeroOficio
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                                            Taller Asignado
                                        </div>
                                        <div class="fw-bold text-dark fs-6">
                                            <i class="bi bi-tools text-secondary me-1"></i>@Model.TallerTexto
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- REGISTRO DE EJECUCIÓN DEL MANTENIMIENTO -->
                <!-- ============================================== -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                    <div class="card-header bg-light border-bottom py-3 px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-check text-primary fs-6"></i>
                        <h6 class="fw-bold mb-0 text-dark">
                            Registro de ejecución y lecturas del odómetro
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-4">

                            <!-- INICIO TRABAJO -->
                           @*  <div class="col-lg-3 col-md-6">
                                <label asp-for="FechaInicioTrabajo" class="form-label fw-semibold text-dark">

<!-- FECHA INICIO TRABAJO -->
<div class="col-lg-3 col-md-6">
    <label asp-for="FechaInicioTrabajo" class="form-label fw-semibold text-dark">
        Inicio de Trabajo <span class="text-danger">*</span>
    </label>
   <input asp-for="FechaInicioTrabajo"
       type="datetime-local"
       id="FechaInicioTrabajo"
       class="form-control rounded-2"

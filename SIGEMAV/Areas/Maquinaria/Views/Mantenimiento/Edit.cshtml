        Fecha y hora en que concluyó el mantenimiento.
    </div>
</div>



                            <!-- KILOMETRAJE ENTRADA (SOLO LECTURA) -->
                            <div class="col-lg-3 col-md-6">
                                <label class="form-label fw-semibold text-dark">
                                    Kilometraje de Entrada
                                </label>
                                <div class="input-group">
                                    <input type="text"
                                           class="form-control bg-light fw-semibold text-end"
                                           value="@Model.KilometrajeEntrada.ToString("N0")"
                                           readonly
                                           tabindex="-1" />
                                    <span class="input-group-text bg-light text-muted">km</span>
                                </div>
                                <div class="form-text extra-small">
                                    Lectura registrada al ingresar al taller.
                                </div>
                                <input type="hidden"
                                       id="KilometrajeEntrada"
                                       name="KilometrajeEntrada"
                                       value="@Model.KilometrajeEntrada" />
                            </div>

                            <!-- KILOMETRAJE SALIDA -->
                            <div class="col-lg-3 col-md-6">
                                <label asp-for="KilometrajeSalida" class="form-label fw-semibold text-dark">
                                    Kilometraje de Salida <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <input asp-for="KilometrajeSalida"
                                           type="number"
                                           min="@Model.KilometrajeEntrada"
                                           class="form-control text-end rounded-start-2"
                                           required />
                                    <span class="input-group-text bg-light text-muted">km</span>
                                </div>
                                <span asp-validation-for="KilometrajeSalida" class="text-danger small"></span>
                                <div class="form-text extra-small">
                                    Lectura del odómetro al finalizar el mantenimiento.
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- SERVICIOS AUTORIZADOS Y PARTIDAS (CON IVA 16%) -->
                <!-- ============================================== -->
                <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                    <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-wrench-adjustable text-primary fs-5"></i>
                            <h6 class="fw-bold mb-0 text-dark">
                                Servicios autorizados y partidas (Con IVA 16% Desglosado)
                            </h6>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-1 rounded-pill">
                            @Model.Servicios.Count servicio(s)
                        </span>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0" id="tablaServicios" style="min-width: 1000px;">
                                <thead class="bg-light border-bottom text-uppercase extra-small text-muted fw-bold">
                                    <tr>
                                        <th class="ps-4 py-3" style="width: 22%;">Servicio / Concepto</th>
                                        <th class="text-center py-3" style="width: 60px;">Cant.</th>
                                        <th class="text-end py-3" style="width: 110px;">Mano Obra</th>
                                        <th class="py-3" style="width: 15%;">Partida</th>
                                        <th class="text-end py-3" style="width: 110px;">Refacciones</th>
                                        <th class="py-3" style="width: 15%;">Partida</th>
                                        <th class="text-end py-3" style="width: 100px;">IVA (16%)</th>
                                        <th class="text-end pe-4 py-3" style="width: 120px;">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < Model.Servicios.Count; i++)
                                    {
                                        var servicio = Model.Servicios[i];
                                        var partidaMO = string.IsNullOrWhiteSpace(servicio.ObjetoGastoManoObraTexto) ? "-" : servicio.ObjetoGastoManoObraTexto;
                                        var partidaRef = string.IsNullOrWhiteSpace(servicio.ObjetoGastoRefaccionesTexto) ? "-" : servicio.ObjetoGastoRefaccionesTexto;

                                        // Cálculos base e IVA por renglón con los operadores correctos (*)
                                        var subMoBase = servicio.CostoEstimadoManoObra * servicio.Cantidad;
                                        var subRefBase = servicio.CostoEstimadoRefacciones * servicio.Cantidad;
                                        var baseFila = subMoBase + subRefBase;
                                        var ivaFila = baseFila * 0.16m;
                                        var totalFilaConIva = baseFila + ivaFila;

                                        <tr>
                                            <!-- SERVICIO Y OCULTOS -->
                                            <td class="ps-4 py-3">
                                                <input type="hidden" name="Servicios[@i].MantenimientoDetalleId" value="@servicio.MantenimientoDetalleId" />
                                                <input type="hidden" name="Servicios[@i].ConceptoServicioId" value="@servicio.ConceptoServicioId" />

                                                <div class="fw-semibold text-dark text-truncate" style="max-width: 220px;" title="@servicio.ConceptoServicio">
                                                    @servicio.ConceptoServicio
                                                </div>
                                            </td>

                                            <!-- CANTIDAD -->
                                            <td class="text-center py-3">
                                                <input type="hidden" name="Servicios[@i].Cantidad" value="@servicio.Cantidad" />
                                                <input type="number"
                                                       value="@servicio.Cantidad"
                                                       class="form-control form-control-sm text-center bg-light border-0 fw-bold px-1"
                                                       readonly
                                                       tabindex="-1"
                                                       style="max-width: 50px; margin: auto;" />
                                            </td>

                                            <!-- MANO DE OBRA (Base) -> Atributos data para que JS los lea con seguridad -->
                                            <td class="text-end py-3">
                                                <input type="hidden" name="Servicios[@i].CostoUnitarioManoObra" value="@servicio.CostoUnitarioManoObra" />
                                                <input type="hidden" class="costoManoObraBase" value="@servicio.CostoEstimadoManoObra" />
                                                <span class="text-secondary small">@subMoBase.ToString("C")</span>
                                            </td>

                                            <!-- PARTIDA MANO DE OBRA -->
                                            <td class="py-3">
                                                <input type="hidden" name="Servicios[@i].IdObjetoGastoManoObra" value="@servicio.IdObjetoGastoManoObra" />
                                                <div class="extra-small text-muted text-truncate" style="max-width: 150px;" title="@partidaMO">
                                                    @partidaMO
                                                </div>
                                            </td>

                                            <!-- REFACCIONES (Base) -> Atributos data para que JS los lea con seguridad -->
                                            <td class="text-end py-3">
                                                <input type="hidden" name="Servicios[@i].CostoUnitarioRefacciones" value="@servicio.CostoUnitarioRefacciones" />
                                                <input type="hidden" class="costoRefaccionesBase" value="@servicio.CostoEstimadoRefacciones" />
                                                <span class="text-secondary small">@subRefBase.ToString("C")</span>
                                            </td>

                                            <!-- PARTIDA REFACCIONES -->
                                            <td class="py-3">
                                                <input type="hidden" name="Servicios[@i].IdObjetoGastoRefacciones" value="@servicio.IdObjetoGastoRefacciones" />
                                                <div class="extra-small text-muted text-truncate" style="max-width: 150px;" title="@partidaRef">
                                                    @partidaRef
                                                </div>
                                            </td>

                                            <!-- IVA (16%) -->
                                            <td class="text-end py-3 text-muted small">
                                                @ivaFila.ToString("C")
                                            </td>

                                            <!-- TOTAL LÍNEA (Con IVA incluido) -->
                                            <td class="text-end pe-4 py-3">
                                                <input type="text"
                                                       value="@totalFilaConIva.ToString("N2")"
                                                       class="form-control form-control-sm totalLinea text-end fw-bold bg-light border-0 text-success px-1"
                                                       readonly
                                                       tabindex="-1" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="bg-light border-top fw-bold text-dark">
                                    @{
                                        var sumaMoBaseGeneral = Model.Servicios.Sum(x => x.CostoEstimadoManoObra * x.Cantidad);
                                        var sumaRefBaseGeneral = Model.Servicios.Sum(x => x.CostoEstimadoRefacciones * x.Cantidad);
                                        var sumaBaseGeneral = sumaMoBaseGeneral + sumaRefBaseGeneral;
                                        var sumaIvaGeneral = sumaBaseGeneral * 0.16m;
                                        var sumaTotalGeneralConIva = sumaBaseGeneral + sumaIvaGeneral;
                                    }
                                    <tr>
                                        <td colspan="6" class="text-end py-3 ps-4 text-uppercase extra-small text-muted">
                                            Total Autorizado (IVA 16% Incluido)
                                        </td>
                                        <td class="text-end py-3 text-muted small">
                                            @sumaIvaGeneral.ToString("C")
                                        </td>
                                        <td class="text-end pe-4 py-3">
                                            <span class="fw-bold fs-5 text-success">
                                                @sumaTotalGeneralConIva.ToString("C")
                                            </span>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Campo oculto/auxiliar para recalcular el costo real total mediante JS -->
                <input type="hidden" id="CostoRealTotal" name="CostoRealTotal" value="@Model.Servicios.Sum(x => x.TotalLinea)" />

                <!-- ============================================== -->
                <!-- OBSERVACIONES DEL MANTENIMIENTO -->
                <!-- ============================================== -->
                    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                        <div class="card-header bg-light border-bottom py-3 px-4 d-flex align-items-center gap-2">
                            <i class="bi bi-chat-left-text text-primary fs-6"></i>
                            <h6 class="fw-bold mb-0 text-dark">
                                Observaciones finales del trabajo
                            </h6>
                        </div>
                        <div class="card-body p-4">
                            <label asp-for="Observaciones" class="form-label fw-semibold text-dark">
                                Observaciones y hallazgos técnicos <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Observaciones"
                                      rows="3"
                                      class="form-control rounded-2 p-3"
                                      placeholder="Escriba los comentarios finales sobre el trabajo realizado, hallazgos o estado de entrega de la unidad..."
                                      required></textarea>
                            <!-- TAG HELPER PARA EL MENSAJE DE VALIDACIÓN DE OBSERVACIONES -->
                            <span asp-validation-for="Observaciones" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                <!-- ============================================== -->
                <!-- BOTONES DE ACCIÓN Y CIERRE -->
                <!-- ============================================== -->
                <div class="d-flex justify-content-end align-items-center gap-2 pt-2">
                    <a asp-controller="SolicitudMantenimiento" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-2 fw-semibold">
                        Cancelar
                    </a>

                    @if (Model.EstatusMantenimientoId == 1)
                    {
                        <button type="submit"
                                formaction="@Url.Action("Finalizar", "Mantenimiento")"
                                class="btn btn-success px-4 py-2 rounded-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Finalizar mantenimiento</span>
                        </button>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-4 py-2 rounded-2 fs-6 fw-bold d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Mantenimiento finalizado</span>
                        </span>
                    }
                </div>

            </form>
        </div>
    </div>
</div>


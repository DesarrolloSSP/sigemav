@model SIGEMAV.Models.ViewModels.Maquinaria.PaginacionViewModel<SIGEMAV.Models.ViewModels.Maquinaria.MantenimientoViewModel >


@* @{
	ViewData["Title"] = "Mantenimientos";
}
 *@

<div class="card shadow-sm border-0">

	<div class="card-header bg-white d-flex justify-content-between align-items-center">

		<div>
			<h4 class="mb-0 fw-bold">
				Gestión de mantenimientos
			</h4>

			<small class="text-muted">
				Control operativo de mantenimientos vehiculares
			</small>
		</div>

		<div>
			<a asp-action="Create"
				   class="btn text-light"
				   style="background-color:#800705">

				<i class="bi bi-plus-circle me-1"></i>
				Nuevo Mantenimiento

			</a>
		</div>

	</div>





    
	<div class="card-body">

		@if (!Model.Registros.Any())
		{
			<div class="alert alert-info text-center mb-0">

				<i class="bi bi-info-circle me-2"></i>
				No se encontraron mantenimientos registrados.

			</div>
		}
		else
		{
			<div class="table-responsive">

				<table class="table table-hover align-middle">

					<thead class="table-light">
						<tr>
							<th>Folio</th>
							<th>No. Económico</th>
							<th>Placa</th>
							<th>Marca</th>
							<th>Modelo</th>
							<th>Tipo</th>
							<th>Taller</th>
							<th>Ingreso</th>
							<th>Kilometraje</th>
							<th>Estatus</th>
							<th class="text-center" style="width:180px;">
								Acciones
							</th>
						</tr>
					</thead>


					<tbody>

						@foreach (var item in Model.Registros)
						{
							<tr>

								<td class="fw-semibold">
									@item.Folio
								</td>

								<td>
									@item.NumeroEconomico
								</td>

								<td>
									<span class="badge bg-secondary">
										@item.PlacaActual
									</span>
								</td>

								<td>
									@item.MarcaNombre
								</td>

								<td>
									@item.ModeloNombre
								</td>

								<td>
									@item.TipoMantenimiento
								</td>

								<td>
									@item.TallerNombre
								</td>

								<td>
									@item.FechaIngreso.ToString("dd/MM/yyyy")
								</td>

								<td>
									@item.KilometrajeEntrada.ToString("N0")
								</td>
								<td>
									@if (item.Activo)
									{
										<span class="badge bg-success">
											Activo
										</span>
									}
									else
									{
										<span class="badge bg-danger">
											Inactivo
										</span>
									}
								</td>
								<td class="text-center">

									<div class="btn-group" role="group">

										<a asp-action="Details"
											   asp-route-id="@item.MantenimientoId"
											   class="btn btn-outline-secondary btn-sm"
											   title="Detalle">

											<i class="bi bi-eye"></i>
										</a>

										<a asp-action="Edit" asp-route-id="@item.MantenimientoId"
											   class="btn btn-outline-primary btn-sm"
											   title="Editar">

											<i class="bi bi-pencil-square"></i>
										</a>

										<a asp-action="Delete"
											   asp-route-id="@item.MantenimientoId"
											   class="btn btn-outline-danger btn-sm"
											   title="Eliminar">

											<i class="bi bi-trash"></i>
										</a>

									</div>

								</td>

							</tr>
						}

					</tbody>
				</table>
			</div>

            
        
        
        
        

			<nav class="mt-4">

				<ul class="pagination justify-content-center">

					<li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">

						<a class="page-link"
							   asp-action="Index"
							   asp-route-pagina="@(Model.PaginaActual - 1)">

							Anterior

						</a>

					</li>

					@for (int i = 1; i <= Model.TotalPaginas; i++)
					{
						if (
							i == 1
							|| i == Model.TotalPaginas
							|| (i >= Model.PaginaActual - 2
							&& i <= Model.PaginaActual + 2)
						)
						{
							<li class="page-item @(i == Model.PaginaActual ? "active" : "")">

								<a class="page-link"
									   asp-action="Index"
									   asp-route-pagina="@i">

									@i

								</a>

							</li>
						}
					}

					<li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">

						<a class="page-link"
							   asp-action="Index"
							   asp-route-pagina="@(Model.PaginaActual + 1)">

							Siguiente

						</a>

					</li>

				</ul>

			</nav>
        
		}
	</div>
</div>



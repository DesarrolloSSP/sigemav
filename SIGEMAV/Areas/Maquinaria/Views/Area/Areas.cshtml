@model SIGEMAV.Models.ViewModels.Maquinaria.AreaIndexViewModel


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-diagram-3 me-2"></i>Catálogo de áreas</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearArea">
            <i class="bi bi-plus-circle me-1"></i> Nueva área
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaAreas">
                    <thead class="table-light">
                        <tr>
@*                             <th>ID</th> *@
                            <th>Nombre del área</th>
                            @* <th>Activo Financieros</th> *@
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Areas)
                        {
                            <tr>
                                @* <td>@item.AreaId</td> *@
                                <td class="fw-semibold">@item.AreaNombre</td>
                               @*  <td>
                                    @if (item.ActivoFinancieros)
                                    {
                                        <span class="badge bg-info text-dark">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">No</span>
                                    }
                                </td> *@
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarArea(@item.AreaId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.AreaNombre))', @item.Activo.ToString().ToLower(), @item.ActivoFinancieros.ToString().ToLower())">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarArea" asp-route-id="@item.AreaId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas desactivar esta área?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Área -->
<div class="modal fade" id="modalCrearArea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AreaCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nueva área</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del área</label>
                    <input type="text" name="areaNombre" class="form-control" required maxlength="150" placeholder="Ej. Dirección de Maquinaria..." />
                </div>
              @*   <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activoFinancieros" id="crearActivoFinancieros" value="true">
                    <label class="form-check-label" for="crearActivoFinancieros">Activo Financieros</label>
                </div> *@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Área -->
<div class="modal fade" id="modalEditarArea" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AreaEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="areaId" id="editAreaId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar área</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del área</label>
                    <input type="text" name="areaNombre" id="editAreaNombre" class="form-control" required maxlength="150" />
                </div>
                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activo" id="editAreaActivo" value="true">
                    <label class="form-check-label" for="editAreaActivo">Activo</label>
                </div>
                @* <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activoFinancieros" id="editAreaActivoFinancieros" value="true">
                    <label class="form-check-label" for="editAreaActivoFinancieros">Activo Financieros</label>
                </div> *@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-areas.js" asp-append-version="true"></script>
}



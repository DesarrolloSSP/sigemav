@using SIGEMAV.Models.ViewModels.Maquinaria


@model TransferenciaUnidadEntregarViewModel

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <h4 class="fw-bold mb-0">
                Entrega de unidad
            </h4>

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Regresar

            </a>

        </div>

    </div>

    <div class="card-body">

        <form asp-action="Entregar"
              method="post"
              enctype="multipart/form-data"
              id="formEntrega">

            @Html.AntiForgeryToken()

            <input asp-for="TransferenciaUnidadId" type="hidden" />

            <input asp-for="UsuarioEntregaId" type="hidden" value="1" />

            <div class="row g-4">

                <div class="col-md-3">

                    <label class="fw-semibold">
                        Folio
                    </label>

                    <div>
                        @Model.Folio
                    </div>

                </div>

                <div class="col-md-3">

                    <label class="fw-semibold">
                        Vehículo
                    </label>

                    <div>
                        @Model.Vehiculo
                    </div>

                </div>

                <div class="col-md-3">

                    <label class="fw-semibold">
                        Área origen
                    </label>

                    <div>
                        @Model.AreaOrigen
                    </div>

                </div>

                <div class="col-md-3">

                    <label class="fw-semibold">
                        Área destino
                    </label>

                    <div>
                        @Model.AreaDestino
                    </div>

                </div>

            </div>

            <hr />

            <div class="row g-4">

                <div class="col-md-12">

                    <label class="fw-semibold">
                        Motivo de transferencia
                    </label>

                    <textarea class="form-control"
                              rows="3"
                              readonly>@Model.MotivoTransferencia</textarea>

                </div>

                <div class="col-md-12">

                    <label class="fw-semibold">
                        Observaciones de entrega
                    </label>

                    <textarea asp-for="ObservacionesEntrega"
                              rows="4"
                              class="form-control"></textarea>

                </div>

                <div class="col-md-6">

                    <label class="fw-semibold">
                        Acta de entrega (PDF)
                    </label>

                    <input type="file"
                           name="documento"
                           class="form-control"
                           accept=".pdf"
                           required />

                </div>

            </div>

            <div class="d-flex justify-content-end mt-4">

                <button type="submit"
                        class="btn btn-success">

                    <i class="bi bi-box-arrow-right me-1"></i>

                    Confirmar entrega

                </button>

            </div>

        </form>

    </div>

</div>

<script>

    $("#formEntrega").submit(function (e) {

        e.preventDefault();

        Swal.fire({

            title: 'Confirmar entrega',
            text: '¿Desea confirmar la entrega de la unidad?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#198754',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, entregar',
            cancelButtonText: 'Cancelar'

        }).then((result) => {

            if (result.isConfirmed) {

                this.submit();
            }
        });
    });

</script>
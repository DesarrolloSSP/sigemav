@using SIGEMAV.Models.ViewModels.Maquinaria
@model TransferenciaUnidadCreateViewModel

@{
	ViewData["Title"] = "Nueva Transferencia";
}

<div class="container-fluid">

	<div class="card border-0 shadow-sm">

		<div class="card-header bg-white">

			<h4 class="mb-0 fw-bold">
				Nueva solicitud de transferencia de vehículo
			</h4>

		</div>

		<div class="card-body">

			<form asp-action="Create"
				  method="post"
				  enctype="multipart/form-data"
				  id="formTransferencia">

				@Html.AntiForgeryToken()

				<div asp-validation-summary="ModelOnly"
					 class="alert alert-danger">
				</div>

				<div class="row g-4">

					<!-- FECHA -->

					<div class="col-md-6">

						<label asp-for="FechaTransferencia"
							   class="form-label fw-semibold">

							Fecha de Transferencia

						</label>

						<input asp-for="FechaTransferencia"
							   type="datetime-local"
							   class="form-control" required />

						<span asp-validation-for="FechaTransferencia"
							  class="text-danger">
						</span>

					</div>

					<!-- UNIDAD -->

					<div class="col-md-6">

						<label asp-for="UnidadVehicularId"
							   class="form-label fw-semibold">

							Unidad Vehicular

						</label>

						<select asp-for="UnidadVehicularId"
								class="form-select"
								id="unidadVehicularSelect" required>

							@if (Model.UnidadVehicularId > 0)
							{
								<option value="@Model.UnidadVehicularId" selected>
									@Model.UnidadVehicularTexto
								</option>
							}

						</select>

						<span asp-validation-for="UnidadVehicularId"
							  class="text-danger">
						</span>

					</div>

					<!-- ÁREA ORIGEN -->

					<div class="col-md-4">

						<label asp-for="AreaOrigenId"
							   class="form-label fw-semibold">

							Área Origen

						</label>

						<select asp-for="AreaOrigenId"
								asp-items="Model.Areas"
								class="form-select"
								id="areaOrigenSelect"
								disabled>

							<option value="">
								Seleccione área
							</option>

						</select>

						<input asp-for="AreaOrigenId"
							   type="hidden"
							   id="areaOrigenHidden" />

						<span asp-validation-for="AreaOrigenId"
							  class="text-danger">
						</span>

					</div>

					<!-- ÁREA DESTINO -->

					<div class="col-md-4">

						<label asp-for="AreaDestinoId"
							   class="form-label fw-semibold">

							Área Destino

						</label>

						<select asp-for="AreaDestinoId"
								asp-items="Model.Areas"
								class="form-select" required>

							<option value="">
								Seleccione área
							</option>

						</select>

						<span asp-validation-for="AreaDestinoId"
							  class="text-danger">
						</span>

					</div>

					<!-- DOCUMENTO -->

					<div class="col-md-4">

						<label asp-for="Documento"
							   class="form-label fw-semibold">

							Documento PDF

						</label>

						<input asp-for="Documento"
							   type="file"
							   class="form-control"
							   id="documentoInput"
							   accept=".pdf" required/>

						<span asp-validation-for="Documento"
							  class="text-danger">
						</span>

						<small class="text-muted">

							Solo PDF.
							Tamaño máximo 2 MB.

						</small>

						<div id="errorDocumento"
							 class="text-danger small mt-2">
						</div>

					</div>

					<!-- MOTIVO -->

					<div class="col-md-12">

						<label asp-for="MotivoTransferencia"
							   class="form-label fw-semibold">

							Motivo de Transferencia

						</label>

						<textarea asp-for="MotivoTransferencia"
								  rows="4"
								  class="form-control" required>
						</textarea>

						<span asp-validation-for="MotivoTransferencia"
							  class="text-danger">
						</span>

					</div>

					<!-- OBSERVACIONES -->

					<div class="col-md-12">

						<label asp-for="Observaciones"
							   class="form-label fw-semibold">

							Observaciones

						</label>

						<textarea asp-for="Observaciones"
								  rows="4"
								  class="form-control" required>
						</textarea>

						<span asp-validation-for="Observaciones"
							  class="text-danger">
						</span>

					</div>

				</div>

				<hr class="my-4" />

				<div class="d-flex justify-content-end gap-2">

					<a asp-action="Index"
					   class="btn btn-outline-secondary">

						Cancelar

					</a>

					<button type="submit"
							class="btn text-light"
							style="background-color:#800705"
							id="btnGuardar">

						<i class="bi bi-save me-1"></i>

						Guardar Transferencia

					</button>

				</div>

			</form>

		</div>

	</div>

</div>

@section Scripts {

	<partial name="_ValidationScriptsPartial" />

	<!-- SELECT2 -->

	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
		  rel="stylesheet" />

	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js">
	</script>

	<script>

		$(document).ready(function () {

			// =========================================
			// SELECT2 UNIDADES
			// =========================================

			$('#unidadVehicularSelect').select2({

				placeholder: 'Buscar unidad vehicular',

				allowClear: true,

				width: '100%',

				minimumInputLength: 0,

				ajax: {

					url: '@Url.Action("BuscarUnidadesVehiculares", "Transferencia", new { area = "Maquinaria" })',

					dataType: 'json',

					delay: 300,

					data: function (params) {

						return {

							term: params.term || ''

						};

					},

					processResults: function (data) {

						return {

							results: data

						};

					},

					cache: true
				}
			});

			// =========================================
			// OBTENER ÁREA ORIGEN
			// =========================================

					// =========================================
		// OBTENER ÁREA ORIGEN
		// =========================================

		$('#unidadVehicularSelect').on('change', function () {

			const unidadId = $(this).val();

			if (!unidadId) {

				$('#areaOrigenSelect')
					.val('')
					.trigger('change');

				$('#areaOrigenHidden')
					.val('');

				return;
			}

			$.ajax({

				url: '@Url.Action("ObtenerAreaPorUnidad", "Transferencia", new { area = "Maquinaria" })',

				type: 'GET',

				data: {
					unidadVehicularId: unidadId
				},

				success: function (response) {

					console.log(response);

					if (!response.success) {

						alert(response.message);

						return;
					}

					$('#areaOrigenSelect')
						.val(response.areaId)
						.trigger('change');

					$('#areaOrigenHidden')
						.val(response.areaId);
				},

				error: function (xhr) {

					console.error(xhr);

					alert(
						'No fue posible obtener el área origen.');
				}
			});
		});

			// =========================================
			// VALIDAR PDF CLIENTE
			// =========================================

			$('#documentoInput').on('change', function () {

				const archivo = this.files[0];

				const errorDiv =
					$('#errorDocumento');

				const btnGuardar =
					$('#btnGuardar');

				errorDiv.html('');

				btnGuardar.prop('disabled', false);

				if (!archivo) {
					return;
				}

				const extensionesPermitidas =
					['pdf'];

				const extension =
					archivo.name
						.split('.')
						.pop()
						.toLowerCase();

				const maximo =
					2 * 1024 * 1024;

				if (!extensionesPermitidas.includes(extension)) {

					errorDiv.html(
						'Solo se permiten archivos PDF.');

					this.value = '';

					btnGuardar.prop('disabled', true);

					return;
				}

				if (archivo.size > maximo) {

					errorDiv.html(
						'El archivo excede 2 MB.');

					this.value = '';

					btnGuardar.prop('disabled', true);

					return;
				}

				if (archivo.name.length > 150) {

					errorDiv.html(
						'El nombre del archivo es demasiado largo.');

					this.value = '';

					btnGuardar.prop('disabled', true);

					return;
				}
			});

		});

	</script>
}
@using SIGEMAV.Models.ViewModels.Maquinaria
@model FacturaDetalleViewModel

@{
	ViewData["Title"] = "Detalle de factura";
}

<div class="card shadow-sm border-0">

	<div class="card-header bg-white">

		<div class="d-flex justify-content-between align-items-center">

			<div>

				<h4 class="fw-bold mb-0">
					Factura registrada
				</h4>

				<small class="text-muted">

					Expediente administrativo del mantenimiento

				</small>

			</div>

			<div>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>

					Regresar

				</a>

			</div>

		</div>

	</div>


	<div class="card-body">

		<!-- RESUMEN -->

		<div class="row g-3 mb-4">

			<div class="col-md-3">

				<div class="card border-0 bg-light">

					<div class="card-body">

						<small class="text-muted">
							UUID
						</small>

						<div class="fw-bold">

							@Model.UUID

						</div>

					</div>

				</div>

			</div>

			<div class="col-md-2">

				<div class="card border-0 bg-light">

					<div class="card-body">

						<small class="text-muted">
							Serie
						</small>

						<div class="fw-bold">

							@(string.IsNullOrWhiteSpace(Model.Serie)
								? "-"
								: Model.Serie)

						</div>

					</div>

				</div>

			</div>

			<div class="col-md-2">

				<div class="card border-0 bg-light">

					<div class="card-body">

						<small class="text-muted">
							Folio
						</small>

						<div class="fw-bold">

							@Model.Folio

						</div>

					</div>

				</div>

			</div>

			<div class="col-md-5">

				<div class="card border-0 bg-light">

					<div class="card-body">

						<small class="text-muted">
							Taller
						</small>

						<div class="fw-bold">

							@Model.Taller

						</div>

					</div>

				</div>

			</div>

		</div>



		<!-- DATOS FISCALES -->

		<div class="card border mb-4">

			<div class="card-header bg-light">

				<h6 class="mb-0 fw-bold">

					<i class="bi bi-receipt me-2"></i>

					Información fiscal

				</h6>

			</div>

			<div class="card-body">

				<div class="row g-3">

					<div class="col-md-4">

						<label class="fw-semibold">
							RFC Emisor
						</label>

						<div>
							@Model.RFCEmisor
						</div>

					</div>

					<div class="col-md-4">

						<label class="fw-semibold">
							RFC Receptor
						</label>

						<div>
							@Model.RFCReceptor
						</div>

					</div>

					<div class="col-md-4">

						<label class="fw-semibold">
							Razón Social
						</label>

						<div>
							@Model.RazonSocial
						</div>

					</div>

					<div class="col-md-3">

						<label class="fw-semibold">
							Método pago
						</label>

						<div>
							@Model.MetodoPago
						</div>

					</div>

					<div class="col-md-3">

						<label class="fw-semibold">
							Forma pago
						</label>

						<div>
							@Model.FormaPago
						</div>

					</div>

					<div class="col-md-3">

						<label class="fw-semibold">
							Uso CFDI
						</label>

						<div>
							@Model.UsoCFDI
						</div>

					</div>

					<div class="col-md-3">

						<label class="fw-semibold">
							Moneda
						</label>

						<div>
							@Model.Moneda
						</div>

					</div>

				</div>

			</div>

		</div>



		<!-- MONTOS -->

		<div class="row g-3 mb-4">

			<div class="col-md-3">

				<div class="card">

					<div class="card-body">

						<small>Subtotal</small>

						<h5>

							@Model.Subtotal.ToString("C")

						</h5>

					</div>

				</div>

			</div>

			<div class="col-md-3">

				<div class="card">

					<div class="card-body">

						<small>IVA</small>

						<h5>

							@Model.IVA.ToString("C")

						</h5>

					</div>

				</div>

			</div>

			<div class="col-md-3">

				<div class="card">

					<div class="card-body">

						<small>Retención</small>

						<h5>

							@Model.Retencion.ToString("C")

						</h5>

					</div>

				</div>

			</div>

			<div class="col-md-3">

				<div class="card border-success">

					<div class="card-body">

						<small>Total</small>

						<h4 class="text-success fw-bold">

							@Model.Total.ToString("C")

						</h4>

					</div>

				</div>

			</div>

		</div>



		<!-- CONCEPTOS -->

		<div class="card mb-4">

			<div class="card-header bg-light">

				<h6 class="fw-bold mb-0">

					Servicios facturados

				</h6>

			</div>

			<div class="table-responsive">

				<table class="table table-hover mb-0">

					<thead>

						<tr>

							<th>Concepto</th>
							<th>Cantidad</th>
							<th class="text-end">
								Total
							</th>

						</tr>

					</thead>

					<tbody>

						@foreach (var item in Model.Conceptos)
						{
							<tr>

								<td>
									@item.Concepto
								</td>

								<td>
									@item.Cantidad
								</td>

								<td class="text-end fw-semibold">

									@item.TotalLinea.ToString("C")

								</td>

							</tr>
						}

					</tbody>

				</table>

			</div>

		</div>



		<!-- DOCUMENTOS -->

		<div class="card">

			<div class="card-header bg-light">

				<h6 class="mb-0 fw-bold">

					Documentos anexos

				</h6>

			</div>

			<div class="card-body">

				<div class="row g-3">

					@foreach (var doc in Model.Documentos)
					{
						<div class="col-md-4">

							<a asp-action="VerDocumento"
							   asp-route-id="@doc.FacturaDocumentoId"
							   target="_blank"
							   class="card text-decoration-none shadow-sm">

								<div class="card-body text-center">

									@if (doc.TipoDocumento == "PDF")
									{
										<i class="bi bi-file-earmark-pdf fs-1 text-danger"></i>
									}
									else
									{
										<i class="bi bi-filetype-xml fs-1 text-primary"></i>
									}

									<div class="mt-3 fw-semibold">

										@doc.NombreArchivo

									</div>

									<small class="text-muted">

										@doc.TipoDocumento

									</small>

								</div>

							</a>

						</div>
					}

				</div>

			</div>

		</div>

	</div>

</div>
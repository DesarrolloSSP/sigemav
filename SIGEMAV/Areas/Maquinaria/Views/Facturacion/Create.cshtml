@using SIGEMAV.Models.ViewModels.Maquinaria
@model FacturaMantenimientoViewModel

<form asp-action="Create"
	  method="post"
	  enctype="multipart/form-data"
	  id="formFactura">

	<input type="hidden" asp-for="MantenimientoId" />
	<input type="hidden" asp-for="TallerId" />

	<div class="container-fluid">

        
		<!-- HEADER -->

		<div class="card border-0 shadow-sm mb-4">

			<div class="card-body">

				<div class="d-flex justify-content-between align-items-center">

					<div>

						<div class="text-uppercase text-muted small">
							Facturación de mantenimiento
						</div>

						<h2 class="fw-bold mb-1">

							Registrar factura

						</h2>

						<div class="text-muted">

							Validación CFDI + registro presupuestal devengado

						</div>

					</div>

					<div>

						<a asp-action="Index"
						   class="btn btn-outline-dark">

							<i class="bi bi-arrow-left me-2"></i>

							Regresar

						</a>

					</div>

				</div>

			</div>

		</div>


		<div class="row">

			<!-- PANEL IZQUIERDO -->

			<div class="col-lg-8">

				<!-- DOCUMENTOS -->

				<div class="card shadow-sm border-0 mb-4">

					<div class="card-header bg-dark text-white">

						<h5 class="mb-0">

							<i class="bi bi-file-earmark-arrow-up me-2"></i>

							Carga documental

						</h5>

					</div>

					<div class="card-body">

						<div class="alert alert-light border">

							El sistema obtendrá automáticamente:

							<ul class="mb-0 mt-2">

								<li>UUID</li>

								<li>Serie / Folio</li>

								<li>RFC Emisor / Receptor</li>

								<li>Método y forma de pago</li>

								<li>Totales CFDI</li>

								<li>Validación contra mantenimiento</li>

							</ul>

						</div>

						<div class="row">

							<div class="col-md-6">

								<label class="fw-semibold">

									XML CFDI

								</label>

								<input type="file"
									   name="xmlFactura"
									   class="form-control"
									   accept=".xml"
									   required />

								<small class="text-muted">

									Archivo fiscal oficial

								</small>

							</div>

							<div class="col-md-6">

								<label class="fw-semibold">

									PDF Factura

								</label>

								<input type="file"
									   name="pdfFactura"
									   class="form-control"
									   accept=".pdf"
									   required />

								<small class="text-muted">

									Evidencia documental

								</small>

							</div>

						</div>

					</div>

				</div>


				<!-- RECEPCIÓN -->

				<div class="card shadow-sm border-0">

					<div class="card-header">

						<h5 class="mb-0">

							<i class="bi bi-calendar-check me-2"></i>

							Recepción administrativa

						</h5>

					</div>

					<div class="card-body">

						<div class="row">

							<div class="col-md-6">

								<label class="fw-semibold">

									Fecha recepción

								</label>

								<input asp-for="FechaRecepcion"
									   type="datetime-local"
									   class="form-control" />

							</div>

							<div class="col-md-6">

								<label class="fw-semibold">

									Taller

								</label>

								<input value="@Model.RazonSocial"
									   readonly
									   class="form-control bg-light" />

							</div>

						</div>

						<div class="mt-4">

							<label class="fw-semibold">

								Observaciones

							</label>

							<textarea asp-for="Observaciones"
									  rows="4"
									  class="form-control"
									  placeholder="Comentarios administrativos, incidencias o validaciones adicionales">
							 </textarea>

						</div>

					</div>

				</div>

			</div>


			<!-- PANEL DERECHO -->
				<div class="col-lg-4">
					<div class="sticky-top" style="top: 20px;">
						<div class="card border shadow-sm rounded-3 overflow-hidden">
							<div class="card-header bg-success text-white py-3 px-4">
								<h5 class="mb-0 fw-bold">
									<i class="bi bi-receipt me-2"></i>
									Resumen esperado de factura
								</h5>
							</div>
							<div class="card-body p-4">
								<div class="mb-3">
									<small class="text-uppercase text-muted extra-small fw-bold">
										Subtotal Mantenimiento (Base)
									</small>
									<div class="fs-5 fw-semibold text-dark">
										@Model.Subtotal.ToString("C")
									</div>
								</div>
								<div class="mb-3">
									<small class="text-uppercase text-muted extra-small fw-bold">
										IVA Esperado (16%)
									</small>
									<div class="fs-5 text-secondary">
										@Model.IVA.ToString("C")
									</div>
								</div>
								<hr class="text-muted opacity-25" />
								<div>
									<small class="text-uppercase text-muted extra-small fw-bold">
										Total Estimado (Con IVA)
									</small>
									<div class="display-6 fw-bold text-success">
										@Model.Total.ToString("C")
									</div>
								</div>
							</div>
							<div class="card-footer bg-light py-3 px-4">
								<button type="submit" class="btn btn-success w-100 fw-bold py-2 shadow-sm">
									<i class="bi bi-check-circle me-2"></i>
									Registrar factura
								</button>
							</div>
						</div>
					</div>
				</div>

		</div>

        
	</div>

</form>



@section Scripts{

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>

		$("#formFactura").on("submit", function () {

		Swal.fire({

		title: 'Validando CFDI',

		html:
		'Se validará XML, presupuesto y coincidencia con mantenimiento.',

		allowOutsideClick: false,

		showConfirmButton: false,

		didOpen: () => {

		Swal.showLoading();

		}

		});

		});

	</script>





	

	@if (TempData["Success"] != null)
	{
		<script>

			Swal.fire({

			icon: 'success',

			title: 'Operación realizada',

			text: '@TempData["Success"]',

			confirmButtonColor: '#800705'

			});

		</script>

}



}







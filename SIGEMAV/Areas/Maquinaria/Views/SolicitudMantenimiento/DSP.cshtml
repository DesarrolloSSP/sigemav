		<form asp-action="DSP" method="post" id="formDSP">

			

			@Html.AntiForgeryToken()

			<input asp-for="SolicitudMantenimientoId" type="hidden" />
			<input asp-for="Folio" type="hidden" />
			<input asp-for="AreaId" type="hidden" />


			@for (int i = 0; i < Model.PartidasSolicitud.Count; i++)
			{
				<input type="hidden"
					   asp-for="PartidasSolicitud[i].IdObjetoGasto" />

				<input type="hidden"
					   asp-for="PartidasSolicitud[i].ImporteSolicitado" />

				<input type="hidden"
					   asp-for="PartidasSolicitud[i].ClaveObjetoGasto" />
			}



			<div class="row g-4">

				<!-- FOLIO -->
				<div class="col-md-4">

					<label class="fw-semibold">
						Folio
					</label>

					<div class="form-control bg-light">
						@Model.Folio
					</div>

				</div>

				<!-- AREA -->
				<div class="col-md-4">

					<label class="fw-semibold">
						Área solicitante
					</label>

					<div class="form-control bg-light text-start fw-bold text-black">
						@Model.Area
					</div>

				</div>

				<!-- IMPORTE -->
				<div class="col-md-4">
					<label class="fw-semibold">
						Importe de la solicitud de mantenimiento
					</label>

					<div class="form-control bg-light text-end fw-bold text-primary">

						@Model.ImporteSolicitud.ToString("C")

					</div>

				</div>



				<!-- TALLER -->
				<div class="col-md-6">

					<label class="fw-semibold">
						Taller
					</label>

					<div class="form-control bg-light">
						@Model.Taller?.Trim()
					</div>

				</div>

				<div class="col-md-3">

					<label class="fw-semibold">
						Monto mínimo
					</label>

					<div class="form-control bg-light text-end">
						@Model.TallerMinimo.ToString("C")
					</div>

				</div>

				<div class="col-md-3">

					<label class="fw-semibold">
						Monto máximo
					</label>

					<div class="form-control bg-light text-end">
						@Model.TallerMaximo.ToString("C")
					</div>

				</div>

				@* <div class="col-md-2">

					<label class="fw-semibold">
						Disponible
					</label>

					<div class="form-control bg-light text-end fw-bold

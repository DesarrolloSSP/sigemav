							 ? "text-success"
							 : "text-danger")">

						@Model.DisponibleTaller.ToString("C")

					</div>

				</div> *@





			</div>




			<hr class="my-4" />

			<h5 class="fw-bold mb-3">
				Validación presupuestal del taller
			</h5>

			<div class="row g-3">

				<div class="col-md-3">

					<div class="card shadow-sm">

						<div class="card-body">

							<div class="text-muted">
								Presupuesto asignado
							</div>

							<div class="fw-bold text-primary fs-5">
								@Model.PresupuestoTaller.ToString("C")
							</div>

						</div>

					</div>

				</div>

				<div class="col-md-3">

					<div class="card shadow-sm">

						<div class="card-body">

							<div class="text-muted">
								Comprometido
							</div>

							<div class="fw-bold text-warning fs-5">
								@Model.ComprometidoTaller.ToString("C")
							</div>

						</div>

					</div>

				</div>

				<div class="col-md-3">

					<div class="card shadow-sm">

						<div class="card-body">

							<div class="text-muted">
								Ejercido
							</div>

							<div class="fw-bold text-secondary fs-5">
								@Model.EjercidoTaller.ToString("C")
							</div>

						</div>

					</div>

				</div>

				<div class="col-md-3">

					<div class="card shadow-sm">

						<div class="card-body">

							<div class="text-muted">
								Disponible
							</div>

							<div class="fw-bold fs-4
								@(Model.DisponibleTaller >= Model.ImporteSolicitud
									 ? "text-success"
									 : "text-danger")">

								@Model.DisponibleTaller.ToString("C")

							</div>

						</div>

					</div>

				</div>

			</div>

			@* @if (Model.DisponibleTaller < Model.ImporteSolicitud)
			{
				<div class="alert alert-danger mt-3">

					<i class="bi bi-exclamation-octagon-fill me-2"></i>


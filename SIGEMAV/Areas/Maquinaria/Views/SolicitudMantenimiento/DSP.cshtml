@using System.Diagnostics
@using SIGEMAV.Models.ViewModels.Maquinaria

@model DSPViewModel

@{
	ViewData["Title"] =
		"Validación DSP";
}







<div class="card shadow-sm border-0">

	<div class="card-header bg-white">

		<div class="d-flex justify-content-between align-items-center">

			<div>



				@{
					var esPendienteDSP = Model.EstatusSolicitudMantenimientoId == 2;

					var esPendienteRevision = Model.EstatusSolicitudMantenimientoId == 4;

					var esRechazada = Model.EstatusSolicitudMantenimientoId == 6;

					var esAutorizada = Model.EstatusSolicitudMantenimientoId == 5;

					var esEnMantenimiento = Model.EstatusSolicitudMantenimientoId == 7;

					var esFinalizada = Model.EstatusSolicitudMantenimientoId == 8;

					var esConsulta = esAutorizada || esEnMantenimiento || esFinalizada || esPendienteRevision;
				}




				<h4 class="fw-bold mb-0">
					Validación presupuestal DSP
				</h4>

				<small class="text-muted">
					Control financiero y autorización administrativa
				</small>

			</div>

			<div>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>
					Regresar

				</a>

			</div>

		</div>

	</div>

	<div class="card-body">

		@if (TempData["Error"] != null)
		{
			<div class="alert alert-danger alert-dismissible fade show"
				 role="alert">

				<i class="bi bi-exclamation-triangle-fill me-2"></i>

				@TempData["Error"]

				<button type="button"
						class="btn-close"
						data-bs-dismiss="alert">
				</button>

			</div>
		}




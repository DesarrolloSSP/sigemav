				<div class="alert alert-success mt-3">

					<i class="bi bi-check-circle-fill me-2"></i>

					El taller cuenta con disponibilidad.

				</div>
			} *@
			@if (esRechazada)
			{
				<div class="alert alert-warning">

					<i class="bi bi-arrow-counterclockwise me-2"></i>

					El compromiso presupuestal del taller fue liberado por rechazo técnico.
					El presupuesto quedó nuevamente disponible.

				</div>
			}
			else if (Model.DisponibleTaller < Model.ImporteSolicitud)
			{
				<div class="alert alert-danger">

					<i class="bi bi-exclamation-octagon-fill me-2"></i>

					El taller NO cuenta con disponibilidad presupuestal.

				</div>
			}
			else
			{
				<div class="alert alert-success">

					<i class="bi bi-check-circle-fill me-2"></i>

					El taller cuenta con disponibilidad presupuestal.

				</div>

				@if (!Model.TieneSuficienciaPresupuestal)
				{
					<div class="alert alert-warning mt-2">

						<i class="bi bi-info-circle me-2"></i>

						Aunque el taller tiene disponibilidad,
						una o más partidas del área (DSP)
						no cuentan con suficiencia presupuestal.

					</div>
				}
			}







			



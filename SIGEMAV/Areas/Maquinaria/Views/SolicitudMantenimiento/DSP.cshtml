@* @using System.Diagnostics
@using SIGEMAV.Models.ViewModels.Maquinaria
@model DSPViewModel

@{
    // =========================================================
    // ESTADOS
    // =========================================================

    var esPendienteDSP =
        Model.EstatusSolicitudMantenimientoId == 2;

    var esPendienteRevision =
        Model.EstatusSolicitudMantenimientoId == 4;

    var esRechazada =
        Model.EstatusSolicitudMantenimientoId == 6;

    var esAutorizada =
        Model.EstatusSolicitudMantenimientoId == 5;

    var esEnMantenimiento =
        Model.EstatusSolicitudMantenimientoId == 7;

    var esFinalizada =
        Model.EstatusSolicitudMantenimientoId == 8;

    var esConsulta =
        esAutorizada
        ||
        esEnMantenimiento
        ||
        esFinalizada
        ||
        esPendienteRevision;


    // =========================================================
    // ESTADO GENERAL DEL TALLER
    // =========================================================

    var estadoTallerTexto =
        esRechazada
            ? "PRESUPUESTO LIBERADO"
            : !Model.TieneDisponibilidadTaller
                ? "SIN DISPONIBILIDAD"
                : Model.TallerEnCritico
                    ? "NIVEL CRÍTICO"
                    : Model.TallerEnAlerta
                        ? "NIVEL DE ALERTA"
                        : "DISPONIBILIDAD";


    var estadoTallerClase =
        esRechazada
            ? "warning"
            : !Model.TieneDisponibilidadTaller
                ? "danger"
                : Model.TallerEnCritico
                    ? "danger"
                    : Model.TallerEnAlerta
                        ? "warning"
                        : "success";


    var estadoTallerIcono =
        esRechazada
            ? "bi-arrow-counterclockwise"
            : !Model.TieneDisponibilidadTaller
                ? "bi-x-circle"
                : Model.TallerEnCritico
                    ? "bi-exclamation-octagon"
                    : Model.TallerEnAlerta
                        ? "bi-exclamation-triangle"
                        : "bi-check-circle";


    // =========================================================
    // RESULTADO GLOBAL
    // =========================================================

    var puedeAutorizar =
        Model.TieneSuficienciaPresupuestal
        &&
        Model.TieneDisponibilidadTaller;


    var tieneLiberaciones =
        Model.PartidasDSP?.Any(x =>
            x.FueDescomprometida)
        ?? false;


    // =========================================================
    // ESTADO DE LA VALIDACIÓN
    // =========================================================

    var estadoSolicitudTexto =
        esRechazada
            ? "Rechazada"
            : esFinalizada
                ? "Finalizada"
                : esEnMantenimiento
                    ? "En mantenimiento"
                    : esAutorizada
                        ? "Autorizada"
                        : esPendienteRevision
                            ? "Pendiente de revisión"
                            : "Pendiente de DSP";


    var estadoSolicitudClase =
        esRechazada
            ? "danger"
            : esFinalizada
                ? "success"
                : esEnMantenimiento
                    ? "info"
                    : esAutorizada
                        ? "primary"
                        : "warning";
}


<div class="card shadow-sm border-0">

    <!-- ========================================================= -->
    <!-- ENCABEZADO PRINCIPAL -->
    <!-- ========================================================= -->

    <div class="card-header bg-white border-bottom py-3">

        <div class="d-flex flex-column flex-lg-row
            justify-content-between
            align-items-lg-center
            gap-3">

            <div>

                <div class="d-flex align-items-center gap-2">

                    <div class="bg-primary-subtle
                        text-primary
                        rounded-3
                        p-2">

                        <i class="bi bi-cash-coin fs-4"></i>

                    </div>

                    <div>

                        <h4 class="fw-bold mb-0">
                            Validación presupuestal DSP
                        </h4>

                        <div class="text-muted small">
                            Revisión financiera de la solicitud de mantenimiento
                        </div>

                    </div>

                </div>

            </div>


            <div class="d-flex align-items-center gap-2">

                <span class="badge
                    bg-@estadoSolicitudClase
                    @(estadoSolicitudClase == "warning" ? "text-dark" : "")
                    px-3 py-2">

                    @estadoSolicitudTexto

                </span>


                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Regresar

                </a>

            </div>

        </div>

    </div>


    <div class="card-body p-4">

        <!-- ========================================================= -->
        <!-- MENSAJE DE ERROR -->
        <!-- ========================================================= -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <div class="d-flex align-items-start">

                    <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>

                    <div>

                        <strong>
                            No fue posible continuar.
                        </strong>

                        <div class="small mt-1">
                            @TempData["Error"]
                        </div>

                    </div>

                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <form asp-action="DSP"
              method="post"
              id="formDSP">

            @Html.AntiForgeryToken()

            <input asp-for="SolicitudMantenimientoId"
                   type="hidden" />

            <input asp-for="Folio"
                   type="hidden" />

            <input asp-for="AreaId"
                   type="hidden" />


            @for (int i = 0;
                  i < Model.PartidasSolicitud.Count;
                  i++)
            {
                <input type="hidden"
                       asp-for="PartidasSolicitud[i].IdObjetoGasto" />

                <input type="hidden"
                       asp-for="PartidasSolicitud[i].ImporteSolicitado" />

                <input type="hidden"
                       asp-for="PartidasSolicitud[i].ClaveObjetoGasto" />
            }


            <!-- ===================================================== -->
            <!-- 1. IDENTIFICACIÓN DE LA SOLICITUD -->
            <!-- ===================================================== -->

            <div class="mb-4">

                <div class="d-flex align-items-center
                    justify-content-between
                    mb-3">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Información de la solicitud
                        </h5>

                        <div class="text-muted small">
                            Datos generales sujetos a validación presupuestal
                        </div>

                    </div>

                </div>


                <div class="row g-3">

                    <!-- FOLIO -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <div class="border rounded-3
                            p-3
                            h-100
                            bg-light">

                            <div class="text-muted small mb-1">
                                Folio
                            </div>

                            <div class="fw-bold fs-5">
                                @Model.Folio
                            </div>

                        </div>

                    </div>


                    <!-- ÁREA -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <div class="border rounded-3
                            p-3
                            h-100">

                            <div class="d-flex align-items-center
                                gap-2
                                text-muted
                                small
                                mb-1">

                                <i class="bi bi-diagram-3"></i>

                                Área solicitante

                            </div>

                            <div class="fw-bold">

                                @Model.Area

                            </div>

                        </div>

                    </div>


                    <!-- TALLER -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <div class="border rounded-3
                            p-3
                            h-100
                            border-primary-subtle">

                            <div class="d-flex align-items-center
                                gap-2
                                text-primary
                                small
                                mb-1">

                                <i class="bi bi-building"></i>

                                Taller

                            </div>

                            <div class="fw-bold">

                                @Model.Taller?.Trim()

                            </div>

                        </div>

                    </div>


                    <!-- IMPORTE -->

                    <div class="col-12 col-md-6 col-xl-3">

                        <div class="border rounded-3
                            p-3
                            h-100
                            bg-primary-subtle
                            border-primary-subtle">

                            <div class="text-primary
                                small
                                mb-1">

                                Importe de la solicitud

                            </div>

                            <div class="fw-bold
                                fs-5
                                text-primary
                                text-end">

                                @Model.ImporteSolicitud.ToString("C")

                            </div>

                        </div>

                    </div>

                </div>

            </div>


           

            <!-- ===================================================== -->
            <!-- 3. PRESUPUESTO DEL TALLER -->
            <!-- ===================================================== -->

            <div class="mb-4">

                <div class="d-flex align-items-center
                    justify-content-between
                    mb-3 bg-dark text-white">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Presupuesto del taller
                        </h5>

                        <div class="text-muted small text-white">
                            Situación financiera del taller para el ejercicio vigente
                        </div>

                    </div>

                    <span class="badge bg-light
                        text-dark
                        border">

                        Control presupuestal

                    </span>

                </div>


                <div class="row g-3">

                    <!-- ASIGNADO -->

                    <div class="col-12 col-md-6 col-xl">

                        <div class="border rounded-3
                            p-3
                            h-100">

                            <div class="text-muted small mb-2">
                                Presupuesto asignado
                            </div>

                            <div class="fw-bold fs-5">

                                @Model.PresupuestoTaller.ToString("C")

                            </div>

                        </div>

                    </div>


                    <!-- COMPROMETIDO -->

                    <div class="col-12 col-md-6 col-xl">

                        <div class="border rounded-3
                            p-3
                            h-100">

                            <div class="text-muted small mb-2">
                                Comprometido
                            </div>

                            <div class="fw-bold fs-5 text-warning">

                                @Model.ComprometidoTaller.ToString("C")

                            </div>

                        </div>

                    </div>


                    <!-- EJERCIDO -->

                    <div class="col-12 col-md-6 col-xl">

                        <div class="border rounded-3
                            p-3
                            h-100">

                            <div class="text-muted small mb-2">
                                Ejercido
                            </div>

                            <div class="fw-bold fs-5">

                                @Model.EjercidoTaller.ToString("C")

                            </div>

                        </div>

                    </div>


                    <!-- DISPONIBLE -->

                    <div class="col-12 col-md-6 col-xl">

                        <div class="border rounded-3
                            p-3
                            h-100
                            @(Model.DisponibleTaller > 0
                                ? "border-success"
                                : "border-danger")">

                            <div class="text-muted small mb-2">
                                Disponible actual
                            </div>

                            <div class="fw-bold fs-5
                                @(Model.DisponibleTaller > 0
                                    ? "text-success"
                                    : "text-danger")">

                                @Model.DisponibleTaller.ToString("C")

                            </div>

                        </div>

                    </div>


                    <!-- POSTERIOR -->

                    <div class="col-12 col-md-6 col-xl">

                        <div class="border rounded-3
                            p-3
                            h-100
                            @(Model.DisponibleTallerPosterior >= 0
                                ? "border-primary bg-primary-subtle"
                                : "border-danger bg-danger-subtle")">

                            <div class="text-muted small mb-2">
                                Disponible posterior
                            </div>

                            <div class="fw-bold fs-5
                                @(Model.DisponibleTallerPosterior >= 0
                                    ? "text-primary"
                                    : "text-danger")">

                                @Model.DisponibleTallerPosterior.ToString("C")

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- 4. CONDICIONES DEL TALLER -->
            <!-- ===================================================== -->

            <div class="mb-4">

                <div class="row g-3">

                    <!-- CONDICIONES CONTRACTUALES -->

                    <div class="col-12 col-xl-5">

                        <div class="border rounded-3 h-100">

                            <div class="p-3 border-bottom">

                                <h6 class="fw-bold mb-1">
                                    Condiciones presupuestales
                                </h6>

                                <div class="text-muted small">
                                    Límites definidos en la configuración del taller
                                </div>

                            </div>


                            <div class="p-3">

                                <div class="d-flex
                                    justify-content-between
                                    mb-3">

                                    <span class="text-muted">
                                        Monto mínimo
                                    </span>

                                    <strong>
                                        @Model.MontoMinimoTaller.ToString("C")
                                    </strong>

                                </div>


                                <div class="d-flex
                                    justify-content-between">

                                    <span class="text-muted">
                                        Monto máximo
                                    </span>

                                    <strong>
                                        @Model.MontoMaximoTaller.ToString("C")
                                    </strong>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- UMBRALES -->

                    <div class="col-12 col-xl-7">

                        <div class="border rounded-3 h-100">

                            <div class="p-3 border-bottom">

                                <h6 class="fw-bold mb-1">
                                    Umbrales de control
                                </h6>

                                <div class="text-muted small">
                                    Niveles definidos para advertir riesgo presupuestal
                                </div>

                            </div>


                            <div class="p-3">

                                <div class="row g-3">

                                    <!-- ALERTA -->

                                    <div class="col-12 col-md-6">

                                        <div class="bg-light
                                            rounded-3
                                            p-3
                                            h-100">

                                            <div class="d-flex
                                                justify-content-between
                                                align-items-center
                                                mb-2">

                                                <span class="fw-semibold">

                                                    <i class="bi bi-exclamation-triangle
                                                        text-warning me-1">
                                                    </i>

                                                    Alerta

                                                </span>


                                                @if (Model.PorcentajeAlertaTaller.HasValue)
                                                {
                                                    <span class="badge
                                                        bg-warning-subtle
                                                        text-warning
                                                        border">

                                                        @Model.PorcentajeAlertaTaller.Value.ToString("0.##") %

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge
                                                        bg-light
                                                        text-muted
                                                        border">

                                                        No configurado

                                                    </span>
                                                }

                                            </div>


                                            <div class="text-muted small">
                                                Saldo mínimo
                                            </div>

                                            <div class="fw-bold mt-1">

                                                @(Model.MontoAlertaTaller.HasValue
                                                    ? Model.MontoAlertaTaller.Value.ToString("C")
                                                    : "—")

                                            </div>

                                        </div>

                                    </div>


                                    <!-- CRÍTICO -->

                                    <div class="col-12 col-md-6">

                                        <div class="bg-light
                                            rounded-3
                                            p-3
                                            h-100">

                                            <div class="d-flex
                                                justify-content-between
                                                align-items-center
                                                mb-2">

                                                <span class="fw-semibold">

                                                    <i class="bi bi-exclamation-octagon
                                                        text-danger me-1">
                                                    </i>

                                                    Crítico

                                                </span>


                                                @if (Model.PorcentajeCriticoTaller.HasValue)
                                                {
                                                    <span class="badge
                                                        bg-danger-subtle
                                                        text-danger
                                                        border">

                                                        @Model.PorcentajeCriticoTaller.Value.ToString("0.##") %

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge
                                                        bg-light
                                                        text-muted
                                                        border">

                                                        No configurado

                                                    </span>
                                                }

                                            </div>


                                            <div class="text-muted small">
                                                Saldo mínimo
                                            </div>

                                            <div class="fw-bold mt-1">

                                                @(Model.MontoCriticoTaller.HasValue
                                                    ? Model.MontoCriticoTaller.Value.ToString("C")
                                                    : "—")

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- 5. DICTAMEN DEL TALLER -->
            <!-- ===================================================== -->

            <div class="mb-4">

                @if (esRechazada)
                {
                    <div class="alert alert-warning mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-arrow-counterclockwise fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Compromiso presupuestal liberado.
                                </strong>

                                <div class="small mt-1">
                                    El compromiso presupuestal del taller fue
                                    liberado por rechazo técnico.
                                </div>

                            </div>

                        </div>

                    </div>
                }
                else if (!Model.TieneDisponibilidadTaller)
                {
                    <div class="alert alert-danger mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Insuficiencia presupuestal del taller.
                                </strong>

                                <div class="small mt-1">
                                    El disponible presupuestal del taller no
                                    es suficiente para cubrir la solicitud.
                                </div>

                            </div>

                        </div>

                    </div>
                }
                else if (Model.TallerEnCritico)
                {
                    <div class="alert alert-danger mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Nivel crítico de presupuesto.
                                </strong>

                                <div class="small mt-1">
                                    La solicitud puede cubrirse, pero el saldo
                                    posterior queda dentro del umbral crítico.
                                </div>

                            </div>

                        </div>

                    </div>
                }
                else if (Model.TallerEnAlerta)
                {
                    <div class="alert alert-warning mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Nivel de alerta presupuestal.
                                </strong>

                                <div class="small mt-1">
                                    La solicitud puede cubrirse, pero el saldo
                                    posterior queda dentro del umbral de alerta.
                                </div>

                            </div>

                        </div>

                    </div>
                }
                else
                {
                    <div class="alert alert-success mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-check-circle-fill fs-4 me-3"></i>

                            <div>

                                <strong>
                                    Disponibilidad presupuestal suficiente.
                                </strong>

                                <div class="small mt-1">
                                    El taller cuenta con presupuesto suficiente
                                    para cubrir el importe de la solicitud.
                                </div>

                            </div>

                        </div>

                    </div>
                }


                @if (!esRechazada && !Model.TieneSuficienciaPresupuestal)
                {
                    <div class="alert alert-danger mt-2 mb-0">

                        <div class="d-flex align-items-start">

                            <i class="bi bi-diagram-3-fill fs-5 me-3"></i>

                            <div>

                                <strong>
                                    Insuficiencia presupuestal del área.
                                </strong>

                                <div class="small mt-1">
                                    Una o más partidas asociadas a la solicitud
                                    no cuentan con suficiencia presupuestal.
                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>


            <!-- ===================================================== -->
            <!-- 6. VALIDACIÓN POR PARTIDA -->
            <!-- ===================================================== -->

            <div class="mb-4">

                <div class="d-flex
                    flex-column flex-lg-row
                    justify-content-between
                    align-items-lg-center
                    gap-2
                    mb-3 bg-dark text-white">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Validación por partida
                        </h5>

                        <div class="text-muted small">
                            Distribución y suficiencia presupuestal del área solicitante
                        </div>

                    </div>


                    @if (!esConsulta && !esRechazada)
                    {
                        <span class="badge
                            bg-light
                            text-dark
                            border">

                            @Model.PartidasSolicitud.Count partida(s)

                        </span>
                    }

                </div>


                @if (Model.EstatusSolicitudMantenimientoId < 4)
                {
                    <div class="table-responsive border rounded-3">

                        <table class="table table-hover
                            align-middle
                            mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Partida
                                    </th>

                                    <th>
                                        Descripción
                                    </th>

                                    <th class="text-end">
                                        Asignado
                                    </th>

                                    <th class="text-end">
                                        Disponible
                                    </th>

                                    <th class="text-end">
                                        Solicitado
                                    </th>

                                    <th class="text-end">
                                        Posterior
                                    </th>

                                    <th class="text-center">
                                        Resultado
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Model.PartidasSolicitud)
                                {
                                    var disponiblePosterior =
                                        item.DisponibleDSP
                                        -
                                        item.ImporteSolicitado;


                                    <tr>

                                        <td>
                                            <span class="fw-semibold">
                                                @item.ClaveObjetoGasto
                                            </span>
                                        </td>


                                        <td>
                                            @item.ObjetoGastoDescripcion
                                        </td>


                                        <td class="text-end">
                                            @item.AutorizadoPorArea.ToString("C")
                                        </td>


                                        <td class="text-end">

                                            <span class="fw-semibold
                                                @(item.DisponibleDSP > 0
                                                    ? "text-success"
                                                    : "text-danger")">

                                                @item.DisponibleDSP.ToString("C")

                                            </span>

                                        </td>


                                        <td class="text-end">

                                            <span class="fw-semibold text-primary">

                                                @item.ImporteSolicitado.ToString("C")

                                            </span>

                                        </td>


                                        <td class="text-end">

                                            <span class="fw-bold
                                                @(disponiblePosterior < 0
                                                    ? "text-danger"
                                                    : item.ViolaPolitica20Porciento
                                                        ? "text-warning"
                                                        : "text-success")">

                                                @disponiblePosterior.ToString("C")

                                            </span>

                                        </td>


                                        <td class="text-center">

                                            @if (!item.TieneSuficiencia)
                                            {
                                                <span class="badge bg-danger">

                                                    <i class="bi bi-x-circle me-1"></i>

                                                    Insuficiente

                                                </span>
                                            }
                                            else if (item.ViolaPolitica20Porciento)
                                            {
                                                <span class="badge
                                                    bg-warning
                                                    text-dark">

                                                    <i class="bi bi-exclamation-triangle me-1"></i>

                                                    Política 20 %

                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">

                                                    <i class="bi bi-check-circle me-1"></i>

                                                    Suficiente

                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }


                @if (!Model.TieneSuficienciaPresupuestal)
                {
                    <div class="alert alert-danger mt-3 mb-0">

                        <i class="bi bi-exclamation-octagon-fill me-2"></i>

                        El importe solicitado excede el presupuesto disponible
                        en una o más partidas.

                    </div>
                }
                else if (Model.ViolaPolitica20Porciento)
                {
                    <div class="alert alert-warning mt-3 mb-0">

                        <i class="bi bi-exclamation-triangle-fill me-2"></i>

                        La autorización dejaría una o más partidas con una
                        disponibilidad igual o menor al 20 % del presupuesto asignado.

                    </div>
                }
                else
                {
                    <div class="alert alert-success mt-3 mb-0">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        Todas las partidas cuentan con suficiencia presupuestal.

                    </div>
                }

            </div>


            <!-- ===================================================== -->
            <!-- 7. HISTORIAL DE LA SOLICITUD -->
            <!-- ===================================================== -->
            @if (esConsulta || esRechazada)
            {
                <div class="mb-4">

                    <div class="d-flex
                        align-items-center
                        justify-content-between
                        mb-3">

                        <div>

                            <h5 class="fw-bold mb-1">
                                Historial presupuestal de la solicitud
                            </h5>

                            <div class="text-muted small">
                                Resultado de los compromisos y liberaciones registrados
                            </div>

                        </div>

                    </div>


                    <div class="table-responsive border rounded-3">

                        <table class="table table-hover
                            align-middle
                            mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Partida
                                    </th>

                                    <th>
                                        Descripción
                                    </th>

                                    <th class="text-end">
                                        Asignado
                                    </th>

                                    <th class="text-end">
                                        Disponible
                                    </th>

                                    <th class="text-end">
                                        Solicitado
                                    </th>

                                    @if (esRechazada)
                                    {
                                        <th class="text-end">
                                            Liberado
                                        </th>
                                    }
                                    else
                                    {
                                        <th class="text-center">
                                            Situación
                                        </th>
                                    }

                                    <th class="text-center">
                                        Estado
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Model.PartidasSolicitud)
                                {
                                    <tr>

                                        <td>
                                            <span class="fw-semibold">
                                                @item.ClaveObjetoGasto
                                            </span>
                                        </td>

                                        <td>
                                            @item.ObjetoGastoDescripcion
                                        </td>

                                        <td class="text-end">
                                            @item.AutorizadoPorArea.ToString("C")
                                        </td>

                                        <td class="text-end text-success fw-bold">
                                            @item.DisponibleDSP.ToString("C")
                                        </td>


                                        <td class="text-end fw-bold text-primary">
                                            @item.ImporteSolicitado.ToString("C")
                                        </td>


                                        @if (esRechazada)
                                        {
                                            <td class="text-end text-danger fw-bold">
                                                @item.ImporteLiberado.ToString("C")
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="text-center">

                                                @if (item.HistorialPresupuestal ==
                                                    "Rechazada y posteriormente reaprobada")
                                                {
                                                    <span class="badge
                                                        bg-warning
                                                        text-dark">

                                                        Re-aprobada

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">

                                                        Vigente

                                                    </span>
                                                }

                                            </td>
                                        }


                                        <td class="text-center">

                                            @if (esRechazada)
                                            {
                                                <span class="badge bg-danger">
                                                    Rechazada
                                                </span>
                                            }
                                            else if (esAutorizada)
                                            {
                                                <span class="badge bg-primary">
                                                    Autorizada
                                                </span>
                                            }
                                            else if (esEnMantenimiento)
                                            {
                                                <span class="badge bg-info">
                                                    En mantenimiento
                                                </span>
                                            }
                                            else if (esFinalizada)
                                            {
                                                <span class="badge bg-success">
                                                    Finalizada
                                                </span>
                                            }
                                            else if (item.TieneSuficiencia)
                                            {
                                                <span class="badge bg-success">
                                                    Con suficiencia
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>


                    <!-- MENSAJE HISTÓRICO -->
                    @if (esRechazada)
                    {
                        <div class="alert alert-warning mt-3 mb-0">

                            <i class="bi bi-arrow-counterclockwise me-2"></i>

                            Esta solicitud fue rechazada y el compromiso
                            presupuestal fue liberado.

                        </div>
                    }
                    else if (esAutorizada)
                    {
                        <div class="alert alert-info mt-3 mb-0">

                            <i class="bi bi-shield-check me-2"></i>

                            La solicitud cuenta con DSP autorizada.

                        </div>
                    }
                    else if (esEnMantenimiento)
                    {
                        <div class="alert alert-primary mt-3 mb-0">

                            <i class="bi bi-tools me-2"></i>

                            La solicitud se encuentra en mantenimiento.
                            El compromiso presupuestal permanece vigente.

                        </div>
                    }
                    else if (esFinalizada)
                    {
                        <div class="alert alert-success mt-3 mb-0">

                            <i class="bi bi-check-circle me-2"></i>

                            La solicitud fue concluida satisfactoriamente.

                        </div>
                    }

                </div>
            }


            <!-- ===================================================== -->
            <!-- 8. RESUMEN DSP -->
            <!-- ===================================================== -->

            <div class="mb-4">

                <div class="d-flex
                    justify-content-between
                    align-items-center
                    mb-3">

                    <div>

                        <h5 class="fw-bold mb-1">
                            Disponibilidad presupuestal del área
                        </h5>

                        <div class="text-muted small">
                            Resumen por objeto de gasto
                        </div>

                    </div>

                </div>


                <div class="row g-3">

                    @foreach (var dsp in Model.DSPs)
                    {
                        <div class="col-12 col-md-6 col-xl-4">

                            <div class="border rounded-3
                                p-3
                                h-100">

                                <div class="d-flex
                                    justify-content-between
                                    gap-3
                                    mb-3">

                                    <div>

                                        <div class="fw-bold">
                                            @dsp.ObjetoGastoDescripcion
                                        </div>

                                        <div class="text-muted small">
                                            @dsp.ClaveObjetoGasto
                                        </div>

                                    </div>

                                    <i class="bi bi-wallet2
                                        text-primary
                                        fs-4">
                                    </i>

                                </div>


                                <div class="row g-2">

                                    <div class="col-6">

                                        <div class="text-muted small">
                                            Asignado
                                        </div>

                                        <div class="fw-semibold">
                                            @dsp.PresupuestoAsignado.ToString("C")
                                        </div>

                                    </div>


                                    <div class="col-6">

                                        <div class="text-muted small">
                                            Comprometido
                                        </div>

                                        <div class="fw-semibold text-warning">
                                            @dsp.PresupuestoComprometido.ToString("C")
                                        </div>

                                    </div>


                                    <div class="col-6 mt-3">

                                        <div class="text-muted small">
                                            Devengado
                                        </div>

                                        <div class="fw-semibold">
                                            @dsp.PresupuestoDevengado.ToString("C")
                                        </div>

                                    </div>


                                    <div class="col-6 mt-3">

                                        <div class="text-muted small">
                                            Disponible
                                        </div>

                                        <div class="fw-bold fs-5 text-success">
                                            @dsp.PresupuestoDisponible.ToString("C")
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>


            <!-- ===================================================== -->
            <!-- 9. DICTAMEN / OBSERVACIONES -->
            <!-- ===================================================== -->

            <div class="border rounded-3 p-3 mb-4">

                <div class="d-flex align-items-center gap-2 mb-3">

                    <i class="bi bi-clipboard-check text-primary"></i>

                    <div>

                        <h5 class="fw-bold mb-0">
                            Dictamen financiero
                        </h5>

                        <div class="text-muted small">
                            Observaciones de la validación presupuestal
                        </div>

                    </div>

                </div>


                <label asp-for="Observaciones"
                       class="form-label fw-semibold">

                    Observaciones financieras

                </label>


                <textarea asp-for="Observaciones"
                          rows="4"
                          class="form-control"
                          placeholder="Capture las observaciones relevantes de la validación presupuestal..."></textarea>


                <span asp-validation-for="Observaciones"
                      class="text-danger">
                </span>

            </div>


            <!-- ===================================================== -->
            <!-- 10. ACCIONES -->
            <!-- ===================================================== -->

            <div class="border-top pt-4">

                <div class="d-flex
                    flex-column flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>

                        Cancelar

                    </a>


                    <div>

                        @if (Model.EstatusSolicitudMantenimientoId >= 4)
                        {
                            if (tieneLiberaciones)
                            {
                                <button type="button"
                                        class="btn btn-warning"
                                        disabled>

                                    <i class="bi bi-arrow-counterclockwise me-1"></i>

                                    DSP liberada por rechazo

                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled>

                                    <i class="bi bi-lock-fill me-1"></i>

                                    Solicitud ya validada presupuestalmente

                                </button>
                            }
                        }
                        else if (!Model.TieneSuficienciaPresupuestal)
                        {
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled>

                                <i class="bi bi-lock-fill me-1"></i>

                                Sin suficiencia presupuestal del área

                            </button>
                        }
                        else if (!Model.TieneDisponibilidadTaller)
                        {
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled>

                                <i class="bi bi-building-lock me-1"></i>

                                Taller sin disponibilidad presupuestal

                            </button>
                        }
                        else if (Model.ViolaPolitica20Porciento)
                        {
                            <button type="submit"
                                    class="btn btn-warning text-dark">

                                <i class="bi bi-exclamation-triangle me-1"></i>

                                Autorizar con alerta del 20 %

                            </button>
                        }
                        else if (puedeAutorizar)
                        {
                            <button type="submit"
                                    class="btn btn-success">

                                <i class="bi bi-check-circle me-1"></i>

                                Autorizar DSP

                            </button>
                        }

                    </div>

                </div>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script>

        $(document).ready(function () {

            // =====================================================
            // CONFIRMAR AUTORIZACIÓN DSP
            // =====================================================

            $("#formDSP").on("submit", function (e) {

                e.preventDefault();

                const form = this;


                Swal.fire({

                    title:
                        "¿Autorizar afectación presupuestal?",

                    text:
                        "Se realizará el compromiso presupuestal de la solicitud de mantenimiento.",

                    icon:
                        "question",

                    showCancelButton:
                        true,

                    confirmButtonColor:
                        "#198754",

                    cancelButtonColor:
                        "#6c757d",

                    confirmButtonText:
                        "Sí, continuar",

                    cancelButtonText:
                        "Cancelar"

                }).then((result) => {

                    if (result.isConfirmed) {

                        form.submit();

                    }

                });

            });

        });

    </script>

} *@



@using System.Diagnostics
@using SIGEMAV.Models.ViewModels.Maquinaria
@model DSPViewModel

@{
    // =========================================================
    // ESTADOS DE LA SOLICITUD
    // =========================================================

    var esPendienteDSP = Model.EstatusSolicitudMantenimientoId == 2;
    var esPendienteRevision = Model.EstatusSolicitudMantenimientoId == 4;
    var esRechazada = Model.EstatusSolicitudMantenimientoId == 6;
    var esAutorizada = Model.EstatusSolicitudMantenimientoId == 5;
    var esEnMantenimiento = Model.EstatusSolicitudMantenimientoId == 7;
    var esFinalizada = Model.EstatusSolicitudMantenimientoId == 8;

    var esConsulta = esAutorizada || esEnMantenimiento || esFinalizada || esPendienteRevision;

    // =========================================================
    // ESTADO GENERAL DEL TALLER
    // =========================================================

    var estadoTallerTexto = esRechazada
        ? "PRESUPUESTO LIBERADO"
        : !Model.TieneDisponibilidadTaller
            ? "SIN DISPONIBILIDAD"
            : Model.TallerEnCritico
                ? "NIVEL CRÍTICO"
                : Model.TallerEnAlerta
                    ? "NIVEL DE ALERTA"
                    : "DISPONIBILIDAD";

    var estadoTallerClase = esRechazada
        ? "warning"
        : !Model.TieneDisponibilidadTaller
            ? "danger"
            : Model.TallerEnCritico
                ? "danger"
                : Model.TallerEnAlerta
                    ? "warning"
                    : "success";

    var estadoTallerIcono = esRechazada
        ? "bi-arrow-counterclockwise"
        : !Model.TieneDisponibilidadTaller
            ? "bi-x-circle"
            : Model.TallerEnCritico
                ? "bi-exclamation-octagon"
                : Model.TallerEnAlerta
                    ? "bi-exclamation-triangle"
                    : "bi-check-circle";

    // =========================================================
    // RESULTADO GLOBAL
    // =========================================================

    var puedeAutorizar = Model.TieneSuficienciaPresupuestal && Model.TieneDisponibilidadTaller;

    var tieneLiberaciones = Model.PartidasDSP?.Any(x => x.FueDescomprometida) ?? false;

    // =========================================================
    // ESTADO DE LA VALIDACIÓN
    // =========================================================

    var estadoSolicitudTexto = esRechazada
        ? "Rechazada"
        : esFinalizada
            ? "Finalizada"
            : esEnMantenimiento
                ? "En mantenimiento"
                : esAutorizada
                    ? "Autorizada"
                    : esPendienteRevision
                        ? "Pendiente de revisión"
                        : "Pendiente de DSP";

    var estadoSolicitudClase = esRechazada
        ? "danger"
        : esFinalizada
            ? "success"
            : esEnMantenimiento
                ? "info"
                : esAutorizada
                    ? "primary"
                    : "warning";
}

<div class="card shadow-sm border-0">

    <!-- ENCABEZADO PRINCIPAL -->
    <div class="card-header bg-white border-bottom py-3">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <div class="bg-primary-subtle text-primary rounded-3 p-2">
                        <i class="bi bi-cash-coin fs-4"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">Validación presupuestal DSP</h4>
                        <div class="text-muted small">Revisión financiera de la solicitud de mantenimiento</div>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-@estadoSolicitudClase @(estadoSolicitudClase == "warning" ? "text-dark" : "") px-3 py-2">
                    @estadoSolicitudTexto
                </span>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Regresar
                </a>
            </div>
        </div>
    </div>

    <div class="card-body p-4">

        <!-- MENSAJE DE ERROR TEMPDATA -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-exclamation-triangle-fill fs-5 me-3"></i>
                    <div>
                        <strong>No fue posible continuar.</strong>
                        <div class="small mt-1">@TempData["Error"]</div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form asp-action="DSP" method="post" id="formDSP">
            @Html.AntiForgeryToken()

            <input asp-for="SolicitudMantenimientoId" type="hidden" />
            <input asp-for="Folio" type="hidden" />
            <input asp-for="AreaId" type="hidden" />

            @for (int i = 0; i < Model.PartidasSolicitud.Count; i++)
            {
                <input type="hidden" asp-for="PartidasSolicitud[i].IdObjetoGasto" />
                <input type="hidden" asp-for="PartidasSolicitud[i].ImporteSolicitado" />
                <input type="hidden" asp-for="PartidasSolicitud[i].ClaveObjetoGasto" />
            }

            <!-- 1. IDENTIFICACIÓN DE LA SOLICITUD -->
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Información de la solicitud</h5>
                        <div class="text-muted small">Datos generales sujetos a validación presupuestal</div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded-3 p-3 h-100 bg-light">
                            <div class="text-muted small mb-1">Folio</div>
                            <div class="fw-bold fs-5">@Model.Folio</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="d-flex align-items-center gap-2 text-muted small mb-1">
                                <i class="bi bi-diagram-3"></i> Área solicitante
                            </div>
                            <div class="fw-bold">@Model.Area</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="border rounded-3 p-3 h-100 border-primary-subtle">
                            <div class="d-flex align-items-center gap-2 text-primary small mb-1">
                                <i class="bi bi-building"></i> Taller
                            </div>
                            <div class="fw-bold">@Model.Taller?.Trim()</div>
                        </div>
                    </div>

                 <div class="col-12 col-md-6 col-xl-3">
    <div class="border rounded-3 p-3 h-100 bg-primary-subtle border-primary-subtle d-flex flex-column justify-content-between">
        <div class="text-primary small fw-semibold mb-2 d-flex justify-content-between align-items-center">
            <span><i class="bi bi-cash-stack me-1"></i> Importe Total</span>
            <span class="badge bg-primary bg-opacity-10 text-primary" style="font-size: 0.65rem;">Con IVA Incluido</span>
        </div>

        <div class="small">
            @{
                // Matemáticas inversas: el modelo trae el total con IVA incluido
                var totalConIva = Model.ImporteSolicitud;
                var baseCalculada = totalConIva / 1.16m;
                var ivaCalculado = totalConIva - baseCalculada;
            }

            <!-- BASE (Sin IVA) -->
            <div class="d-flex justify-content-between text-secondary mb-1">
                <span class="fw-medium">Base:</span>
                <span class="text-dark">@baseCalculada.ToString("C")</span>
            </div>

            <!-- IVA (16% desglosado) -->
            <div class="d-flex justify-content-between text-secondary mb-1 pb-1 border-bottom border-primary-subtle">
                <span class="fw-medium">IVA:</span>
                <span class="text-dark">@ivaCalculado.ToString("C")</span>
            </div>

            <!-- TOTAL -->
            <div class="d-flex justify-content-between align-items-center pt-1">
                <span class="fw-bold text-primary">Total:</span>
                <span class="fw-bold fs-6 text-primary">@totalConIva.ToString("C")</span>
            </div>
        </div>
    </div>
</div>
                </div>
            </div>

            <!-- 2. PRESUPUESTO DEL TALLER -->
            <div class="mb-4">
                <div class="d-flex align-items-center justify-content-between mb-3 bg-dark text-white p-2 rounded">
                    <div>
                        <h5 class="fw-bold mb-1">Presupuesto del taller</h5>
                        <div class="text-white-50 small">Situación financiera del taller para el ejercicio vigente</div>
                    </div>
                    <span class="badge bg-light text-dark border">Control presupuestal</span>
                </div>

                <div class="row g-3">
                    <div class="col-12 col-md-6 col-xl">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small mb-2">Presupuesto asignado</div>
                            <div class="fw-bold fs-5">@Model.PresupuestoTaller.ToString("C")</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small mb-2">Comprometido</div>
                            <div class="fw-bold fs-5 text-warning">@Model.ComprometidoTaller.ToString("C")</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl">
                        <div class="border rounded-3 p-3 h-100">
                            <div class="text-muted small mb-2">Ejercido</div>
                            <div class="fw-bold fs-5">@Model.EjercidoTaller.ToString("C")</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl">
                        <div class="border rounded-3 p-3 h-100 @(Model.DisponibleTaller > 0 ? "border-success" : "border-danger")">
                            <div class="text-muted small mb-2">Disponible actual</div>
                            <div class="fw-bold fs-5 @(Model.DisponibleTaller > 0 ? "text-success" : "text-danger")">
                                @Model.DisponibleTaller.ToString("C")
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl">
                        <div class="border rounded-3 p-3 h-100 @(Model.DisponibleTallerPosterior >= 0 ? "border-primary bg-primary-subtle" : "border-danger bg-danger-subtle")">
                            <div class="text-muted small mb-2">Disponible posterior</div>
                            <div class="fw-bold fs-5 @(Model.DisponibleTallerPosterior >= 0 ? "text-primary" : "text-danger")">
                                @Model.DisponibleTallerPosterior.ToString("C")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 3. CONDICIONES Y UMBRALES DEL TALLER -->
            <div class="mb-4">
                <div class="row g-3">
                    <div class="col-12 col-xl-5">
                        <div class="border rounded-3 h-100">
                            <div class="p-3 border-bottom">
                                <h6 class="fw-bold mb-1">Condiciones presupuestales</h6>
                                <div class="text-muted small">Límites definidos en la configuración del taller</div>
                            </div>
                            <div class="p-3">
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-muted">Monto mínimo</span>
                                    <strong>@Model.MontoMinimoTaller.ToString("C")</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted">Monto máximo</span>
                                    <strong>@Model.MontoMaximoTaller.ToString("C")</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-7">
                        <div class="border rounded-3 h-100">
                            <div class="p-3 border-bottom">
                                <h6 class="fw-bold mb-1">Umbrales de control</h6>
                                <div class="text-muted small">Niveles definidos para advertir riesgo presupuestal</div>
                            </div>
                            <div class="p-3">
                                <div class="row g-3">
                                    <div class="col-12 col-md-6">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-semibold">
                                                    <i class="bi bi-exclamation-triangle text-warning me-1"></i> Alerta
                                                </span>
                                                @if (Model.PorcentajeAlertaTaller.HasValue)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border">
                                                        @Model.PorcentajeAlertaTaller.Value.ToString("0.##") %
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">No configurado</span>
                                                }
                                            </div>
                                            <div class="text-muted small">Saldo mínimo</div>
                                            <div class="fw-bold mt-1">
                                                @(Model.MontoAlertaTaller.HasValue ? Model.MontoAlertaTaller.Value.ToString("C") : "—")
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="bg-light rounded-3 p-3 h-100">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="fw-semibold">
                                                    <i class="bi bi-exclamation-octagon text-danger me-1"></i> Crítico
                                                </span>
                                                @if (Model.PorcentajeCriticoTaller.HasValue)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border">
                                                        @Model.PorcentajeCriticoTaller.Value.ToString("0.##") %
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border">No configurado</span>
                                                }
                                            </div>
                                            <div class="text-muted small">Saldo mínimo</div>
                                            <div class="fw-bold mt-1">
                                                @(Model.MontoCriticoTaller.HasValue ? Model.MontoCriticoTaller.Value.ToString("C") : "—")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

                                <!-- 4. DICTAMEN GENERAL Y SUFICIENCIA -->
                    <div class="mb-4">
                        @if (esRechazada)
                        {
                            <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-0">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 bg-warning bg-opacity-20 text-warning-emphasis rounded-3">
                                        <i class="bi bi-arrow-counterclockwise fs-4"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">Compromiso presupuestal liberado</strong>
                                        <div class="small text-muted mt-1">El compromiso presupuestal del taller fue liberado debido a un rechazo técnico.</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (!Model.TieneDisponibilidadTaller)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-0">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 bg-danger bg-opacity-20 text-danger rounded-3">
                                        <i class="bi bi-exclamation-octagon-fill fs-4"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">Insuficiencia presupuestal del taller</strong>
                                        <div class="small text-muted mt-1">El disponible presupuestal del taller asignado no es suficiente para cubrir la solicitud.</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Model.TallerEnCritico)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-0">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 bg-danger bg-opacity-20 text-danger rounded-3">
                                        <i class="bi bi-shield-slash-fill fs-4"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">Nivel crítico de presupuesto en el taller (Proceso Detenido)</strong>
                                        <div class="small text-muted mt-1">
                                            El saldo posterior del taller sobrepasa el umbral crítico permitido. 
                                            <strong>El flujo no puede continuar ni autorizarse</strong> hasta reasignar taller o incrementar techo presupuestal.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Model.TallerEnAlerta)
                        {
                            <div class="alert alert-warning border-0 shadow-sm rounded-3 mb-0">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 bg-warning bg-opacity-20 text-warning-emphasis rounded-3">
                                        <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">Nivel de alerta presupuestal en el taller</strong>
                                        <div class="small text-muted mt-1">La solicitud puede cubrirse, pero el saldo posterior queda dentro del umbral de alerta. Requiere atención técnica.</div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success border-0 shadow-sm rounded-3 mb-0">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 bg-success bg-opacity-20 text-success rounded-3">
                                       <i class="bi bi-check-square-fill fs-5 text-white"></i>

                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">Disponibilidad presupuestal suficiente en el taller</strong>
                                <div class="small text-muted mt-1">El taller cuenta con presupuesto disponible adecuado para cubrir el importe de esta solicitud. (Esta notificación es meramente informativa debe revisar los presupuestos reales).</div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (!esRechazada && !Model.TieneSuficienciaPresupuestal)
                        {
                            <div class="alert alert-danger border-0 shadow-sm rounded-3 mt-3 mb-0">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="p-2 bg-danger bg-opacity-20 text-danger rounded-3">
                                        <i class="bi bi-diagram-3-fill fs-5 text-white"></i>
                                    </div>
                                    <div>
                                        <strong class="text-dark d-block">Insuficiencia presupuestal del área</strong>
                                        <div class="small text-muted mt-1">Una o más partidas asociadas a la solicitud no cuentan con suficiencia presupuestal disponible.</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

            <!-- 5. VALIDACIÓN POR PARTIDA DE LA SOLICITUD -->
            <div class="mb-4">
                <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 mb-3 bg-dark text-white p-2 rounded">
                    <div>
                        <h5 class="fw-bold mb-1">Validación por partida</h5>
                        <div class="text-white-50 small">Distribución y suficiencia presupuestal del área solicitante</div>
                    </div>
                    @if (!esConsulta && !esRechazada)
                    {
                        <span class="badge bg-light text-dark border">@Model.PartidasSolicitud.Count partida(s)</span>
                    }
                </div>

                @if (Model.EstatusSolicitudMantenimientoId < 4)
                {
                    <div class="table-responsive border rounded-3">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Partida</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Asignado</th>
                                    <th class="text-end">Disponible</th>
                                    <th class="text-end">Solicitado</th>
                                    <th class="text-end">Posterior</th>
                                    <th class="text-center">Resultado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PartidasSolicitud)
                                {
                                    var disponiblePosterior = item.DisponibleDSP - item.ImporteSolicitado;

                                    <tr>
                                        <td>
                                            <span class="fw-semibold">@item.ClaveObjetoGasto</span>
                                        </td>
                                        <td>@item.ObjetoGastoDescripcion</td>
                                        <td class="text-end">@item.AutorizadoPorArea.ToString("C")</td>
                                        <td class="text-end">
                                            <span class="fw-semibold @(item.DisponibleDSP > 0 ? "text-success" : "text-danger")">
                                                @item.DisponibleDSP.ToString("C")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-semibold text-primary">@item.ImporteSolicitado.ToString("C")</span>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold @(disponiblePosterior < 0 ? "text-danger" : item.ViolaPolitica20Porciento ? "text-warning" : "text-success")">
                                                @disponiblePosterior.ToString("C")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (!item.TieneSuficiencia)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i> Insuficiente
                                                </span>
                                            }
                                            else if (item.ViolaPolitica20Porciento)
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-exclamation-triangle me-1"></i> Política 20 %
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i> Suficiente
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (!Model.TieneSuficienciaPresupuestal)
                {
                    <div class="alert alert-danger mt-3 mb-0">
                        <i class="bi bi-exclamation-octagon-fill me-2"></i> El importe solicitado excede el presupuesto disponible en una o más partidas del área.
                    </div>
                }
                else if (Model.ViolaPolitica20Porciento)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> La autorización dejaría una o más partidas del área con una disponibilidad igual o menor al 20 % del presupuesto asignado.
                    </div>
                }
                else
                {
                    <div class="alert alert-success mt-3 mb-0">
                        <i class="bi bi-check-circle-fill me-2"></i> Todas las partidas del área cuentan con suficiencia presupuestal (Esta notificación es meramente informativa debe revisar los presupuestos reales).
                    </div>
                }
            </div>

            <!-- 6. HISTORIAL DE LA SOLICITUD (SÓLO SI ES CONSULTA O RECHAZADA) -->
            @if (esConsulta || esRechazada)
            {
                <div class="mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">Historial presupuestal de la solicitud</h5>
                            <div class="text-muted small">Resultado de los compromisos y liberaciones registrados</div>
                        </div>
                    </div>

                    <div class="table-responsive border rounded-3">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Partida</th>
                                    <th>Descripción</th>
                                    <th class="text-end">Asignado</th>
                                    <th class="text-end">Disponible</th>
                                    <th class="text-end">Solicitado</th>
                                    @if (esRechazada)
                                    {
                                        <th class="text-end">Liberado</th>
                                    }
                                    else
                                    {
                                        <th class="text-center">Situación</th>
                                    }
                                    <th class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PartidasSolicitud)
                                {
                                    <tr>
                                        <td><span class="fw-semibold">@item.ClaveObjetoGasto</span></td>
                                        <td>@item.ObjetoGastoDescripcion</td>
                                        <td class="text-end">@item.AutorizadoPorArea.ToString("C")</td>
                                        <td class="text-end text-success fw-bold">@item.DisponibleDSP.ToString("C")</td>
                                        <td class="text-end fw-bold text-primary">@item.ImporteSolicitado.ToString("C")</td>

                                        @if (esRechazada)
                                        {
                                            <td class="text-end text-danger fw-bold">@item.ImporteLiberado.ToString("C")</td>
                                        }
                                        else
                                        {
                                            <td class="text-center">
                                                @if (item.HistorialPresupuestal == "Rechazada y posteriormente reaprobada")
                                                {
                                                    <span class="badge bg-warning text-dark">Re-aprobada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Vigente</span>
                                                }
                                            </td>
                                        }

                                        <td class="text-center">
                                            @if (esRechazada)
                                            {
                                                <span class="badge bg-danger">Rechazada</span>
                                            }
                                            else if (esAutorizada)
                                            {
                                                <span class="badge bg-primary">Autorizada</span>
                                            }
                                            else if (esEnMantenimiento)
                                            {
                                                <span class="badge bg-info">En mantenimiento</span>
                                            }
                                            else if (esFinalizada)
                                            {
                                                <span class="badge bg-success">Finalizada</span>
                                            }
                                            else if (item.TieneSuficiencia)
                                            {
                                                <span class="badge bg-success">Con suficiencia</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (esRechazada)
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-arrow-counterclockwise me-2"></i> Esta solicitud fue rechazada y el compromiso presupuestal fue liberado.
                        </div>
                    }
                    else if (esAutorizada)
                    {
                        <div class="alert alert-info mt-3 mb-0">
                            <i class="bi bi-shield-check me-2"></i> La solicitud cuenta con DSP autorizada.
                        </div>
                    }
                    else if (esEnMantenimiento)
                    {
                        <div class="alert alert-primary mt-3 mb-0">
                            <i class="bi bi-tools me-2"></i> La solicitud se encuentra en mantenimiento. El compromiso presupuestal permanece vigente.
                        </div>
                    }
                    else if (esFinalizada)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <i class="bi bi-check-circle me-2"></i> La solicitud fue concluida satisfactoriamente.
                        </div>
                    }
                </div>
            }

            <!-- 7. DISPONIBILIDAD PRESUPUESTAL RESUMEN DEL ÁREA (PartidasDSP) -->
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold mb-1">Disponibilidad presupuestal del área</h5>
                        <div class="text-muted small">Resumen por objeto de gasto</div>
                    </div>
                </div>

                <div class="row g-3">
                    @* CORREGIDO: Se cambia Model.DSPs por Model.PartidasDSP *@
                    @foreach (var dsp in Model.PartidasDSP)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="border rounded-3 p-3 h-100">
                                <div class="d-flex justify-content-between gap-3 mb-3">
                                    <div>
                                        <div class="fw-bold">@dsp.ObjetoGastoDescripcion</div>
                                        <div class="text-muted small">@dsp.ClaveObjetoGasto</div>
                                    </div>
                                    <i class="bi bi-wallet2 text-primary fs-4"></i>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <div class="text-muted small">Asignado</div>
                                        <div class="fw-semibold">@dsp.PresupuestoAsignado.ToString("C")</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-muted small">Comprometido</div>
                                        <div class="fw-semibold text-warning">@dsp.PresupuestoComprometido.ToString("C")</div>
                                    </div>
                                    <div class="col-6 mt-3">
                                        <div class="text-muted small">Devengado</div>
                                        <div class="fw-semibold">@dsp.PresupuestoDevengado.ToString("C")</div>
                                    </div>
                                    <div class="col-6 mt-3">
                                        <div class="text-muted small">Disponible</div>
                                        <div class="fw-bold fs-5 text-success">@dsp.PresupuestoDisponible.ToString("C")</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- 8. DICTAMEN / OBSERVACIONES -->
            <div class="border rounded-3 p-3 mb-4">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-clipboard-check text-primary"></i>
                    <div>
                        <h5 class="fw-bold mb-0">Dictamen financiero</h5>
                        <div class="text-muted small">Observaciones de la validación presupuestal</div>
                    </div>
                </div>

                <label asp-for="Observaciones" class="form-label fw-semibold">Observaciones financieras</label>
                
                @if (esConsulta)
                {
                    <textarea asp-for="Observaciones" rows="4" class="form-control" readonly disabled></textarea>
                }
                else
                {
                    <textarea asp-for="Observaciones" rows="4" class="form-control" placeholder="Capture las observaciones relevantes de la validación presupuestal..."></textarea>
                }

                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

                    <!-- 9. BARRAS DE ACCIONES -->
                    <div class="card border-0 shadow-sm rounded-3 mt-4">
                        <div class="card-body p-3 bg-light rounded-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-2 fw-semibold">
                                <i class="bi bi-arrow-left me-1"></i> Regresar
                            </a>

                            <div class="d-flex align-items-center gap-2">
                                @if (Model.EstatusSolicitudMantenimientoId >= 4)
                                {
                                    if (tieneLiberaciones)
                                    {
                                        <button type="button" class="btn btn-warning px-4 py-2 rounded-2 fw-semibold" disabled>
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> DSP liberada por rechazo
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary px-4 py-2 rounded-2 fw-semibold" disabled>
                                            <i class="bi bi-lock-fill me-1"></i> Solicitud ya validada presupuestalmente
                                        </button>
                                    }
                                }
                                else if (!Model.TieneSuficienciaPresupuestal)
                                {
                                    <button type="button" class="btn btn-secondary px-4 py-2 rounded-2 fw-semibold" disabled>
                                        <i class="bi bi-lock-fill me-1"></i> Sin suficiencia presupuestal del área
                                    </button>
                                }
                                else if (!Model.TieneDisponibilidadTaller)
                                {
                                    <button type="button" class="btn btn-secondary px-4 py-2 rounded-2 fw-semibold" disabled>
                                        <i class="bi bi-building-lock me-1"></i> Taller sin disponibilidad presupuestal
                                    </button>
                                }
                                else if (Model.TallerEnCritico)
                                {
                                    <!-- BLOQUEO ESTRICTO POR UMBRAL CRÍTICO -->
                                    <button type="button" class="btn btn-danger px-4 py-2 rounded-2 fw-semibold shadow-sm" disabled>
                                        <i class="bi bi-slash-circle me-1"></i> Taller en nivel crítico presupuestal
                                    </button>
                                }
                                else if (Model.TallerEnAlerta)
                                {
                                    <!-- PERMITE CONTINUAR CON ALERTA DE UMBRAL EN TALLER -->
                                    <button type="submit" class="btn btn-warning text-dark px-4 py-2 rounded-2 fw-semibold shadow-sm">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Autorizar (Taller en Nivel de Alerta)
                                    </button>
                                }
                                else if (Model.ViolaPolitica20Porciento)
                                {
                                    <button type="submit" class="btn btn-warning text-dark px-4 py-2 rounded-2 fw-semibold shadow-sm">
                                        <i class="bi bi-exclamation-triangle me-1"></i> Autorizar con alerta del 20 %
                                    </button>
                                }
                                else if (puedeAutorizar)
                                {
                                    <button type="submit" class="btn btn-success px-4 py-2 rounded-2 fw-semibold shadow-sm">
                                        <i class="bi bi-check-circle me-1"></i> Autorizar DSP
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $("#formDSP").on("submit", function (e) {
                e.preventDefault();
                const form = this;

                Swal.fire({
                    title: "¿Autorizar afectación presupuestal?",
                    text: "Se realizará el compromiso presupuestal de la solicitud de mantenimiento.",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonColor: "#198754",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Sí, continuar",
                    cancelButtonText: "Cancelar"
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
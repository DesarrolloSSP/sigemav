		$("#formEdit").on("submit", async function (e) {

    e.preventDefault();

    const unidadVehicularId =
        $("#UnidadVehicularId").val();

    const tipoMantenimientoId =
        $("#TipoMantenimientoId").val();

    const conceptos = [];

    $("#tablaServicios tbody tr").each(function () {

        const concepto =
            $(this)
                .find(".conceptoServicio")
                .val();

        if (concepto) {
            conceptos.push(parseInt(concepto));
        }
    });

    const response =
        await $.ajax({
            url: '/Maquinaria/SolicitudMantenimiento/ValidarServiciosEdit',
            type: 'POST',
            data: {
                unidadVehicularId,
                conceptos,
                tipoMantenimientoId
            }
        });

    //-------------------------------------
    // ALERTA HISTÓRICO (IGUAL QUE CREATE)
    //-------------------------------------

    if (response.tieneRecurrencia) {

        const continuar =
            await Swal.fire({

                icon: 'warning',

                title: 'Servicio recurrente',

                html:
                    response.mensajes.join("<br><br>") +
                    "<br><br>¿Desea continuar?",

                showCancelButton: true,

                confirmButtonText: 'Continuar',

                cancelButtonText: 'Cancelar',

                confirmButtonColor: '#800705'
            });

        if (!continuar.isConfirmed) {
            return false;
        }
    }

    //-------------------------------------
    // DUPLICADOS (BLOQUEANTE)
    //-------------------------------------

    if (response.tieneDuplicadosActivos) {

        await Swal.fire({

            icon: 'error',

            title: 'Validación bloqueante',

            html: response.mensajes.join("<br><br>"),

            confirmButtonColor: '#800705'
        });

        return false;
    }

    //-------------------------------------
    // SI TODO OK → SUBMIT REAL
    //-------------------------------------

    this.submit();
});











		.val(costoMO);

		fila.find(".costoManoObraVisual")
		.val(formatoMoneda(costoMO));

		fila.find(".costoRefacciones")
		.val(costoRef);

		fila.find(".costoRefaccionesVisual")
		.val(formatoMoneda(costoRef));

		// ==============================
		// MANO DE OBRA
		// ==============================

		if (costoMO > 0) {

		selectMO.prop("required", true);

		if (!selectMO.val()) {

		ayudaMO
		.removeClass("text-muted text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");
		}
		}
		else {

		selectMO.prop("required", false);

		ayudaMO
		.removeClass("text-danger text-success fw-bold")
		.addClass("text-muted")
		.text("No aplica");
		}

		// ==============================
		// REFACCIONES
		// ==============================

		if (costoRef > 0) {

		selectRef.prop("required", true);

		if (!selectRef.val()) {

		ayudaRef
		.removeClass("text-muted text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");
		}
		}
		else {

		selectRef.prop("required", false);

		ayudaRef
		.removeClass("text-danger text-success fw-bold")
		.addClass("text-muted")
		.text("No aplica");
		}

		// ==============================
		// CAMBIO VISUAL MANO DE OBRA
		// ==============================

		selectMO.off("change").on("change", function () {

		if ($(this).val()) {

		ayudaMO
		.removeClass("text-danger")
		.addClass("text-success fw-bold")
		.text("Objeto seleccionado");
		}
		else if (costoMO > 0) {

		ayudaMO
		.removeClass("text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");
		}
		});

		// ==============================
		// CAMBIO VISUAL REFACCIONES
		// ==============================

		selectRef.off("change").on("change", function () {

		if ($(this).val()) {

		ayudaRef
		.removeClass("text-danger")
		.addClass("text-success fw-bold")
		.text("Objeto seleccionado");
		}
		else if (costoRef > 0) {

		ayudaRef
		.removeClass("text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");
		}
		});
		recalcularImporteCotizacion();
		},

		error: function () {

		Swal.fire({
		icon: 'error',
		title: 'Error',
		text: 'No fue posible obtener los costos.',
		confirmButtonColor: '#800705'
		});
		}
		});

		});   // ← cierre del function() del change


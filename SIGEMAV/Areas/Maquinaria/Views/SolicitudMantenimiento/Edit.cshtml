	<script>

		(() => {

		const input =
		document.getElementById("archivosInput");

		const errorDiv =
		document.getElementById("errorArchivos");

		if (!input) {
		return;
		}

		const maxArchivos = 5;

		const maxSize =
		2 * 1024 * 1024;

		const extensionesPermitidas = [
		".pdf",
		".jpg",
		".jpeg",
		".png"
		];

		input.addEventListener("change", function () {

		errorDiv.innerHTML = "";

		const archivos =
		Array.from(input.files);

		// ================================
		// VALIDAR CANTIDAD
		// ================================

		if (archivos.length > maxArchivos) {

		errorDiv.innerHTML =
		`Solo se permiten ${maxArchivos} archivos.`;

		input.value = "";

		return;
		}

		// ================================
		// VALIDAR ARCHIVOS
		// ================================

		for (const archivo of archivos) {

		if (archivo.size > maxSize) {

		errorDiv.innerHTML =
		`El archivo '${archivo.name}' excede 2 MB.`;

		input.value = "";

		return;
		}

		const extension =
		archivo.name
		.substring(
		archivo.name.lastIndexOf("."))
		.toLowerCase();

		if (!extensionesPermitidas.includes(extension)) {

		errorDiv.innerHTML =
		`El archivo '${archivo.name}' no tiene una extensión permitida.`;

		input.value = "";

		return;
		}

		if (archivo.name.length > 150) {

		errorDiv.innerHTML =
		`El nombre '${archivo.name}' es demasiado largo.`;

		input.value = "";

		return;
		}
		}

		});

		})();

	</script>


	<script>
		$(document).on(
		"change",
		".objetoGastoManoObra, .objetoGastoRefacciones",
		function () {

		if (serviciosBloqueados) {
		return false;
		}

		const fila =
		$(this).closest("tr");

		const partidaManoObra =
		fila.find(".objetoGastoManoObra").val();

		const partidaRefacciones =
		fila.find(".objetoGastoRefacciones").val();

		if (
		partidaManoObra &&
		partidaRefacciones &&
		partidaManoObra === partidaRefacciones
		) {

		Swal.fire({
		icon: 'warning',
		title: 'Partidas duplicadas',
		text: 'La partida de Mano de Obra y la de Refacciones no pueden ser la misma.',
		confirmButtonColor: '#800705'
		});

		$(this)
		.val('')
		.trigger('change');

		return;
		}
		});
	</script>



	<script>
		function recalcularImporteCotizacion() {

		let total = 0;

		

		$("#tablaServicios tbody tr").each(function () {

		const cantidad =
		parseFloat(
		$(this)
		.find('input[name$=".Cantidad"]')
		.val() || 0);

		const manoObra =
		parseFloat(
		$(this)
		.find(".costoManoObra")
		.val() || 0);

		const refacciones =
		parseFloat(
		$(this)
		.find(".costoRefacciones")
		.val() || 0);

		total += cantidad * (manoObra + refacciones);
		});

		total = Number(total.toFixed(2));

		const totalRedondeado = Math.round(total * 100) / 100;

		$("#ImporteCotizacionVisual")
		.val(formatoMoneda(totalRedondeado));

		$("#ImporteCotizacion")
		.val(totalRedondeado);
		}
	</script>


	<script>
		$(document).on(
		"input",
		'input[name$=".Cantidad"]',
		function () {

		recalcularImporteCotizacion();
		});
	</script>

	


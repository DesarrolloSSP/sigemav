@using SIGEMAV.Models.ViewModels.Maquinaria
@model SIGEMAV.Models.ViewModels.Maquinaria.SolicitudMantenimientoEditViewModel

@* @{
	ViewData["Title"] =
		"Editar Solicitud de Mantenimiento";
} *@

<div class="card shadow-sm border-0">

	<div class="card-header bg-white">

		<div class="d-flex justify-content-between align-items-center">

			<div>

				<h4 class="fw-bold mb-0">
					Editar solicitud de mantenimiento
				</h4>

				<small class="text-muted">
					Actualización de información de mantenimiento vehicular
				</small>

			</div>

			<div>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>
					Regresar

				</a>

			</div>

		</div>

	</div>

	<div class="card-body">


		@if (!ViewData.ModelState.IsValid)
		{
			<div class="alert alert-danger border-0 shadow-sm mb-4">

				<div class="d-flex align-items-start">

					<div class="me-3">
						<i class="bi bi-exclamation-circle-fill fs-4"></i>
					</div>

					<div>

						<div class="fw-bold mb-1">
							No fue posible guardar la solicitud
						</div>

						<div class="small">
							Revisa los siguientes campos:
						</div>

						<ul class="mb-0 mt-2 small">
							@foreach (var error in ViewData.ModelState.Values
								.SelectMany(v => v.Errors)
								.Where(e => !string.IsNullOrWhiteSpace(e.ErrorMessage)))
							{
								<li>@error.ErrorMessage</li>
							}
						</ul>

					</div>

				</div>

			</div>
		}

		<form asp-action="Edit" method="post" enctype="multipart/form-data" id="formEdit">

			@Html.AntiForgeryToken()

			<input asp-for="SolicitudMantenimientoId"
				   type="hidden" />

			<div class="row g-4">

                <!-- Folio -->
                <div class="col-md-4">
                    <label asp-for="Folio" class="form-label fw-semibold">
                        <i class="bi bi-hash me-1 text-secondary"></i>Folio
                    </label>
                    <input asp-for="Folio" class="form-control bg-light" disabled />
                    <input asp-for="Folio" type="hidden" />
                    <span asp-validation-for="Folio" class="text-danger small"></span>
                </div>

                <!-- Fecha de Registro -->
                <div class="col-md-4">
                    <label asp-for="FechaRegistro" class="form-label fw-semibold">
                        <i class="bi bi-calendar-check me-1 text-secondary"></i>Fecha de registro
                    </label>
                    <input asp-for="FechaRegistro" type="datetime-local" class="form-control bg-light" disabled />
                    <span asp-validation-for="FechaRegistro" class="text-danger small"></span>
                </div>

                <!-- Estatus -->
                <div class="col-md-4">
                    <label asp-for="EstatusSolicitudMantenimientoId" class="form-label fw-semibold">
                        <i class="bi bi-flag me-1 text-secondary"></i>Estatus
                    </label>
                    <select asp-for="EstatusSolicitudMantenimientoId" asp-items="Model.Estatuses" class="form-select bg-light" disabled>
                        <option value="">Seleccione estatus</option>
                    </select>
                    <!-- Necesario para el POST -->
                    <input asp-for="EstatusSolicitudMantenimientoId" type="hidden" />
                    <small class="text-muted d-block mt-1">Administrado por el flujo del sistema.</small>
                    <span asp-validation-for="EstatusSolicitudMantenimientoId" class="text-danger small"></span>
                </div>

                <!-- Fecha de Solicitud -->
                <div class="col-md-4">
                    <label asp-for="FechaSolicitud" class="form-label fw-semibold">
                        <i class="bi bi-calendar-event me-1 text-secondary"></i>Fecha de solicitud
                    </label>
                    <input asp-for="FechaSolicitud" type="datetime-local" class="form-control bg-light" readonly />
                    <span asp-validation-for="FechaSolicitud" class="text-danger small"></span>
                </div>

                <!-- Número de Oficio -->
                <div class="col-md-4">
                    <label asp-for="NumeroOficio" class="form-label fw-semibold campo-obligatorio">
                        <i class="bi bi-file-earmark-text me-1 text-secondary"></i>Número de oficio
                    </label>
                    @if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
                    {
                        <input asp-for="NumeroOficio" class="form-control bg-light" readonly />
                    }
                    else
                    {
                        <input asp-for="NumeroOficio" class="form-control" placeholder="Ej. OF/2026/001" required />
                    }
                    <span asp-validation-for="NumeroOficio" class="text-danger small"></span>
                </div>

                <!-- Unidad Vehicular -->
                <div class="col-md-4">
                    <label asp-for="UnidadVehicularId" class="form-label fw-semibold">
                        <i class="bi bi-truck me-1 text-secondary"></i>Unidad vehicular
                    </label>
                    <select asp-for="UnidadVehicularId" asp-items="Model.UnidadesVehiculares" class="form-select bg-light" disabled></select>
                    <input asp-for="UnidadVehicularId" type="hidden" />
                    <span asp-validation-for="UnidadVehicularId" class="text-danger small"></span>
                </div>

                <!-- Área Solicitante -->
                <div class="col-md-6">
                    <label asp-for="AreaSolicitanteId" class="form-label fw-semibold">
                        <i class="bi bi-building me-1 text-secondary"></i>Área solicitante
                    </label>
                    <select asp-for="AreaSolicitanteId" asp-items="Model.Areas" class="form-select bg-light" disabled>
                        <option value="">Seleccione área</option>
                    </select>
                    <input asp-for="AreaSolicitanteId" type="hidden" />
                    <small class="text-muted d-block mt-1">
                        <i class="bi bi-info-circle me-1"></i>Área obtenida de la plantilla vehicular.
                    </small>
                    <span asp-validation-for="AreaSolicitanteId" class="text-danger small"></span>
                </div>

                <!-- Tipo de Mantenimiento -->
                <div class="col-md-6">
                    <label asp-for="TipoMantenimientoId" class="form-label fw-semibold">
                        <i class="bi bi-tools me-1 text-secondary"></i>Tipo de mantenimiento
                    </label>
                    <select asp-for="TipoMantenimientoId" asp-items="Model.TiposMantenimiento" class="form-select bg-light" disabled>
                        <option value="">Seleccione tipo</option>
                    </select>
                    <input asp-for="TipoMantenimientoId" type="hidden" />
                    <span asp-validation-for="TipoMantenimientoId" class="text-danger small"></span>
                </div>

                <!-- Taller -->
                <div class="col-md-6">
                    <label asp-for="TallerId" class="form-label fw-semibold campo-obligatorio">
                        <i class="bi bi-wrench-gap me-1 text-secondary"></i>Taller
                    </label>
                    @if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
                    {
                        <select asp-for="TallerId" asp-items="Model.Talleres" class="form-select bg-light" id="TallerId" disabled>
                            <option value="">Seleccione taller</option>
                        </select>
                        <input type="hidden" asp-for="TallerId" />
                    }
                    else
                    {
                        <select asp-for="TallerId" asp-items="Model.Talleres" class="form-select" id="TallerId" required>
                            <option value="">Seleccione taller</option>
                        </select>
                    }
                    <span asp-validation-for="TallerId" class="text-danger small"></span>
                </div>

                <!-- Contrato / Configuración Presupuestal -->
                <div class="col-md-6">
                    <label asp-for="TallerConfiguracionPresupuestalId" class="form-label fw-semibold campo-obligatorio">
                        <i class="bi bi-file-earmark-spreadsheet me-1 text-secondary"></i>Contrato / Fuente de Recurso
                    </label>
                    @if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
                    {
                        <select asp-for="TallerConfiguracionPresupuestalId" asp-items="Model.ConfiguracionesTaller" class="form-select bg-light" id="TallerConfiguracionPresupuestalId" disabled>
                            <option value="">Seleccione contrato / recurso</option>
                        </select>
                        <input type="hidden" asp-for="TallerConfiguracionPresupuestalId" />
                    }
                    else
                    {
                        <select asp-for="TallerConfiguracionPresupuestalId" asp-items="Model.ConfiguracionesTaller" class="form-select" id="TallerConfiguracionPresupuestalId" required>
                            <option value="">Seleccione contrato / recurso</option>
                        </select>
                    }
                    <small id="mensajeConfiguracionTaller" class="text-muted d-block mt-1">
                        Seleccione un taller para cargar sus contratos vigentes.
                    </small>
                    <span asp-validation-for="TallerConfiguracionPresupuestalId" class="text-danger small"></span>
                </div>

                <!-- Kilometraje Actual -->
                <div class="col-md-4">
                    <label asp-for="KilometrajeActual" class="form-label fw-semibold campo-obligatorio">
                        <i class="bi bi-speedometer2 me-1 text-secondary"></i>Kilometraje actual
                    </label>
                    @if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
                    {
                        <input asp-for="KilometrajeActual" class="form-control bg-light" disabled />
                        <input asp-for="KilometrajeActual" type="hidden" />
                    }
                    else
                    {
                        <input asp-for="KilometrajeActual" class="form-control" maxlength="6" inputmode="numeric" autocomplete="off" placeholder="000000" required />
                    }
                    <small class="text-muted d-block mt-1">Capture la lectura actual del odómetro.</small>
                    <span asp-validation-for="KilometrajeActual" class="text-danger small"></span>
                </div>

                <!-- Estado del Odómetro -->
                <div class="col-md-4">
                    <label asp-for="EstadoOdometroId" class="form-label fw-semibold campo-obligatorio">
                        <i class="bi bi-exclamation-triangle me-1 text-secondary"></i>Estado del odómetro
                    </label>
                    @if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
                    {
                        <select asp-for="EstadoOdometroId" asp-items="Model.EstadosOdometro" class="form-select bg-light" disabled></select>
                        <input asp-for="EstadoOdometroId" type="hidden" />
                    }
                    else
                    {
                        <select asp-for="EstadoOdometroId" asp-items="Model.EstadosOdometro" class="form-select" required>
                            <option value="">Seleccione estado</option>
                        </select>
                    }
                    <small class="text-muted d-block mt-1">Indique la condición del odómetro.</small>
                    <span asp-validation-for="EstadoOdometroId" class="text-danger small"></span>
                </div>

                <!-- Importe Cotización -->
                <div class="col-md-4">
                    <label asp-for="ImporteCotizacion" class="form-label fw-semibold">
                        <i class="bi bi-currency-dollar me-1 text-secondary"></i>Importe cotización
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light">$</span>
                        <input id="ImporteCotizacionVisual" class="form-control text-end bg-light fw-bold" readonly value="0.00" />
                        <input asp-for="ImporteCotizacion" type="hidden" id="ImporteCotizacion" />
                    </div>
                    <small class="text-muted d-block mt-1">Calculado automáticamente desde servicios.</small>
                    <span asp-validation-for="ImporteCotizacion" class="text-danger small"></span>
                </div>

                <!-- Nota Informativa (Ancho completo) -->
                <div class="col-12 mt-3">
                    <div class="alert alert-info d-flex align-items-center mb-0 py-2 px-3 fs-7" role="alert">
                        <i class="bi bi-info-circle-fill me-2 fs-5 flex-shrink-0"></i>
                        <div>
                            Si el odómetro funciona correctamente capture el kilometraje. Si presenta alguna incidencia, seleccione el estado correspondiente.
                        </div>
                    </div>
                </div>

				<!-- Motivo -->
				@* <div class="col-md-12">

					<label asp-for="MotivoSolicitud"
						   class="form-label fw-semibold">

						Motivo de la solicitud

					</label>



					@if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
					{
						<textarea asp-for="MotivoSolicitud" rows="3" class="form-control" readonly></textarea>

						<span asp-validation-for="MotivoSolicitud"
							  class="text-danger">
						</span>
					}
					else
					{
						<textarea asp-for="MotivoSolicitud" rows="3" class="form-control"></textarea>

						<span asp-validation-for="MotivoSolicitud"
							  class="text-danger">
						</span>
					}

					

				</div> *@

				<!-- Diagnóstico -->
				@* 	<div class="col-md-6">

					<label asp-for="DiagnosticoInicial"
						   class="form-label fw-semibold">
						Diagnóstico inicial
					</label>
					@if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
					{
						<textarea asp-for="DiagnosticoInicial" rows="4" class="form-control" readonly></textarea>
					}
					else
					{
						<textarea asp-for="DiagnosticoInicial" rows="4" class="form-control"> </textarea>
					}
				</div> *@

				<!-- Observaciones -->
				<div class="col-md-12">

					<label asp-for="Observaciones"
						   class="form-label fw-semibold">

						Observaciones

					</label>


					
					@if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
					{
						<textarea asp-for="Observaciones" rows="4" class="form-control" readonly></textarea>
					}
					else
					{
						<textarea asp-for="Observaciones"
								  rows="4"
								  class="form-control">
							</textarea>
					}

				

				</div>

			</div>


			<br />

			<!-- DOCUMENTOS SOPORTE -->
			<div class="col-md-12">

				<div class="card border-0 shadow-sm">

					<div class="card-header bg-light">

						<div class="d-flex justify-content-between align-items-center">

							<h6 class="mb-0 fw-bold">
								Documentos soporte
							</h6>

							<span class="badge bg-secondary">
								@(Model.Documentos?.Count ?? 0)
								archivo(s)
							</span>

						</div>

					</div>

					<div class="card-body">

						<!-- DOCUMENTOS REGISTRADOS -->
						@if (Model.Documentos != null && Model.Documentos.Any())
						{
							<div class="table-responsive mb-4">

								<table class="table table-sm align-middle">

									<thead class="table-light">

										<tr>

											<th>
												Documento
											</th>

											<th>
												Tipo
											</th>

											<th>
												Fecha
											</th>

											<th class="text-center">
												Acción
											</th>

										</tr>

									</thead>

									<tbody>

										@foreach (var documento in Model.Documentos)
										{
											<tr>

												<td>
													<i class="bi bi-paperclip me-1"></i>
													@documento.NombreArchivo
												</td>

												<td>
													@documento.TipoDocumento
												</td>

												<td>
													@documento.FechaCarga.ToString("dd/MM/yyyy HH:mm")
												</td>

												<td class="text-center">

													<a asp-action="DescargarDocumento"
													   asp-route-id="@documento.SolicitudMantenimientoDocumentoId"
													   class="btn btn-sm btn-outline-primary">

														<i class="bi bi-download"></i>

													</a>

												</td>

											</tr>
										}

									</tbody>

								</table>

							</div>
						}
						else
						{
							<div class="alert alert-light border">

								<i class="bi bi-info-circle me-1"></i>

								No existen documentos cargados para esta solicitud.

							</div>
						}

						<!-- NUEVOS DOCUMENTOS -->

						<div class="border-top pt-3">

							<label class="form-label fw-semibold">
								Adjuntar documentos adicionales
							</label>


							@if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
							{

								<input asp-for="Archivos" type="file" class="form-control" id="archivosInput" multiple accept=".pdf,.jpg,.jpeg,.png" readonly />
							}
							else
							{
								<input asp-for="Archivos" type="file" class="form-control" id="archivosInput" multiple accept=".pdf,.jpg,.jpeg,.png" />
							}

								
							<small class="text-muted">
								Permitidos:
								PDF, JPG, JPEG y PNG.
								<br />
								Máximo:
								5 archivos de 2 MB c/u.
							</small>
							<div id="errorArchivos"
								 class="text-danger small mt-2">
							</div>

						</div>

					</div>
				</div>
			</div>





			<br />

			@if (Model.EstatusSolicitudMantenimientoId == 4)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-wrench fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud en proceso de validación técnica
							</h6>

							<p class="mb-1">

								La solicitud ya fue validada presupuestalmente y actualmente
								se encuentra en proceso de validación técnica.

							</p>

							<p class="mb-0">

								Los servicios, cantidades, costos y objetos de gasto
								han sido congelados para evitar inconsistencias durante
								la revisión técnica.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 5)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-check-circle-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud autorizada
							</h6>

							<p class="mb-1">

								La validación técnica fue autorizada y la
								cotización quedó formalmente aprobada.

							</p>

							<p class="mb-0">

								Los servicios mostrados corresponden a la versión
								autorizada de la solicitud y ya no pueden ser
								modificados.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 6)
			{
				<div class="alert alert-danger border-start border-4 border-danger mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud rechazada
							</h6>

							<p class="mb-1">

								La solicitud fue rechazada durante el proceso de revisión
								y requiere correcciones antes de continuar con su trámite.

							</p>

							<p class="mb-0">

								Puede modificar los servicios, cantidades, objetos de gasto y demás información necesaria para
								atender las observaciones realizadas y posteriormente
								reenviar la solicitud para una nueva revisión.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 7)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-tools fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Mantenimiento en ejecución
							</h6>

							<p class="mb-1">

								La unidad ya fue ingresada al taller y los trabajos de
								mantenimiento se encuentran en proceso.

							</p>

							<p class="mb-0">

								La cotización inicial se muestra únicamente como
								referencia histórica y no puede modificarse.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 8)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-clipboard-check-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Mantenimiento finalizado
							</h6>

							<p class="mb-1">

								El mantenimiento fue concluido y cerrado
								administrativamente.

							</p>

							<p class="mb-0">

								La información de la cotización se conserva únicamente
								para consulta y auditoría.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 9)
			{
				<div class="alert alert-danger border-start border-4 border-danger mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-x-circle-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud cancelada
							</h6>

							<p class="mb-1">

								Esta solicitud fue cancelada y ya no forma parte del
								flujo operativo de mantenimiento.

							</p>

							<p class="mb-0">

								Los servicios se muestran únicamente para fines de
								consulta histórica.

							</p>

						</div>

					</div>

				</div>
			}




			<!-- SERVICIOS -->
			<div class="col-md-12">

				<div class="card border-0 shadow-sm">

					<div class="card-header border-0 text-white"
						 style="background: linear-gradient(90deg, #800705 0%, #a10b08 100%);">

						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

							<div>

								<div class="d-flex align-items-center gap-2">

									<i class="bi bi-receipt-cutoff fs-4"></i>

									<h5 class="fw-bold mb-0">
										COTIZACIÓN INICIAL
										@* @if (Model.EstatusSolicitudMantenimientoId >= 3)
										{
											<span class="badge bg-warning text-dark">

												<i class="bi bi-lock-fill me-1"></i>
												Solo lectura

											</span>
										} *@
									</h5>

								</div>


								@if (Model.EstatusSolicitudMantenimientoId >= 3)
								{
									<small class="opacity-75">
										Servicios validados y bloqueados para edición.
									</small>

								}
								else
								{
									<small class="opacity-75">
										Seleccione los servicios y clasifique manualmente los objetos de gasto.
									</small>
								}





							</div>

							@if (Model.EstatusSolicitudMantenimientoId < 3)
							{
								<button type="button"
										id="btnAgregarServicio"
										class="btn btn-light btn-sm fw-semibold shadow-sm">

									<i class="bi bi-plus-circle me-1"></i>
									Agregar Servicio

								</button>
							}

						</div>

					</div>

					<div class="card-body bg-light-subtle">

						<div class="table-responsive">

							<table class="table table-bordered table-hover align-middle"
								   id="tablaServicios">

								<thead class="table-light">

									<tr>

										<th class="col-concepto">
											Concepto
										</th>

										<th class="col-cantidad text-center">
											Cantidad
										</th>

										<th class="col-manoobra text-end">
											$ Mano de obra
										</th>

										<th class="col-partida-mo">
											Partida
										</th>

										<th class="col-refacciones text-end">
											$ Refacciones
										</th>

										<th class="col-partida-ref">
											Partida
										</th>

										<th class="col-observaciones">
											Observaciones
										</th>

										<th class="col-acciones text-center">
										</th>

									</tr>

								</thead>

								<tbody>
								</tbody>

							</table>

						</div>

						<div class="mt-3">

							<div class="alert alert-light border mb-0">

								<div class="d-flex align-items-start">

									<i class="bi bi-info-circle-fill text-primary fs-5 me-2"></i>

									<div class="small">

										<strong>Importante:</strong>

										Un mismo servicio puede afectar diferentes objetos de gasto.

										<br />

										Ejemplo:
										<strong>Cambio de aceite</strong>
										puede afectar:

										<ul class="mb-0 mt-2">

											<li>
												Mano de obra →
												355001 Conservación y Mantenimiento
											</li>

											<li>
												Refacciones/Insumos →
												261001 Lubricantes y Aditivos
											</li>

										</ul>

									</div>

								</div>

							</div>

						</div>

						<div class="mt-2">

							<small class="text-muted">
								Los costos son calculados automáticamente desde la matriz oficial de mantenimiento.
							</small>

						</div>

					</div>

				</div>

			</div>



			<hr class="my-4" />

			<div class="d-flex justify-content-end gap-2">

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					Cancelar

				</a>


				@if (Model.EstatusSolicitudMantenimientoId >= 4 && Model.EstatusSolicitudMantenimientoId != 6)
				{
					<button type="button" class="btn btn-secondary" disabled>
						<i class="bi bi-lock-fill me-1"></i>
						Solo para consulta.
					</button>
				}
				else
				{
					<button type="submit"
							class="btn text-light"
							style="background-color:#800705">

						<i class="bi bi-save me-1"></i>
						Actualizar Cambios

					</button>
				}

				
			</div>

		</form>

	</div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- LIBRERÍAS EXTERNAS (CARGA ÚNICA) -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .campo-obligatorio::after {
            content: " *";
            color: red;
            font-weight: bold;
        }

        /* TABLA SERVICIOS */
        .table-servicios, #tablaServicios {
            table-layout: fixed;
            width: 100%;
        }

        .table-servicios td {
            vertical-align: top;
            padding-top: 8px;
            padding-bottom: 8px;
        }

        #tablaServicios .col-concepto { width: 28%; }
        #tablaServicios .col-cantidad { width: 6%; }
        #tablaServicios .col-manoobra { width: 10%; }
        #tablaServicios .col-partida-mo { width: 15%; }
        #tablaServicios .col-refacciones { width: 10%; }
        #tablaServicios .col-partida-ref { width: 15%; }
        #tablaServicios .col-observaciones { width: 12%; }
        #tablaServicios .col-acciones { width: 4%; }

        /* SELECT2 */
        .select2-container {
            width: 100% !important;
        }

        .columnaConceptoServicio { min-width: 350px; }
        .contenedorConceptoServicio { min-width: 320px; }

        .select2-container--default .select2-selection--single {
            height: auto !important;
            min-height: 38px;
            display: flex;
            align-items: flex-start;
            padding-top: 4px;
            padding-bottom: 4px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            white-space: normal !important;
            word-break: break-word;
            overflow: visible !important;
            text-overflow: unset !important;
            line-height: 1.3rem;
            padding-right: 28px;
            padding-top: 2px;
            padding-bottom: 2px;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 100%;
            top: 0;
            right: 4px;
        }

        .select2-results__option {
            white-space: normal !important;
            word-break: break-word;
            line-height: 1.3rem;
            padding-top: 8px;
            padding-bottom: 8px;
        }
    </style>

    <script>
        const serviciosExistentes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Servicios ?? new List<SIGEMAV.Models.ViewModels.Maquinaria.SolicitudMantenimientoServicioViewModel>()));
        let reconstruyendoServicios = false;
    </script>

    <!-- SCRIPT 01 — ESTADO Y BLOQUEO DE SERVICIOS -->
    <script>
        const estatusSolicitud = parseInt($("#EstatusSolicitudMantenimientoId").val() || 0);
        // Bloqueados: Validada (4), Autorizada (5), En proceso (7), Finalizada (8), Cancelada (9)
        const serviciosBloqueados = [4, 5, 7, 8, 9].includes(estatusSolicitud);
    </script>

    <!-- SCRIPT 02 — FORMATO DE MONEDA -->
    <script>
        function formatoMoneda(valor) {
            const numero = parseFloat(valor || 0);
            return numero.toLocaleString("es-MX", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }
    </script>

    <!-- SCRIPT PRESUPUESTAL — INICIALIZAR EVENTOS DE TALLER Y CONTRATOS -->
    <script>
        $(function () {
            inicializarEventosTaller();
        });

        function inicializarEventosTaller() {
            const $taller =$("#TallerId");
            const $configSelect =$("#TallerConfiguracionPresupuestalId");
            const $mensaje =$("#mensajeConfiguracionTaller");

            $taller.on("change", function () {
                if (serviciosBloqueados) return;

                const tallerId = $(this).val();
                const valorActualConfig = $configSelect.val();

                $configSelect.empty().append('<option value="">Seleccione contrato / recurso</option>');

                if (!tallerId) {
                    $configSelect.prop("disabled", true);
                    if ($mensaje.length) {$mensaje.removeClass("text-danger text-success").addClass("text-muted")
                                .text("Seleccione un taller para cargar sus contratos vigentes.");
                    }
                    return;
                }

                $.get("@Url.Action("ObtenerConfiguracionesPorTaller", "SolicitudMantenimiento", new { area = "Maquinaria" })", { tallerId: tallerId })
                    .done(function (data) {
                        if (!data || data.length === 0) {
                            $configSelect.prop("disabled", true);
                            if ($mensaje.length) {$mensaje.removeClass("text-muted text-success").addClass("text-danger")
                                        .text("El taller seleccionado no cuenta con una configuración presupuestal activa.");
                            }

                            Swal.fire({
                                icon: "warning",
                                title: "Sin Contrato Activo",
                                text: "El taller seleccionado no cuenta con contratos presupuestales activos registrados.",
                                confirmButtonColor: "#800705"
                            });
                            return;
                        }

                        $.each(data, function (index, item) {
                            $configSelect.append(new Option(item.text, item.value));
                        });

                        $configSelect.prop("disabled", false);

                        if (valorActualConfig && $configSelect.find(`option[value="${valorActualConfig}"]`).length > 0) {
                            $configSelect.val(valorActualConfig);
                        } else if (data.length === 1) {
                            $configSelect.val(data[0].value).trigger("change");
                            if ($mensaje.length) {$mensaje.removeClass("text-muted text-danger").addClass("text-success")
                                        .text("Contrato seleccionado automáticamente.");
                            }
                        } else {
                            if ($mensaje.length) {$mensaje.removeClass("text-muted text-danger").addClass("text-muted")
                                        .text("Seleccione la fuente de recurso o contrato aplicable.");
                            }
                        }
                    })
                    .fail(function () {
                        $configSelect.prop("disabled", true);
                        if ($mensaje.length) {$mensaje.removeClass("text-muted text-success").addClass("text-danger")
                                    .text("Error al consultar los contratos del taller.");
                        }

                        Swal.fire({
                            icon: "error",
                            title: "Error",
                            text: "No fue posible obtener los contratos presupuestales del taller.",
                            confirmButtonColor: "#800705"
                        });
                    });
            });
        }
    </script>

    <!-- SCRIPT 03 — RECONSTRUIR SERVICIOS EXISTENTES -->
    <script>
        $(document).ready(function () {
            if (serviciosBloqueados) {
                $("#btnAgregarServicio").hide();
            } else {
                $("#btnAgregarServicio").show();
            }

            if (typeof serviciosExistentes === "undefined" || !Array.isArray(serviciosExistentes)) {
                return;
            }

            $("#tablaServicios tbody").empty();

            if (serviciosExistentes.length === 0) {
                recalcularImporteCotizacion();
                return;
            }

            reconstruyendoServicios = true;

            serviciosExistentes.forEach(function (detalle) {
                agregarFilaServicio(detalle, false);
            });

            reconstruyendoServicios = false;

            recalcularImporteCotizacion();

            if (typeof validarVisualmenteServicios === "function") {
                validarVisualmenteServicios();
            }
        });
    </script>

    <!-- SCRIPT 04 — VALIDACIÓN VISUAL DE SERVICIOS -->
    <script>
        function validarVisualmenteServicios() {
            $("#tablaServicios tbody tr").each(function () {
                const fila = $(this);

                const costoMO = parseFloat(fila.find(".costoManoObra").val() || 0);
                const costoRef = parseFloat(fila.find(".costoRefacciones").val() || 0);

                const selectMO = fila.find(".objetoGastoManoObra");
                const selectRef = fila.find(".objetoGastoRefacciones");

                const ayudaMO = selectMO.closest("td").find("small");
                const ayudaRef = selectRef.closest("td").find("small");

                // MANO DE OBRA
                if (costoMO > 0) {
                    if (!serviciosBloqueados) {
                        selectMO.prop("required", true);
                    }

                    if (selectMO.val()) {
                        ayudaMO.removeClass("text-muted text-danger").addClass("text-success fw-bold").text("Objeto seleccionado");
                    } else {
                        ayudaMO.removeClass("text-muted text-success").addClass("text-danger fw-bold").text("Requerido");
                    }
                } else {
                    selectMO.prop("required", false);
                    ayudaMO.removeClass("text-danger text-success fw-bold").addClass("text-muted").text("No aplica");
                }

                // REFACCIONES
                if (costoRef > 0) {
                    if (!serviciosBloqueados) {
                        selectRef.prop("required", true);
                    }

                    if (selectRef.val()) {
                        ayudaRef.removeClass("text-muted text-danger").addClass("text-success fw-bold").text("Objeto seleccionado");
                    } else {
                        ayudaRef.removeClass("text-muted text-success").addClass("text-danger fw-bold").text("Requerido");
                    }
                } else {
                    selectRef.prop("required", false);
                    ayudaRef.removeClass("text-danger text-success fw-bold").addClass("text-muted").text("No aplica");
                }
            });
        }
    </script>

    <!-- SCRIPT 05 & 06 — CAMBIO OBJETO DE GASTO: MANO DE OBRA Y REFACCIONES -->
    <script>
        $(document).on("change", ".objetoGastoManoObra", function () {
            const select = $(this);
            const fila = select.closest("tr");
            const ayuda = select.closest("td").find("small");
            const costo = parseFloat(fila.find(".costoManoObra").val() || 0);

            if (costo <= 0) {
                select.prop("required", false);
                ayuda.removeClass("text-danger text-success fw-bold").addClass("text-muted").text("No aplica");
                return;
            }

            if (select.val()) {
                ayuda.removeClass("text-danger").addClass("text-success fw-bold").text("Objeto seleccionado");
            } else {
                ayuda.removeClass("text-success").addClass("text-danger fw-bold").text("Requerido");
            }
        });

        $(document).on("change", ".objetoGastoRefacciones", function () {
            const select = $(this);
            const fila = select.closest("tr");
            const ayuda = select.closest("td").find("small");
            const costo = parseFloat(fila.find(".costoRefacciones").val() || 0);

            if (costo <= 0) {
                select.prop("required", false);
                ayuda.removeClass("text-danger text-success fw-bold").addClass("text-muted").text("No aplica");
                return;
            }

            if (select.val()) {
                ayuda.removeClass("text-danger").addClass("text-success fw-bold").text("Objeto seleccionado");
            } else {
                ayuda.removeClass("text-success").addClass("text-danger fw-bold").text("Requerido");
            }
        });
    </script>

    <!-- SCRIPT 07 — AGREGAR SERVICIO Y CATÁLOGOS -->
    <script>
        $(document).on("click", "#btnAgregarServicio", function () {
            if (serviciosBloqueados) {
                Swal.fire({
                    icon: "info",
                    title: "Solicitud procesada",
                    text: "Los servicios ya no pueden modificarse.",
                    confirmButtonColor: "#800705"
                });
                return;
            }

            agregarFilaServicio(null, true);
        });

        function obtenerOpcionesConceptos(valorSeleccionado = null) {
            let opciones = `<option value="">Seleccione un servicio</option>`;
            @foreach (var concepto in Model.ConceptosServicio)
            {
                <text>
                    {
                        const valor = "@concepto.Value";
                        const seleccionado = String(valor) === String(valorSeleccionado) ? " selected" : "";
                        opciones += `<option value="${valor}"${seleccionado}>@Html.Raw(concepto.Text)</option>`;
                    }
                </text>
            }
            return opciones;
        }

        function obtenerOpcionesObjetoGasto(valorSeleccionado = null) {
            let opciones = `<option value="">No aplica</option>`;
            @foreach (var objeto in Model.ObjetosGasto)
            {
                <text>
                    {
                        const valor = "@objeto.Value";
                        const seleccionado = String(valor) === String(valorSeleccionado) ? " selected" : "";
                        opciones += `<option value="${valor}"${seleccionado}>@Html.Raw(objeto.Text)</option>`;
                    }
                </text>
            }
            return opciones;
        }

        function agregarFilaServicio(detalle = null, esNuevo = false) {
            const index = $("#tablaServicios tbody tr").length;
            const conceptoId = detalle?.ConceptoServicioId ?? "";
            const cantidad = detalle?.Cantidad ?? 1;
            const costoMO = detalle?.CostoEstimadoManoObra ?? 0;
            const costoRef = detalle?.CostoEstimadoRefacciones ?? 0;
            const objetoMO = detalle?.IdObjetoGastoManoObra ?? "";
            const objetoRef = detalle?.IdObjetoGastoRefacciones ?? "";
            const obs = detalle?.Observaciones ?? "";

            const dis = serviciosBloqueados ? "disabled" : "";

            $("#tablaServicios tbody").append(`
                <tr>
                    <td class="col-concepto">
                        <select class="form-select conceptoServicio" ${dis}>
                            ${obtenerOpcionesConceptos(conceptoId)}
                        </select>
                        <input type="hidden" class="conceptoHidden" value="${conceptoId}" />
                    </td>
                    <td class="col-cantidad">
                        <input type="number" class="form-control cantidadServicio text-center" value="${cantidad}" min="1" step="1" ${dis} required />
                    </td>
                    <td class="col-manoobra">
                        <input type="text" class="form-control costoManoObraVisual text-end bg-light" value="${formatoMoneda(costoMO)}" readonly />
                        <input type="hidden" class="costoManoObra" value="${costoMO}" />
                    </td>
                    <td class="col-partida-mo">
                        <select class="form-select objetoGastoManoObra" ${dis}>
                            ${obtenerOpcionesObjetoGasto(objetoMO)}
                        </select>
                        <input type="hidden" class="objetoGastoManoObraHidden" value="${objetoMO}" />
                        <small class="text-muted d-block mt-1">No aplica</small>
                    </td>
                    <td class="col-refacciones">
                        <input type="text" class="form-control costoRefaccionesVisual text-end bg-light" value="${formatoMoneda(costoRef)}" readonly />
                        <input type="hidden" class="costoRefacciones" value="${costoRef}" />
                    </td>
                    <td class="col-partida-ref">
                        <select class="form-select objetoGastoRefacciones" ${dis}>
                            ${obtenerOpcionesObjetoGasto(objetoRef)}
                        </select>
                        <input type="hidden" class="objetoGastoRefaccionesHidden" value="${objetoRef}" />
                        <small class="text-muted d-block mt-1">No aplica</small>
                    </td>
                    <td class="col-observaciones">
                        <textarea class="form-control observacionesServicio" ${dis}>${obs}</textarea>
                    </td>
                    <td class="col-acciones text-center">
                        <button type="button" class="btn btn-danger btn-sm btnEliminarServicio" ${dis}>
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            `);

            const fila = $("#tablaServicios tbody tr:last");

            if ($.fn.select2) {
                fila.find(".conceptoServicio, .objetoGastoManoObra, .objetoGastoRefacciones").select2({
                    placeholder: "Seleccione...",
                    allowClear: true,
                    width: "100%",
                    dropdownParent: $("#tablaServicios")
                });
            }

            actualizarConceptosDisponibles();
            normalizarIndicesServicios();
            recalcularImporteCotizacion();
        }
    </script>

    <!-- SCRIPT 09 — GESTIÓN DE SERVICIOS Y SUBMIT -->
    <script>
        $(document).on("click", ".btnEliminarServicio", function () {
            if (serviciosBloqueados) {
                Swal.fire({
                    icon: "info",
                    title: "Solicitud procesada",
                    text: "Los servicios ya no pueden modificarse.",
                    confirmButtonColor: "#800705"
                });
                return;
            }

            $(this).closest("tr").remove();

            if (typeof actualizarConceptosDisponibles === "function") actualizarConceptosDisponibles();
            normalizarIndicesServicios();
            if (typeof recalcularImporteCotizacion === "function") recalcularImporteCotizacion();
        });

        $(document).on("change", ".conceptoServicio", function () {
            const selectActual = $(this);
            const fila = selectActual.closest("tr");

            if (serviciosBloqueados || (typeof reconstruyendoServicios !== "undefined" && reconstruyendoServicios)) return;

            const conceptoServicioId = selectActual.val();
            if (!conceptoServicioId) return;

            let repetido = false;
            $(".conceptoServicio").not(this).each(function () {
                if (String($(this).val()) === String(conceptoServicioId)) {
                    repetido = true;
                    return false;
                }
            });

            if (repetido) {
                Swal.fire({
                    icon: "warning",
                    title: "Concepto duplicado",
                    text: "El concepto ya fue agregado.",
                    confirmButtonColor: "#800705"
                });
                selectActual.val(null).trigger("change");
                return;
            }

            if (typeof actualizarConceptosDisponibles === "function") actualizarConceptosDisponibles();

            const unidadVehicularId = $("#UnidadVehicularId").val();
            if (!unidadVehicularId) return;

            $.ajax({
                url: "/Maquinaria/SolicitudMantenimiento/ObtenerCostoConceptoCreate",
                type: "GET",
                data: { unidadVehicularId: unidadVehicularId, conceptoServicioId: conceptoServicioId },
                success: function (data) {
                    const costoMO = parseFloat(data.costoManoObra || 0);
                    const costoRef = parseFloat(data.costoRefacciones || 0);

                    const selectMO = fila.find(".objetoGastoManoObra");
                    const selectRef = fila.find(".objetoGastoRefacciones");
                    const ayudaMO = selectMO.closest("td").find("small");
                    const ayudaRef = selectRef.closest("td").find("small");

                    fila.find(".costoManoObra").val(costoMO);
                    if (fila.find(".costoManoObraVisual").length) fila.find(".costoManoObraVisual").val(formatoMoneda(costoMO));

                    fila.find(".costoRefacciones").val(costoRef);
                    if (fila.find(".costoRefaccionesVisual").length) fila.find(".costoRefaccionesVisual").val(formatoMoneda(costoRef));

                    if (costoMO > 0) {
                        selectMO.prop("required", true);
                        ayudaMO.removeClass("text-muted text-danger").addClass("text-success fw-bold").text(selectMO.val() ? "Objeto seleccionado" : "Requerido");
                    } else {
                        selectMO.prop("required", false);
                        ayudaMO.removeClass("text-danger text-success fw-bold").addClass("text-muted").text("No aplica");
                    }

                    if (costoRef > 0) {
                        selectRef.prop("required", true);
                        ayudaRef.removeClass("text-muted text-danger").addClass("text-success fw-bold").text(selectRef.val() ? "Objeto seleccionado" : "Requerido");
                    } else {
                        selectRef.prop("required", false);
                        ayudaRef.removeClass("text-danger text-success fw-bold").addClass("text-muted").text("No aplica");
                    }

                    if (typeof recalcularImporteCotizacion === "function") recalcularImporteCotizacion();
                },
                error: function () {
                    Swal.fire({
                        icon: "error",
                        title: "Error",
                        text: "No fue posible obtener los costos.",
                        confirmButtonColor: "#800705"
                    });
                }
            });
        });

        function normalizarIndicesServicios() {
            $("#tablaServicios tbody tr").each(function (index) {
                const fila = $(this);

                const concepto = fila.find(".conceptoServicio");
                const conceptoHidden = fila.find(".conceptoHidden");
                concepto.attr("name", `Servicios[${index}].ConceptoServicioId`);
                conceptoHidden.attr("name", `Servicios[${index}].ConceptoServicioId`).val(concepto.val() || "");

                fila.find(".cantidadServicio").attr("name", `Servicios[${index}].Cantidad`);
                fila.find(".costoManoObra").attr("name", `Servicios[${index}].CostoEstimadoManoObra`);

                const objetoMO = fila.find(".objetoGastoManoObra");
                const objetoMOHidden = fila.find(".objetoGastoManoObraHidden");
                objetoMO.attr("name", `Servicios[${index}].IdObjetoGastoManoObra`);
                objetoMOHidden.attr("name", `Servicios[${index}].IdObjetoGastoManoObra`).val(objetoMO.val() || "");

                fila.find(".costoRefacciones").attr("name", `Servicios[${index}].CostoEstimadoRefacciones`);

                const objetoRef = fila.find(".objetoGastoRefacciones");
                const objetoRefHidden = fila.find(".objetoGastoRefaccionesHidden");
                objetoRef.attr("name", `Servicios[${index}].IdObjetoGastoRefacciones`);
                objetoRefHidden.attr("name", `Servicios[${index}].IdObjetoGastoRefacciones`).val(objetoRef.val() || "");

                fila.find(".observacionesServicio").attr("name", `Servicios[${index}].Observaciones`);
            });
        }

        $("#formEdit").on("submit", async function (e) {
            e.preventDefault();
            const formulario = this;

            normalizarIndicesServicios();

            if (!formulario.checkValidity()) {
                formulario.reportValidity();
                return;
            }

            if (serviciosBloqueados) {
                formulario.submit();
                return;
            }

            const unidadVehicularId = $("#UnidadVehicularId").val();
            const tipoMantenimientoId = $("#TipoMantenimientoId").val();
            const solicitudExcluirId = $("#SolicitudMantenimientoId").val();
            const conceptos = [];

            $("#tablaServicios tbody tr").each(function () {
                const concepto = $(this).find(".conceptoServicio").val();
                if (concepto) conceptos.push(parseInt(concepto));
            });

            if (conceptos.length === 0) {
                Swal.fire({
                    icon: "warning",
                    title: "Servicios requeridos",
                    text: "Debe capturar al menos un servicio.",
                    confirmButtonColor: "#800705"
                });
                return;
            }

            try {
                const response = await $.ajax({
                    url: "/Maquinaria/SolicitudMantenimiento/ValidarServiciosEdit",
                    type: "POST",
                    traditional: true,
                    data: {
                        solicitudExcluirId: solicitudExcluirId,
                        unidadVehicularId: unidadVehicularId,
                        conceptos: conceptos,
                        tipoMantenimientoId: tipoMantenimientoId
                    }
                });

                if (response && response.tieneRecurrencia) {
                    const continuar = await Swal.fire({
                        icon: "warning",
                        title: "Servicio recurrente",
                        html: (response.mensajes || []).join("") + "<br><br>¿Desea continuar?",
                        showCancelButton: true,
                        confirmButtonText: "Continuar",
                        cancelButtonText: "Cancelar",
                        confirmButtonColor: "#800705"
                    });

                    if (!continuar.isConfirmed) return;
                }

                formulario.submit();
            } catch (error) {
                Swal.fire({
                    icon: "error",
                    title: "Error de validación",
                    text: "No fue posible validar los servicios antes de guardar la solicitud.",
                    confirmButtonColor: "#800705"
                });
            }
        });
    </script>

    <!-- SCRIPT 10 — VALIDACIÓN DE ARCHIVOS -->
    <script>
        (() => {
            const input = document.getElementById("archivosInput");
            const errorDiv = document.getElementById("errorArchivos");

            if (!input || !errorDiv) return;

            const maxArchivos = 5;
            const maxSize = 2 * 1024 * 1024;
            const extensionesPermitidas = [".pdf", ".jpg", ".jpeg", ".png"];

            input.addEventListener("change", function () {
                errorDiv.innerHTML = "";
                const archivos = Array.from(this.files ?? []);

                if (archivos.length > maxArchivos) {
                    errorDiv.innerHTML = `Solo se permiten ${maxArchivos} archivos.`;
                    this.value = "";
                    return;
                }

                for (const archivo of archivos) {
                    if (archivo.size > maxSize) {
                        errorDiv.innerHTML = `El archivo '${archivo.name}' excede 2 MB.`;
                        this.value = "";
                        return;
                    }

                    const extension = archivo.name.substring(archivo.name.lastIndexOf(".")).toLowerCase();

                    if (!extensionesPermitidas.includes(extension)) {
                        errorDiv.innerHTML = `El archivo '${archivo.name}' no tiene una extensión permitida.`;
                        this.value = "";
                        return;
                    }

                    if (archivo.name.length > 150) {
                        errorDiv.innerHTML = `El nombre '${archivo.name}' es demasiado largo.`;
                        this.value = "";
                        return;
                    }
                }
            });
        })();
    </script>

    <!-- SCRIPT 11 — VALIDAR PARTIDAS DE OBJETO DE GASTO -->
    <script>
        $(document).on("change", ".objetoGastoManoObra, .objetoGastoRefacciones", function () {
            if (serviciosBloqueados) return;

            const fila = $(this).closest("tr");
            const partidaManoObra = fila.find(".objetoGastoManoObra").val();
            const partidaRefacciones = fila.find(".objetoGastoRefacciones").val();

            if (!partidaManoObra || !partidaRefacciones) return;

            if (String(partidaManoObra) === String(partidaRefacciones)) {
                Swal.fire({
                    icon: "warning",
                    title: "Partidas duplicadas",
                    text: "La partida de Mano de Obra y la de Refacciones no pueden ser la misma.",
                    confirmButtonColor: "#800705"
                });

                $(this).val("").trigger("change");
            }
        });
    </script>

    <!-- SCRIPT 12 — RECALCULAR IMPORTE DE COTIZACIÓN -->
    <script>
        function recalcularImporteCotizacion() {
            let total = 0;

            $("#tablaServicios tbody tr").each(function () {
                const fila = $(this);
                const cantidad = parseFloat(fila.find(".cantidadServicio").val() || 0);
                const manoObra = parseFloat(fila.find(".costoManoObra").val() || 0);
                const refacciones = parseFloat(fila.find(".costoRefacciones").val() || 0);

                total += cantidad * (manoObra + refacciones);
            });

            total = Number(total.toFixed(2));
            const totalRedondeado = Math.round(total * 100) / 100;

            $("#ImporteCotizacionVisual").val(formatoMoneda(totalRedondeado));
            $("#ImporteCotizacion").val(totalRedondeado);
        }

        $(document).on("input change", '.cantidadServicio, input[name$=".Cantidad"]', function () {
            if (typeof recalcularImporteCotizacion === "function") {
                recalcularImporteCotizacion();
            }
        });
    </script>

    <!-- SCRIPT 13 — ACTUALIZAR CONCEPTOS DISPONIBLES -->
    <script>
        function actualizarConceptosDisponibles() {
            const seleccionados = $(".conceptoServicio")
                .map(function () { return $(this).val(); })
                .get()
                .filter(x => x);

            $(".conceptoServicio").each(function () {
                const $select =$(this);
                const valorActual = $select.val();

                $select.find("option").each(function () {
                    const valor = $(this).val();
                    if (!valor) return;

                    if (seleccionados.includes(valor) && valor !== valorActual) {
                        $(this).prop("disabled", true);
                    } else {
                        $(this).prop("disabled", false);
                    }
                });

                if ($.fn.select2 && $select.hasClass("select2-hidden-accessible")) {
                    $select.trigger("change.select2");
                }
            });
        }
    </script>

    <!-- SCRIPT 14 — VALIDAR KILOMETRAJE ACTUAL -->
    <script>
        $(document).on("input", "#KilometrajeActual", function () {
            let valor = $(this).val().replace(/\D/g, "").substring(0, 6);
            $(this).val(valor);
        });
    </script>

    <!-- SCRIPT 15 — TEXTOS DE CATÁLOGOS -->
    <script>
        function obtenerTextoConcepto(valor) {
            if (!valor) return "";
            const opcion = $(`#tablaServicios option[value="${valor}"]`).first();
            if (opcion.length) return opcion.text().trim();

            const conceptos = [
                @foreach (var concepto in Model.ConceptosServicio)
                {
                    <text>
                        { value: "@concepto.Value", text: "@Html.Raw(concepto.Text.Replace("\\", "\\\\").Replace("\"", "\\\""))" },
                    </text>
                }
            ];

            const encontrado = conceptos.find(x => String(x.value) === String(valor));
            return encontrado ? encontrado.text : "Servicio no disponible";
        }

        function obtenerTextoObjetoGasto(valor) {
            if (!valor) return "No aplica";

            const objetos = [
                @foreach (var objeto in Model.ObjetosGasto)
                {
                    <text>
                        { value: "@objeto.Value", text: "@Html.Raw(objeto.Text.Replace("\\", "\\\\").Replace("\"", "\\\""))" },
                    </text>
                }
            ];

            const encontrado = objetos.find(x => String(x.value) === String(valor));
            return encontrado ? encontrado.text : "No aplica";
        }
    </script>
}


@using SIGEMAV.Models.ViewModels.Maquinaria
@model SIGEMAV.Models.ViewModels.Maquinaria.SolicitudMantenimientoEditViewModel

@{
	ViewData["Title"] =
		"Editar Solicitud de Mantenimiento";
}

<div class="card shadow-sm border-0">

	<div class="card-header bg-white">

		<div class="d-flex justify-content-between align-items-center">

			<div>

				<h4 class="fw-bold mb-0">
					Editar solicitud de mantenimiento
				</h4>

				<small class="text-muted">
					Actualización de información de mantenimiento vehicular
				</small>

			</div>

			<div>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>
					Regresar

				</a>

			</div>

		</div>

	</div>

	<div class="card-body">
		

		<form asp-action="Edit" method="post" enctype="multipart/form-data" id="formEdit">

			<div asp-validation-summary="All" class="text-danger"></div>

			@Html.AntiForgeryToken()

			<input asp-for="SolicitudMantenimientoId"
				   type="hidden" />

		@* 	<div asp-validation-summary="ModelOnly"
				 class="alert alert-danger">
			</div> *@

			<div class="row g-4">

				<!-- Folio -->
				<div class="col-md-6">

					<label asp-for="Folio"
						   class="form-label fw-semibold">

						Folio

					</label>
					<input asp-for="Folio" class="form-control" disabled />
					<input asp-for="Folio" type="hidden" />

					<span asp-validation-for="Folio"
						  class="text-danger">
					</span>

				</div>


				<!-- Fecha Registro-->
				<div class="col-md-6">

					<label asp-for="FechaRegistro"
						   class="form-label fw-semibold">

						Fecha de registro

					</label>

					<input asp-for="FechaRegistro"
						   type="datetime-local"
						   class="form-control" disabled />

					<span asp-validation-for="FechaRegistro"
						  class="text-danger">
					</span>

				</div>



				<!-- Fecha -->
				<div class="col-md-4">

					<label asp-for="FechaSolicitud"
						   class="form-label fw-semibold">

						Fecha de solicitud

					</label>

					<input asp-for="FechaSolicitud"
						   type="datetime-local"
						   class="form-control"
						   readonly />

				</div>


				<!-- Oficio -->
				<div class="col-md-4">

					<label asp-for="NumeroOficio"
						   class="form-label fw-semibold">

						Número de oficio

					</label>

					<input asp-for="NumeroOficio"
						   class="form-control" />

					<span asp-validation-for="NumeroOficio"
						  class="text-danger">
					</span>

				</div>

              

				<!-- Estatus -->
				<div class="col-md-4">

					<label asp-for="EstatusSolicitudMantenimientoId"
						   class="form-label fw-semibold">

						Estatus

					</label>

					<select asp-for="EstatusSolicitudMantenimientoId"
							asp-items="Model.Estatuses"
							class="form-select"
							disabled>

						<option value="">
							Seleccione estatus
						</option>

					</select>

					<!-- IMPORTANTE:disabled no envía valor al POST -->

					<input asp-for="EstatusSolicitudMantenimientoId"
						   type="hidden" />

					<small class="text-muted">
						El estatus se administra mediante el flujo operativo del sistema.
					</small>

				</div>

            

				<!-- Unidad -->
				<div class="col-md-4">
					<label asp-for="UnidadVehicularId" class="form-label fw-semibold"> Unidad vehicular</label>
					<select asp-for="UnidadVehicularId"
							asp-items="Model.UnidadesVehiculares"
							class="form-select"
							disabled>
					</select>

					<input asp-for="UnidadVehicularId"
						   type="hidden" />
					<span asp-validation-for="UnidadVehicularId"
						  class="text-danger">
					</span>
				</div>



				<!-- Tipo -->
				<div class="col-md-4">

					<label asp-for="TipoMantenimientoId"
						   class="form-label fw-semibold">

						Tipo de mantenimiento

					</label>

					<select asp-for="TipoMantenimientoId"
							asp-items="Model.TiposMantenimiento"
							class="form-select" disabled>
						<option value="">
							Seleccione tipo
						</option>

					</select>

					<input asp-for="TipoMantenimientoId" type="hidden" />


					<span asp-validation-for="TipoMantenimientoId"
						  class="text-danger">
					</span>

				</div>


				<!-- Kilometraje -->
				<div class="col-md-4">

					<label asp-for="KilometrajeActual"
						   class="form-label fw-semibold">

						Kilometraje actual

					</label>

					<input asp-for="KilometrajeActual"
						   class="form-control" />

					<span asp-validation-for="KilometrajeActual"
						  class="text-danger">
					</span>

				</div>




				<!-- Taller -->
				<div class="col-md-4">

					<label asp-for="TallerId"
						   class="form-label fw-semibold">

						Taller

					</label>

					<select asp-for="TallerId"
							asp-items="Model.Talleres"
							class="form-select">

						<option value="">
							Seleccione taller
						</option>

					</select>

					<span asp-validation-for="TallerId"
						  class="text-danger">
					</span>

				</div>

             
				<!-- Cotización -->
				<div class="col-md-4">

					<label asp-for="ImporteCotizacion"
						   class="form-label fw-semibold">

						Importe cotización

					</label>

					<input asp-for="ImporteCotizacion" class="form-control" readonly />

					<span asp-validation-for="ImporteCotizacion"
						  class="text-danger">
					</span>

					<small class="text-muted">
						Calculado automáticamente a partir de los servicios.
					</small>

				</div>



				<!-- Área -->
				<div class="col-md-4">

					<label asp-for="AreaSolicitanteId"
						   class="form-label fw-semibold">

						Área solicitante

					</label>

					<select asp-for="AreaSolicitanteId"
							asp-items="Model.Areas"
							class="form-select" disabled>

						<option value="">
							Seleccione área
						</option>

					</select>




					<input asp-for="AreaSolicitanteId" type="hidden" />

					<span asp-validation-for="AreaSolicitanteId"
						  class="text-danger">
					</span>


					<small class="text-muted">
						Área obtenida de la plantilla vehicular.
					</small>


				</div>


				<!-- Motivo -->
				<div class="col-md-12">

					<label asp-for="MotivoSolicitud"
						   class="form-label fw-semibold">

						Motivo de la solicitud

					</label>

					<textarea asp-for="MotivoSolicitud"
							  rows="3"
							  class="form-control">
                    </textarea>

					<span asp-validation-for="MotivoSolicitud"
						  class="text-danger">
					</span>

				</div>

				<!-- Diagnóstico -->
				<div class="col-md-6">

					<label asp-for="DiagnosticoInicial"
						   class="form-label fw-semibold">

						Diagnóstico inicial

					</label>

					<textarea asp-for="DiagnosticoInicial"
							  rows="4"
							  class="form-control">
                    </textarea>

				</div>

				<!-- Observaciones -->
				<div class="col-md-6">

					<label asp-for="Observaciones"
						   class="form-label fw-semibold">

						Observaciones

					</label>

					<textarea asp-for="Observaciones"
							  rows="4"
							  class="form-control">
                    </textarea>

				</div>

			</div>


			<br />

			<!-- DOCUMENTOS SOPORTE -->
			<div class="col-md-12">

				<div class="card border-0 shadow-sm">

					<div class="card-header bg-light">

						<div class="d-flex justify-content-between align-items-center">

							<h6 class="mb-0 fw-bold">
								Documentos soporte
							</h6>

							<span class="badge bg-secondary">
								@(Model.Documentos?.Count ?? 0)
								archivo(s)
							</span>

						</div>

					</div>

					<div class="card-body">

						<!-- DOCUMENTOS REGISTRADOS -->
						@if (Model.Documentos != null && Model.Documentos.Any())
						{
							<div class="table-responsive mb-4">

								<table class="table table-sm align-middle">

									<thead class="table-light">

										<tr>

											<th>
												Documento
											</th>

											<th>
												Tipo
											</th>

											<th>
												Fecha
											</th>

											<th class="text-center">
												Acción
											</th>

										</tr>

									</thead>

									<tbody>

										@foreach (var documento in Model.Documentos)
										{
											<tr>

												<td>
													<i class="bi bi-paperclip me-1"></i>
													@documento.NombreArchivo
												</td>

												<td>
													@documento.TipoDocumento
												</td>

												<td>
													@documento.FechaCarga.ToString("dd/MM/yyyy HH:mm")
												</td>

												<td class="text-center">

													<a asp-action="DescargarDocumento"
													   asp-route-id="@documento.SolicitudMantenimientoDocumentoId"
													   class="btn btn-sm btn-outline-primary">

														<i class="bi bi-download"></i>

													</a>

												</td>

											</tr>
										}

									</tbody>

								</table>

							</div>
						}
						else
						{
							<div class="alert alert-light border">

								<i class="bi bi-info-circle me-1"></i>

								No existen documentos cargados para esta solicitud.

							</div>
						}

						<!-- NUEVOS DOCUMENTOS -->

						<div class="border-top pt-3">

							<label class="form-label fw-semibold">
								Adjuntar documentos adicionales
							</label>

							<input asp-for="Archivos"
								   type="file"
								   class="form-control"
								   id="archivosInput"
								   multiple
								   accept=".pdf,.jpg,.jpeg,.png" />

							<small class="text-muted">

								Permitidos:
								PDF, JPG, JPEG y PNG.

								<br />

								Máximo:
								5 archivos de 2 MB c/u.

							</small>

							<div id="errorArchivos"
								 class="text-danger small mt-2">
							</div>

						</div>

					</div>
				</div>
			</div>





			<br />

			@if (Model.EstatusSolicitudMantenimientoId == 4)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-wrench fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud en proceso de validación técnica
							</h6>

							<p class="mb-1">

								La solicitud ya fue validada presupuestalmente y actualmente
								se encuentra en proceso de validación técnica.

							</p>

							<p class="mb-0">

								Los servicios, cantidades, costos y objetos de gasto
								han sido congelados para evitar inconsistencias durante
								la revisión técnica.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 5)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-check-circle-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud autorizada
							</h6>

							<p class="mb-1">

								La validación técnica fue autorizada y la
								cotización quedó formalmente aprobada.

							</p>

							<p class="mb-0">

								Los servicios mostrados corresponden a la versión
								autorizada de la solicitud y ya no pueden ser
								modificados.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 6)
			{
				<div class="alert alert-danger border-start border-4 border-danger mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud rechazada
							</h6>

							<p class="mb-1">

								La solicitud fue rechazada durante el proceso de revisión
								y requiere correcciones antes de continuar con su trámite.

							</p>

							<p class="mb-0">

								Puede modificar los servicios, cantidades, objetos de gasto y demás información necesaria para
								atender las observaciones realizadas y posteriormente
								reenviar la solicitud para una nueva revisión.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 7)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-tools fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Mantenimiento en ejecución
							</h6>

							<p class="mb-1">

								La unidad ya fue ingresada al taller y los trabajos de
								mantenimiento se encuentran en proceso.

							</p>

							<p class="mb-0">

								La cotización inicial se muestra únicamente como
								referencia histórica y no puede modificarse.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 8)
			{
				<div class="alert alert-warning border-start border-4 border-warning mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-clipboard-check-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Mantenimiento finalizado
							</h6>

							<p class="mb-1">

								El mantenimiento fue concluido y cerrado
								administrativamente.

							</p>

							<p class="mb-0">

								La información de la cotización se conserva únicamente
								para consulta y auditoría.

							</p>

						</div>

					</div>

				</div>
			}
			else if (Model.EstatusSolicitudMantenimientoId == 9)
			{
				<div class="alert alert-danger border-start border-4 border-danger mb-3">

					<div class="d-flex align-items-start">

						<i class="bi bi-x-circle-fill fs-4 me-3"></i>

						<div>

							<h6 class="fw-bold mb-1">
								Solicitud cancelada
							</h6>

							<p class="mb-1">

								Esta solicitud fue cancelada y ya no forma parte del
								flujo operativo de mantenimiento.

							</p>

							<p class="mb-0">

								Los servicios se muestran únicamente para fines de
								consulta histórica.

							</p>

						</div>

					</div>

				</div>
			}




			<!-- SERVICIOS -->
			<div class="col-md-12">

				<div class="card border-0 shadow-sm">

					<div class="card-header border-0 text-white"
						 style="background: linear-gradient(90deg, #800705 0%, #a10b08 100%);">

						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

							<div>

								<div class="d-flex align-items-center gap-2">

									<i class="bi bi-receipt-cutoff fs-4"></i>

									<h5 class="fw-bold mb-0">
										COTIZACIÓN INICIAL
										@* @if (Model.EstatusSolicitudMantenimientoId >= 3)
										{
											<span class="badge bg-warning text-dark">

												<i class="bi bi-lock-fill me-1"></i>
												Solo lectura

											</span>
										} *@
									</h5>

								</div>


								@if (Model.EstatusSolicitudMantenimientoId >= 3)
								{
									<small class="opacity-75">
										Servicios validados y bloqueados para edición.
									</small>

								}
								else
								{
									<small class="opacity-75">
										Seleccione los servicios y clasifique manualmente los objetos de gasto.
									</small>
								}





							</div>

							@if (Model.EstatusSolicitudMantenimientoId < 3)
							{
								<button type="button"
										id="btnAgregarServicio"
										class="btn btn-light btn-sm fw-semibold shadow-sm">

									<i class="bi bi-plus-circle me-1"></i>
									Agregar Servicio

								</button>
							}

						</div>

					</div>

					<div class="card-body bg-light-subtle">

						<div class="table-responsive">

							<table class="table table-bordered table-hover align-middle"
								   id="tablaServicios">

								<thead class="table-light">

									<tr>

										<th class="col-concepto">
											Concepto
										</th>

										<th class="col-cantidad text-center">
											Cantidad
										</th>

										<th class="col-manoobra text-end">
											$ Mano de obra
										</th>

										<th class="col-partida-mo">
											Partida M.O.
										</th>

										<th class="col-refacciones text-end">
											$ Refacciones
										</th>

										<th class="col-partida-ref">
											Partida Ref.
										</th>

										<th class="col-observaciones">
											Observaciones
										</th>

										<th class="col-acciones text-center">
										</th>

									</tr>

								</thead>

								<tbody>
								</tbody>

							</table>

						</div>

						<div class="mt-3">

							<div class="alert alert-light border mb-0">

								<div class="d-flex align-items-start">

									<i class="bi bi-info-circle-fill text-primary fs-5 me-2"></i>

									<div class="small">

										<strong>Importante:</strong>

										Un mismo servicio puede afectar diferentes objetos de gasto.

										<br />

										Ejemplo:
										<strong>Cambio de aceite</strong>
										puede afectar:

										<ul class="mb-0 mt-2">

											<li>
												Mano de obra →
												355001 Conservación y Mantenimiento
											</li>

											<li>
												Refacciones/Insumos →
												261001 Lubricantes y Aditivos
											</li>

										</ul>

									</div>

								</div>

							</div>

						</div>

						<div class="mt-2">

							<small class="text-muted">
								Los costos son calculados automáticamente desde la matriz oficial de mantenimiento.
							</small>

						</div>

					</div>

				</div>

			</div>















			<hr class="my-4" />

			<div class="d-flex justify-content-end gap-2">

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					Cancelar

				</a>

				<button type="submit"
						class="btn text-light"
						style="background-color:#800705">

					<i class="bi bi-save me-1"></i>
					Guardar Cambios

				</button>

			</div>

		</form>

	</div>

</div>

@section Scripts {

	@{
		await Html.RenderPartialAsync(
			"_ValidationScriptsPartial");
	}

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>




	<style>



		/* =========================================
		TABLA SERVICIOS
		========================================= */

		.table-servicios {
		table-layout: fixed;
		width: 100%;
		}

		.table-servicios td {
		vertical-align: top;
		padding-top: 8px;
		padding-bottom: 8px;
		}

		/* =========================================
		TABLA SERVICIOS
		========================================= */

		#tablaServicios {
		table-layout: fixed;
		width: 100%;
		}

		#tablaServicios .col-concepto {
		width: 28%;
		}

		#tablaServicios .col-cantidad {
		width: 6%;
		}

		#tablaServicios .col-manoobra {
		width: 10%;
		}

		#tablaServicios .col-partida-mo {
		width: 15%;
		}

		#tablaServicios .col-refacciones {
		width: 10%;
		}

		#tablaServicios .col-partida-ref {
		width: 15%;
		}

		#tablaServicios .col-observaciones {
		width: 12%;
		}

		#tablaServicios .col-acciones {
		width: 4%;
		}

		/* =========================================
		SELECT2
		========================================= */

		.select2-container {
		width: 100% !important;
		}

		/* =========================================
		CONCEPTO SERVICIO
		========================================= */

		.columnaConceptoServicio {
		min-width: 350px;
		}

		.contenedorConceptoServicio {
		min-width: 320px;
		}
		/* =========================================
		CONTROL SELECT2
		AUTO AJUSTE POR CONTENIDO
		========================================= */

		.select2-container--default
		.select2-selection--single {
		height: auto !important;
		min-height: 38px;
		display: flex;
		align-items: flex-start;
		padding-top: 4px;
		padding-bottom: 4px;
		border: 1px solid #ced4da;
		border-radius: 0.375rem;
		}

		/* =========================================
		TEXTO SELECCIONADO
		========================================= */

		.select2-container--default
		.select2-selection--single
		.select2-selection__rendered {
		white-space: normal !important;
		word-break: break-word;
		overflow: visible !important;
		text-overflow: unset !important;
		line-height: 1.3rem;
		padding-right: 28px;
		padding-top: 2px;
		padding-bottom: 2px;
		}

		/* =========================================
		FLECHA
		========================================= */

		.select2-container--default
		.select2-selection--single
		.select2-selection__arrow {
		height: 100%;
		top: 0;
		right: 4px;
		}

		/* =========================================
		OPCIONES DROPDOWN

	<script>
		function recalcularImporteCotizacion() {

		let total = 0;

		

		$("#tablaServicios tbody tr").each(function () {

		const cantidad =
		parseFloat(
		$(this)
		.find('input[name$=".Cantidad"]')
		.val() || 0);

		const manoObra =
		parseFloat(
		$(this)
		.find(".costoManoObra")
		.val() || 0);

		const refacciones =
		parseFloat(
		$(this)
		.find(".costoRefacciones")
		.val() || 0);

		total += cantidad * (manoObra + refacciones);
		});

		total = Number(total.toFixed(2));

		const totalRedondeado = Math.round(total * 100) / 100;

		$("#ImporteCotizacionVisual")
		.val(formatoMoneda(totalRedondeado));

		$("#ImporteCotizacion")
		.val(totalRedondeado);
		}
	</script>


	<script>
		$(document).on(
		"input",
		'input[name$=".Cantidad"]',
		function () {

		recalcularImporteCotizacion();
		});
	</script>
	



	<script>
		function renumerarServicios() {

		const filas =
		$("#tablaServicios tbody tr");

		filas.each(function (index) {

		const fila =
		$(this);

		// ==========================
		// DESTRUIR SELECT2
		// ==========================
		fila.find(".conceptoServicio").each(function () {

		if ($(this).hasClass("select2-hidden-accessible")) {

		$(this).select2('destroy');
		}

		});

		// ==========================
		// RENOMBRAR name
		// ==========================
		fila.find("[name]").each(function () {

		const elemento =
		$(this);

		const name =
		elemento.attr("name");

		if (!name)
		return;

		elemento.attr(
		"name",
		name.replace(
		/Servicios\[\d+\]/,
		`Servicios[${index}]`
		)
		);

		});

		// ==========================
		// RENOMBRAR id
		// ==========================
		fila.find("[id]").each(function () {

		const elemento =
		$(this);

		const id =
		elemento.attr("id");

		if (!id)
		return;

		elemento.attr(
		"id",
		id.replace(
		/Servicios_\d+__/,
		`Servicios_${index}__`
		)
		);

		});

		// ==========================
		// REINICIALIZAR SELECT2
		// ==========================
		fila.find(".conceptoServicio").select2({

		placeholder:
		'Buscar concepto',

		allowClear:
		true,
		
		width:
		'100%',

		dropdownParent:
		$("#tablaServicios")

		});

		});

		indiceServicio =
		filas.length;

		recalcularImporteCotizacion();
		}
	</script>





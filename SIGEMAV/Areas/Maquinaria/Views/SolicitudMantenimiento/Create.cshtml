		$(document).on(
		"change",
		".conceptoServicio",
		function () {

		const selectActual =
		$(this);

		const conceptoServicioId =
		selectActual.val();

		const unidadVehicularId =
		$("#unidadVehicularSelect").val();

		if (!conceptoServicioId) {
		return;
		}

		// ============================================
		// VALIDAR DUPLICADOS
		// ============================================

		let repetido = false;

		$(".conceptoServicio")
		.not(this)
		.each(function () {

		if ($(this).val() === conceptoServicioId) {

		repetido = true;
		}
		});

		if (repetido) {

		Swal.fire({

		icon: 'warning',

		title: 'Concepto duplicado',

		text: 'El concepto ya fue agregado.',


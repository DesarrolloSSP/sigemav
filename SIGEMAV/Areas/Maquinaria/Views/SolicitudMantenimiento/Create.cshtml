		error: function () {

		Swal.fire({

		icon: 'error',

		title: 'Error',

		text: 'No fue posible obtener los costos.',

		confirmButtonColor: '#800705'
		});
		}
		});
		});

		// ============================================
		// VALIDAR FORM + HISTÓRICO
		// ============================================

		$("form").submit(async function (e) {

		e.preventDefault();

		const filas =
		$("#tablaServicios tbody tr");

		//-------------------------------------
		// VALIDAR EXISTEN SERVICIOS
		//-------------------------------------

		if (filas.length === 0) {

		Swal.fire({

		icon: 'warning',

		title: 'Servicios requeridos',

		text:
		'Debe agregar al menos un servicio.',

		confirmButtonColor:
		'#800705'
		});

		return false;
		}

		//-------------------------------------
		// VALIDAR CONCEPTOS
		//-------------------------------------

		const conceptos = [];

		let valido = true;

		$(".conceptoServicio").each(function () {

		const valor =
		$(this).val();

		if (!valor) {

		valido = false;

		return false;
		}

		conceptos.push(
		parseInt(valor));

		});

		if (!valido) {

		Swal.fire({

		icon:
		'warning',

		title:
		'Conceptos incompletos',

		text:
		'Existen servicios sin concepto seleccionado.',

		confirmButtonColor:
		'#800705'
		});

		return false;
		}

		//-------------------------------------
		// OBTENER DATOS
		//-------------------------------------

		const unidadVehicularId =
		$("#unidadVehicularSelect").val();

		const tipoMantenimientoId =
		$("#TipoMantenimientoId").val();

		if (
		!unidadVehicularId
		||
		!tipoMantenimientoId
		) {

		this.submit();

		return;
		}

		//-------------------------------------
		// VALIDAR HISTÓRICO
		//-------------------------------------

		try {

		const response = await $.ajax({
		url: '@Url.Action("ValidarServiciosHistoricos", "SolicitudMantenimiento", new { area = "Maquinaria" })',
		type: 'POST',
		traditional: true,
		data: {
			unidadVehicularId: unidadVehicularId,
			tipoMantenimientoId: tipoMantenimientoId,
			conceptos: conceptos
		}
		});

		//-------------------------------------
		// BLOQUEAR DUPLICADOS ABIERTOS
		//-------------------------------------

		if (
		response.tieneDuplicadosActivos
		) {

		Swal.fire({

		icon:
		'error',

		title:
		'Servicios ya solicitados',

		html:
		response.mensajes.join("<br>"),

		confirmButtonColor:
		'#800705'
		});

		return false;
		}

		//-------------------------------------
		// ALERTA HISTÓRICO
		//-------------------------------------

		if (
		response.tieneRecurrencia
		) {

		const continuar =
		await Swal.fire({

		icon:
		'warning',

		title:
		'Servicio recurrente',

		html:
		response.mensajes.join("<br><br>")
		+
		"¿Desea continuar?",

		showCancelButton:
		true,

		confirmButtonText:
		'Continuar',

		cancelButtonText:
		'Cancelar',

		confirmButtonColor:
		'#800705'
		});

		if (
		!continuar.isConfirmed
		) {

		return false;
		}
		}

		//-------------------------------------
		// ENVIAR FORM
		//-------------------------------------

		this.submit();

		}
		catch {

		Swal.fire({

		icon:
		'error',

		title:
		'Error',

		text:
		'No fue posible validar el histórico.',

		confirmButtonColor:
		'#800705'
		});

		return false;
		}

		});

		let valido = true;

		servicios.each(function () {

		if (!$(this).val()) {

		valido = false;
		}
		});

		if (!valido) {

		e.preventDefault();

		Swal.fire({

		icon: 'warning',

		title: 'Conceptos incompletos',

		text: 'Existen servicios sin concepto seleccionado.',

		confirmButtonColor: '#800705'
		});

		return;
		}
		});

	

	</script>



	<script>
		async function cargarConceptosPorUnidad(select) {

				const unidadVehicularId =
					$("#unidadVehicularSelect").val();

				console.log("unidadVehicularId:", unidadVehicularId);

				if (!unidadVehicularId || unidadVehicularId === "0") {

					select.html(`
						<option value="">
							Seleccione unidad primero
						</option>`);

					return;
				}

				try {

					const conceptos =
						await $.get(
							"/Maquinaria/SolicitudMantenimiento/ObtenerConceptosServicioPorUnidad",
							{ unidadVehicularId });

					console.log("conceptos:", conceptos);

					let html = `<option value="">Seleccione concepto</option>`;

					conceptos.forEach(x => {
						html += `<option value="${x.value}">${x.text}</option>`;
					});

					select.html(html);

				} catch (e) {

					console.error(e);

					Swal.fire({
						icon: 'error',
						title: 'Error',
						text: 'No fue posible cargar conceptos.'
					});
				}
			}
	</script>



	<script>
		async function cargarConceptosPorTipo(tipoCatalogoServicioId, select) {

		if (!tipoCatalogoServicioId) {

		select.html(`
		<option value="">
		Seleccione tipo primero
		</option>`);

		return;
		}

		try {

		const conceptos =
		await $.get(
		"/Maquinaria/SolicitudMantenimiento/ObtenerConceptosServicioPorTipo",
		{
		tipoCatalogoServicioId
		});

		let html =
		`<option value="">
		Seleccione concepto
		</option>`;

		conceptos.forEach(x => {

		html += `
		<option value="${x.value}">
		${x.text}
		</option>`;
		});

		select.html(html);

		}
		catch {

		Swal.fire({
		icon: 'error',
		title: 'Error',
		text: 'No fue posible cargar conceptos.'
		});
		}
		}
	</script>


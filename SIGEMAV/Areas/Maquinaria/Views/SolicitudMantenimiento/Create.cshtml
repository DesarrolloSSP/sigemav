@model SIGEMAV.Models.ViewModels.Maquinaria.SolicitudMantenimientoCreateViewModel

@{
	ViewData["Title"] =
		"Nueva Solicitud de Mantenimiento";
}

<div class="card shadow-sm border-0">

	<div class="card-header bg-white">

		<div class="d-flex justify-content-between align-items-center">

			<div>

				<h4 class="fw-bold mb-0">
					Nueva solicitud de mantenimiento
				</h4>

				<small class="text-muted">
					Gestión administrativa de mantenimiento vehicular
				</small>

			</div>

			<div>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>
					Regresar

				</a>

			</div>

		</div>

	</div>

	<div class="card-body">

		<form asp-action="Create" method="post" enctype="multipart/form-data">

			<div asp-validation-summary="ModelOnly" class="alert alert-danger">
			</div>

			<div id="alertaCamposObligatorios"
				 class="alert alert-warning border-0 shadow-sm d-none">

				<i class="bi bi-exclamation-triangle-fill me-2"></i>

				Debe completar todos los campos obligatorios
				antes de agregar servicios.

			</div>


			<div class="row g-4">

				<!-- Folio -->
				@*   <div class="col-md-3">

                    <label asp-for="Folio"
                           class="form-label fw-semibold">

                        Folio

                    </label>

                    <input asp-for="Folio"
                           class="form-control" />

                </div> *@
				<!-- Fecha -->
				<div class="col-md-6">

					<label asp-for="FechaSolicitud"
						   class="form-label fw-semibold campo-obligatorio">

						Fecha Solicitud

					</label>

					

					<input asp-for="FechaSolicitud"
						   type="datetime-local"
						   class="form-control" required/>

				</div>


				<!-- Oficio -->
				<div class="col-md-6">

					<label asp-for="NumeroOficio"
						   class="form-label fw-semibold campo-obligatorio">

						Número de Oficio

					</label>

					<input asp-for="NumeroOficio"
						   class="form-control" required/>

				</div>

              


				<!-- Estatus -->
				@*   <div class="col-md-3">

                    <label asp-for="EstatusSolicitudMantenimientoId"
                           class="form-label fw-semibold">

                        Estatus

                    </label>

                    <select asp-for="EstatusSolicitudMantenimientoId"
                            asp-items="Model.Estatuses"
                            class="form-select">

                        <option value="">
                            Seleccione estatus
                        </option>

                    </select>

                </div> *@

               

				<!-- Unidad -->
				<div class="col-md-4">

					<label asp-for="UnidadVehicularId"
						   class="form-label fw-semibold campo-obligatorio">

						Unidad Vehicular

					</label>

					<select asp-for="UnidadVehicularId"
							class="form-select"
							id="unidadVehicularSelect" required>

						@if (Model.UnidadVehicularId > 0)
						{
							<option value="@Model.UnidadVehicularId" selected>
								@Model.UnidadVehicularTexto
							</option>
						}

					</select>

					<span asp-validation-for="UnidadVehicularId"
						  class="text-danger">
					</span>

				</div>


				<!-- Kilometraje -->
				<div class="col-md-4">

					<label asp-for="KilometrajeActual"
						   class="form-label fw-semibold campo-obligatorio">

						Kilometraje Actual

					</label>

					<input asp-for="KilometrajeActual"
						   class="form-control" required />

				</div>


				<!-- Tipo -->
				<div class="col-md-4">

					<label asp-for="TipoMantenimientoId"
						   class="form-label fw-semibold campo-obligatorio">

						Tipo de Mantenimiento

					</label>

					<select asp-for="TipoMantenimientoId"
							asp-items="Model.TiposMantenimiento"
							class="form-select" required>

						<option value="">
							Seleccione tipo
						</option>

					</select>

				</div>

			



				<!-- Taller -->
				<div class="col-md-4">

					<label asp-for="TallerId"
						   class="form-label fw-semibold campo-obligatorio">

						Taller

					</label>

					<select asp-for="TallerId"
							asp-items="Model.Talleres"
							class="form-select" required>

						<option value="">
							Seleccione taller
						</option>

					</select>

				</div>

				<!-- Cotización -->
				<div class="col-md-4">

					<label class="form-label fw-semibold">

						Importe Cotización

					</label>

					<input id="ImporteCotizacionVisual"
						   class="form-control text-end"
						   readonly
						   value="0.00" />

					<small class="text-muted">
						Calculado automáticamente a partir de los servicios.
					</small>

				</div>

			

				<!-- Área -->
				<div class="col-md-4">
					<label asp-for="AreaSolicitanteId"
						   class="form-label fw-semibold campo-obligatorio">
						Área Solicitante
					</label>
					<select id="AreaSolicitanteIdDisplay"
							asp-items="Model.Areas"
							class="form-select"
							disabled>
						<option value="">
							Seleccione área
						</option>
					</select>
					<input type="hidden" asp-for="AreaSolicitanteId" />

					<small class="text-muted">
						Área obtenida de la plantilla vehicular.
					</small>
				</div>

             

             

             
				<!-- Motivo -->
				<div class="col-md-12">

					<label asp-for="MotivoSolicitud" class="form-label fw-semibold">
						Motivo de Solicitud
					</label>

					<textarea asp-for="MotivoSolicitud" rows="3" class="form-control"></textarea>

				</div>

				<!-- Diagnóstico -->
				<div class="col-md-6">

					<label asp-for="DiagnosticoInicial"
						   class="form-label fw-semibold campo-obligatorio">

						Diagnóstico Inicial

					</label>

					<textarea asp-for="DiagnosticoInicial"
							  rows="4"
							  class="form-control" required>
                    </textarea>

				</div>

				<!-- Observaciones -->
				<div class="col-md-6">

					<label asp-for="Observaciones"
						   class="form-label fw-semibold">

						Observaciones

					</label>

					<textarea asp-for="Observaciones"
							  rows="4"
							  class="form-control">
                    </textarea>

				</div>

			</div>





			@if (Model.Archivos != null && Model.Archivos.Any())
			{
				<div class="alert alert-warning">

					Los archivos deben volver a seleccionarse
					después de una validación fallida.

				</div>
			}
			<!-- Documentos -->
			<div class="col-md-12">

				<label class="form-label fw-semibold campo-obligatorio">
					Documentos Soporte
				</label>

				<input asp-for="Archivos"
					   type="file"
					   class="form-control"
					   id="archivosInput"
					   multiple
					   accept=".pdf,.jpg,.jpeg,.png" required/>

				<small class="text-muted">
					Adjunte oficio, evidencias fotográficas,
					cotizaciones o diagnósticos.
					Máximo 5 archivos de 2 MB c/u.
				</small>

				<div id="errorArchivos"
					 class="text-danger small mt-2">
				</div>

			</div>






			<!-- SERVICIOS -->
			<div class="col-md-12">

				<div class="card border-0 shadow-sm">

					<div class="card-header border-0 text-white"
						 style="background: linear-gradient(90deg, #800705 0%, #a10b08 100%);">

						<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

							<div>

								<div class="d-flex align-items-center gap-2">

									<i class="bi bi-receipt-cutoff fs-4"></i>

									<h5 class="fw-bold mb-0">
										COTIZACIÓN INICIAL
									</h5>

								</div>

								<small class="opacity-75">
									Seleccione los servicios y clasifique manualmente los objetos de gasto.
								</small>

							</div>

							<button type="button"
									id="btnAgregarServicio"
									class="btn btn-light btn-sm fw-semibold shadow-sm">

								<i class="bi bi-plus-circle me-1"></i>
								Agregar Servicio

							</button>

						</div>

					</div>

					<div class="card-body bg-light-subtle">

						<div class="table-responsive">

							<table class="table table-bordered table-hover align-middle"
								   id="tablaServicios">

								<thead class="table-light">

									<tr>

										<th class="col-concepto">
											Concepto
										</th>

										<th class="col-cantidad text-center">
											Cantidad
										</th>

										<th class="col-manoobra text-end">
											$ Mano de obra
										</th>

										<th class="col-partida-mo">
											Partida M.O.
										</th>

										<th class="col-refacciones text-end">
											$ Refacciones
										</th>

										<th class="col-partida-ref">
											Partida Ref.
										</th>

										<th class="col-observaciones">
											Observaciones
										</th>

										<th class="col-acciones text-center">
										</th>

									</tr>

								</thead>

								<tbody>
								</tbody>

							</table>

						</div>

						<div class="mt-3">

							<div class="alert alert-light border mb-0">

								<div class="d-flex align-items-start">

									<i class="bi bi-info-circle-fill text-primary fs-5 me-2"></i>

									<div class="small">

										<strong>Importante:</strong>

										Un mismo servicio puede afectar diferentes objetos de gasto.

										<br />

										Ejemplo:
										<strong>Cambio de aceite</strong>
										puede afectar:

										<ul class="mb-0 mt-2">

											<li>
												Mano de obra →
												355001 Conservación y Mantenimiento
											</li>

											<li>
												Refacciones/Insumos →
												261001 Lubricantes y Aditivos
											</li>

										</ul>

									</div>

								</div>

							</div>

						</div>

						<div class="mt-2">

							<small class="text-muted">
								Los costos son calculados automáticamente desde la matriz oficial de mantenimiento.
							</small>

						</div>

					</div>

				</div>

			</div>









			<hr class="my-4" />

			<div class="d-flex justify-content-end gap-2">

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					Cancelar

				</a>

				<button type="submit"
						class="btn text-light"
						style="background-color:#800705">

					<i class="bi bi-save me-1"></i>
					Guardar Solicitud

				</button>

			</div>

		</form>

	</div>

</div>



@section Scripts {

	@{
		await Html.RenderPartialAsync(
			"_ValidationScriptsPartial");
	}


	<style>

    .campo-obligatorio::after {

        content: " *";

        color: red;

        font-weight: bold;
    }

    .input-validation-obligatorio {

        border: 2px solid #dc3545 !important;

        background-color: #fff8f8;
    }









		/* =========================================
		   TABLA SERVICIOS
		========================================= */

		#tablaServicios {
			table-layout: fixed;
			width: 100%;
		}

			#tablaServicios .col-concepto {
				width: 28%;
			}

			#tablaServicios .col-cantidad {
				width: 6%;
			}

			#tablaServicios .col-manoobra {
				width: 10%;
			}

			#tablaServicios .col-partida-mo {
				width: 15%;
			}

			#tablaServicios .col-refacciones {
				width: 10%;
			}

			#tablaServicios .col-partida-ref {
				width: 15%;
			}

			#tablaServicios .col-observaciones {
				width: 12%;
			}

			#tablaServicios .col-acciones {
				width: 4%;
			}

		/* =========================================
		   SELECT2
		========================================= */

		.select2-container {
			width: 100% !important;
		}

		/* =========================================
		   CONCEPTO SERVICIO
		========================================= */

		.columnaConceptoServicio {
			min-width: 350px;
		}

		.contenedorConceptoServicio {
			min-width: 320px;
		}



		.select2-container--default .select2-selection--single {
	display: flex !important;
	align-items: center !important;
	min-height: 70px;
	height: auto !important;
	padding-top: 6px;
	padding-bottom: 6px;
}

.select2-selection__rendered {
	white-space: normal !important;
	word-break: break-word;
	line-height: 1.3rem !important;
	padding-top: 6px !important;
	padding-bottom: 6px !important;
	padding-left: 12px !important;
	padding-right: 28px !important;
	display: flex !important;
	align-items: center !important;
	min-height: 58px;
}

.select2-selection__arrow {
	height: 100% !important;
	top: 0 !important;
	right: 6px !important;
}

	</style>










	<!-- SELECT2 -->

	<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
	<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>

		const serviciosExistentes = @Html.Raw(
					System.Text.Json.JsonSerializer.Serialize(
						Model.Servicios ??
						new List<SIGEMAV.Models.ViewModels.Maquinaria.SolicitudMantenimientoServicioViewModel>()
					)
				);

	</script>



	<script>

		function formatoMoneda(valor) {

		const numero =
		parseFloat(valor || 0);

		return numero.toLocaleString('es-MX', {

		minimumFractionDigits: 2,
		maximumFractionDigits: 2

		});
		}

		function validarCamposObligatorios() {

		const alerta =
		$("#alertaCamposObligatorios");

		const fechaSolicitud =
		$("#FechaSolicitud").val();

		const numeroOficio =
		$("#NumeroOficio").val();

		const unidadVehicular =
		$("#unidadVehicularSelect").val();

		const tipoMantenimiento =
		$("#TipoMantenimientoId").val();

		const kilometraje =
		$("#KilometrajeActual").val();

		const taller =
		$("#TallerId").val();

		const importe =
		$("#ImporteCotizacion").val();

		const area =
		$("#AreaSolicitanteId").val();

		const diagnostico =
		$("#DiagnosticoInicial").val();

		const archivos =
		$("#archivosInput")[0].files.length;

		const valido =

		fechaSolicitud
		&& numeroOficio
		&& unidadVehicular
		&& tipoMantenimiento
		&& kilometraje
		&& taller
		&& area
		&& diagnostico
		&& archivos > 0;

		if (!valido) {

		alerta.removeClass("d-none");

		Swal.fire({

		icon: 'warning',

		title: 'Campos obligatorios',

		html: `
		Debe completar todos los campos
		obligatorios antes de agregar servicios.
		`,

		confirmButtonColor: '#800705'
		});

		return false;
		}

		alerta.addClass("d-none");

		return true;
		}

		$(document).ready(function () {

		$('#unidadVehicularSelect').select2({

		placeholder: 'Buscar unidad vehicular',

		allowClear: true,

		width: '100%',

		minimumInputLength: 0,

		ajax: {

		url: '@Url.Action("BuscarUnidadesVehiculares", "SolicitudMantenimiento", new { area = "Maquinaria" })',

		dataType: 'json',

		delay: 300,

		data: function (params) {

		return {
		term: params.term || ''
		};

		},

		processResults: function (data) {

		return {
		results: data
		};

		},

		cache: true
		}

		});

		// ====================================================
		// AL SELECCIONAR UNA UNIDAD CARGAR ÁREA AUTOMÁTICAMENTE
		// ====================================================

		$('#unidadVehicularSelect').on('select2:select', function (e) {

		const unidadVehicularId = e.params.data.id;

		$.ajax({

		url: '@Url.Action("ObtenerAreaUnidad", "SolicitudMantenimiento", new { area = "Maquinaria" })',

		type: 'GET',

		data: {
		unidadVehicularId: unidadVehicularId
		},

		success: function (data) {

		$("#AreaSolicitanteId")
		.val(data.areaId);

		$("#AreaSolicitanteIdDisplay")
		.val(data.areaId);
		},

		error: function () {

		Swal.fire({

		icon: 'error',

		title: 'Error',

		text: 'No fue posible obtener el área de la unidad.',

		confirmButtonColor: '#800705'
		});
		}
		});
		});

		// ====================================================
		// SI LIMPIAN LA UNIDAD, LIMPIAR ÁREA
		// ====================================================

		$('#unidadVehicularSelect').on('select2:clear', function () {

		$("#AreaSolicitanteId")
		.val('')
		.trigger('change');

		});

		});

	</script>





	<script>
		// VALIDACIÓN DE ARCHIVOS
		(() => {

			const input =
				document.getElementById("archivosInput");

			const errorDiv =
				document.getElementById("errorArchivos");

			const maxArchivos = 5;

			const maxSize =
				2 * 1024 * 1024;

			const extensionesPermitidas = [
				".pdf",
				".jpg",
				".jpeg",
				".png"
			];

			input.addEventListener("change", function () {

				errorDiv.innerHTML = "";

				const archivos =
					Array.from(input.files);

				// =====================================
				// VALIDAR CANTIDAD
				// =====================================

				if (archivos.length > maxArchivos) {

					errorDiv.innerHTML =
						`Solo se permiten ${maxArchivos} archivos.`;

					input.value = "";

					return;
				}

				// =====================================
				// VALIDAR ARCHIVOS
				// =====================================

				for (const archivo of archivos) {

					// VALIDAR TAMAÑO

					if (archivo.size > maxSize) {

						errorDiv.innerHTML =
							`El archivo '${archivo.name}' excede 2 MB.`;

						input.value = "";

						return;
					}

					// VALIDAR EXTENSION

					const extension =
						archivo.name
							.substring(
								archivo.name.lastIndexOf("."))
							.toLowerCase();

					if (!extensionesPermitidas.includes(extension)) {

						errorDiv.innerHTML =
							`El archivo '${archivo.name}' no tiene una extensión permitida.`;

						input.value = "";

						return;
					}

					// VALIDAR NOMBRE

					if (archivo.name.length > 150) {

						errorDiv.innerHTML =
							`El nombre del archivo '${archivo.name}' es demasiado largo.`;

						input.value = "";

						return;
					}
				}

			});

		})();

	</script>


	<script>

		let indiceServicio = 0;
		
		$(document).ready(function () {

		// ============================================
		// RECONSTRUIR SERVICIOS POSTBACK
		// ============================================

		if (serviciosExistentes.length > 0) {

		serviciosExistentes.forEach(function (detalle) {

		agregarFilaServicio(false);

		const fila =
		$("#tablaServicios tbody tr:last");

		// ==========================
		// CONCEPTO
		// ==========================

		fila.data(
		"partida-manoobra",
		detalle.IdObjetoGastoManoObra);

		fila.data(
		"partida-refacciones",
		detalle.IdObjetoGastoRefacciones);

		fila.find(".conceptoServicio")
		.val(detalle.ConceptoServicioId)
		.trigger("change");







		// ==========================
		// CANTIDAD
		// ==========================

		fila.find(
		`input[name="Servicios[${indiceServicio - 1}].Cantidad"]`
		).val(detalle.Cantidad);

		// ==========================
		// COSTOS
		// ==========================

		fila.find(".costoManoObra")
		.val(detalle.CostoEstimadoManoObra);

		fila.find(".costoManoObraVisual")
		.val(formatoMoneda(
		detalle.CostoEstimadoManoObra || 0
		));

		fila.find(".costoRefacciones")
		.val(detalle.CostoEstimadoRefacciones);

		fila.find(".costoRefaccionesVisual")
		.val(formatoMoneda(
		detalle.CostoEstimadoRefacciones || 0
		));

		// ==========================
		// PARTIDAS
		// ==========================

		fila.find(".objetoGastoManoObra")
		.val(detalle.IdObjetoGastoManoObra);

		fila.find(".objetoGastoRefacciones")
		.val(detalle.IdObjetoGastoRefacciones);

		// ==========================
		// OBSERVACIONES
		// ==========================

		fila.find("textarea")
		.val(detalle.Observaciones);

		});

		recalcularImporteCotizacion();

		}

		// ============================================
		// BOTÓN AGREGAR SERVICIO
		// ============================================

		$("#btnAgregarServicio").click(async function () {

		await agregarFilaServicio(true);

		});

		// ============================================
		// CARGAR CONCEPTOS POR UNIDAD
		// ============================================

		async function cargarConceptosUnidad(select) {

		const unidadVehicularId =
		$("#unidadVehicularSelect").val();

		if (!unidadVehicularId) {

		select.html(`
		<option value="">
		Seleccione unidad primero
		</option>`);

		return;
		}

		try {

		const conceptos =
		await $.get(
		"/Maquinaria/SolicitudMantenimiento/ObtenerConceptosServicioPorUnidad",
		{
		unidadVehicularId
		});

		let html =
		`<option value="">
		Seleccione concepto
		</option>`;

		conceptos.forEach(x => {

		html += `
		<option value="${x.value}">
		${x.text}
		</option>`;
		});

		select.html(html);

		}
		catch {

		Swal.fire({
		icon: 'error',
		title: 'Error',
		text: 'No fue posible cargar conceptos.'
		});
		}
		}

		// ============================================
		// AGREGAR FILA
		// ============================================

		async function agregarFilaServicio(validar = true) {

		if (validar && !validarCamposObligatorios()) {
		return;
		}

		let opcionesObjetoGasto = '';


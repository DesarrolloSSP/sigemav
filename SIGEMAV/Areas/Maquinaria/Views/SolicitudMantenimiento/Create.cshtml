		data: {

		unidadVehicularId: unidadVehicularId,

		conceptoServicioId: conceptoServicioId
		},

		success: function (data) {

		// ============================================
		// REFERENCIAS
		// ============================================

		const costoMO =
		parseFloat(data.costoManoObra || 0);

		const costoRef =
		parseFloat(data.costoRefacciones || 0);

		const selectMO =
		fila.find(".objetoGastoManoObra");

		const selectRef =
		fila.find(".objetoGastoRefacciones");

		const ayudaMO =
		fila.find(".ayudaManoObra");

		const ayudaRef =
		fila.find(".ayudaRefacciones");

		// ============================================
		// MANO DE OBRA
		// ============================================

		fila.find(".costoManoObra")
		.val(costoMO);

		fila.find(".costoManoObraVisual")
		.val(formatoMoneda(costoMO));

		// ============================================
		// REFACCIONES
		// ============================================

		fila.find(".costoRefacciones")
		.val(costoRef);

		fila.find(".costoRefaccionesVisual")
		.val(formatoMoneda(costoRef));




		// ============================================
		// VALIDAR MANO DE OBRA
		// ============================================

		recalcularImporteCotizacion();

		if (costoMO > 0) {

		selectMO.prop("required", true);

		ayudaMO
		.removeClass("text-muted text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");

		}
		else {

		selectMO.prop("required", false);

		selectMO.val("");

		ayudaMO
		.removeClass("text-danger text-success fw-bold")
		.addClass("text-muted")
		.text("No aplica");
		}

		// ============================================
		// VALIDAR REFACCIONES
		// ============================================

		if (costoRef > 0) {

		selectRef.prop("required", true);

		ayudaRef
		.removeClass("text-muted text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");

		}
		else {

		selectRef.prop("required", false);

		selectRef.val("");

		ayudaRef
		.removeClass("text-danger text-success fw-bold")
		.addClass("text-muted")
		.text("No aplica");
		}

		// ============================================
		// CAMBIO VISUAL MANO DE OBRA
		// ============================================

		selectMO.off("change").on("change", function () {

		if ($(this).val()) {

		ayudaMO
		.removeClass("text-danger")
		.addClass("text-success fw-bold")
		.text("Objeto seleccionado");
		}
		else if (costoMO > 0) {

		ayudaMO
		.removeClass("text-success")
		.addClass("text-danger fw-bold")
		.text("Requerido");
		}









		const partidaMO =
		fila.data("partida-manoobra");

		const partidaRef =
		fila.data("partida-refacciones");

		if (partidaMO) {
		selectMO.val(partidaMO);
		}

		if (partidaRef) {
		selectRef.val(partidaRef);
		}













		});

		// ============================================
		// CAMBIO VISUAL REFACCIONES




@model SIGEMAV.Models.ViewModels.Maquinaria.MantenimientoCreateViewModel

@* @{
    ViewData["Title"] = "Ingresar a taller";
} *@

<div class="container-fluid px-3">
    <div class="card shadow-sm border-0 rounded-3">
        
        <!-- ENCABEZADO PRINCIPAL -->
        <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center py-3 px-4">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-car-front-fill text-primary fs-4"></i>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        Ingreso de unidad a taller
                    </h5>
                    <small class="text-muted extra-small">
                        Confirmación operativa de inicio de mantenimiento
                    </small>
                </div>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-2 d-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Regresar</span>
            </a>
        </div>

        <div class="card-body p-4">

            <!-- ============================================== -->
            <!-- RESUMEN EJECUTIVO / INDICADORES CLAVE (KPIs) -->
            <!-- ============================================== -->
            <div class="row g-3 mb-4">
                
                <!-- FOLIO Y OFICIO -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 bg-light border rounded-3 h-100 d-flex flex-column justify-content-center">
                        <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                            Folio Solicitud
                        </div>
                        <div class="fs-4 fw-bold text-dark mb-1">
                            @Model.Folio
                        </div>
                        <div class="extra-small text-muted d-flex align-items-center gap-1">
                            <i class="bi bi-file-earmark-text"></i>
                            <span>Oficio: <strong>@Model.NumeroOficio</strong></span>
                        </div>
                    </div>
                </div>

                <!-- UNIDAD VEHICULAR -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 bg-light border rounded-3 h-100 d-flex flex-column justify-content-center">
                        <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                            Unidad Vehicular
                        </div>
                        <div class="fs-6 fw-bold text-dark text-truncate" title="@Model.UnidadTexto">
                            @Model.UnidadTexto
                        </div>
                        <div class="extra-small text-muted mt-1">
                            Vehículo asignado a la solicitud
                        </div>
                    </div>
                </div>

                <!-- KILOMETRAJE INGRESO -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 bg-light border rounded-3 h-100 d-flex flex-column justify-content-center">
                        <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                            Kilometraje de Ingreso
                        </div>
                        <div class="fs-4 fw-bold text-dark mb-0">
                            @Model.KilometrajeEntrada.ToString("N0") <span class="fs-6 fw-normal text-muted">km</span>
                        </div>
                        <div class="extra-small text-success mt-1 d-flex align-items-center gap-1">
                            <i class="bi bi-speedometer2"></i>
                            <span>Lectura capturada</span>
                        </div>
                    </div>
                </div>

                <!-- COSTO AUTORIZADO -->
                <div class="col-lg-3 col-md-6">
                    <div class="p-3 bg-light border rounded-3 h-100 d-flex flex-column justify-content-center">
                        <div class="text-uppercase text-muted extra-small fw-bold mb-1">
                            Costo Autorizado
                        </div>
                        <div class="fs-4 fw-bold text-primary mb-0">
                            @Model.Servicios.Sum(x => x.TotalEstimado).ToString("C")
                        </div>
                        <div class="extra-small text-muted mt-1">
                            Monto total presupuestado
                        </div>
                    </div>
                </div>

            </div>

            <!-- ============================================== -->
            <!-- DATOS OPERATIVOS Y TALLER -->
            <!-- ============================================== -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-light border-bottom py-3 px-4 d-flex align-items-center gap-2">
                    <i class="bi bi-building text-primary fs-6"></i>
                    <h6 class="fw-bold mb-0 text-dark">
                        Datos operativos del servicio
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row align-items-center g-3">
                        <div class="col-md-8">
                            <div class="text-uppercase text-muted extra-small fw-bold mb-1 text-black">
                                Taller Asignado
                            </div>
                            <div class="fs-6 fw-semibold text-dark">
                                <i class="bi bi-tools text-secondary me-2"></i>@Model.Taller
                            </div>
                        </div>
                        <div class="col-md-4 border-start-md ps-md-4">
                            <div class="text-uppercase text-muted extra-small fw-bold mb-1 text-black">
                                Estatus Operativo
                            </div>
                            <div>
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fs-6 fw-bold text-warning">
                                    <i class="bi bi-hourglass-split me-1"></i>Pendiente Ingreso
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- SERVICIOS AUTORIZADOS (TABLA) -->
            <!-- ============================================== -->
            <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden">
                <div class="card-header bg-light border-bottom d-flex justify-content-between align-items-center py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-wrench-adjustable text-primary fs-5"></i>
                        <h6 class="fw-bold mb-0 text-dark">
                            Servicios autorizados
                        </h6>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-1 rounded-pill">
                        @Model.Servicios.Count servicio(s)
                    </span>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light border-bottom text-uppercase extra-small text-muted fw-bold">
                                <tr>
                                    <th class="ps-4 py-3" style="min-width: 220px;">Servicio / Concepto</th>
                                    <th class="text-center py-3" style="width: 100px;">Cantidad</th>
                                    <th class="text-end py-3" style="width: 150px;">Mano de Obra</th>
                                    <th class="text-end py-3" style="width: 150px;">Refacciones</th>
                                    <th class="text-end py-3" style="width: 160px;">Total</th>
                                    <th class="pe-4 py-3" style="min-width: 200px;">Observaciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var servicio in Model.Servicios)
                                {
                                    <tr>
                                        <td class="ps-4 py-3 fw-semibold text-dark">
                                            @servicio.ConceptoServicio
                                        </td>
                                        <td class="text-center py-3">
                                            <span class="badge bg-light text-dark border px-2 py-1 fs-6 fw-normal">
                                                @servicio.Cantidad
                                            </span>
                                        </td>
                                        <td class="text-end py-3 text-secondary">
                                            @servicio.CostoEstimadoManoObra.ToString("C")
                                        </td>
                                        <td class="text-end py-3 text-secondary">
                                            @servicio.CostoEstimadoRefacciones.ToString("C")
                                        </td>
                                        <td class="text-end py-3 fw-bold text-dark">
                                            @servicio.TotalEstimado.ToString("C")
                                        </td>
                                        <td class="pe-4 py-3 text-muted small">
                                            @(string.IsNullOrWhiteSpace(servicio.Observaciones) ? "-" : servicio.Observaciones)
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light border-top fw-bold text-dark">
                                <tr>
                                    <td colspan="4" class="text-end py-3 ps-4 text-uppercase extra-small text-muted">
                                        Total Autorizado
                                    </td>
                                    <td class="text-end py-3 fs-6 text-primary">
                                        @Model.Servicios.Sum(x => x.TotalEstimado).ToString("C")
                                    </td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- IMPACTO DE LA ACCIÓN / CALLOUT -->
            <!-- ============================================== -->
            <div class="alert alert-info border-0 shadow-sm rounded-3 p-4 mb-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="p-2 bg-info bg-opacity-20 text-info rounded-3">
                        <i class="bi bi-cpu-fill fs-5 text-white"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-2 text-dark">
                            Efecto operativo del ingreso a taller
                        </h6>
                        <ul class="mb-0 text-muted small ps-3">
                            <li class="mb-1">Se generará el registro formal de orden de mantenimiento.</li>
                            <li class="mb-1">La solicitud actualizará automáticamente su estatus a <strong>En Mantenimiento</strong>.</li>
                            <li>Se habilitará el seguimiento técnico y bitácora de ejecución de trabajos.</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- ============================================== -->
            <!-- BOTONES DE ACCIÓN -->
            <!-- ============================================== -->
            <div class="d-flex justify-content-end align-items-center gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-2 fw-semibold">
                    Cancelar
                </a>

                <form asp-action="IngresarATaller" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="solicitudMantenimientoId" value="@Model.SolicitudMantenimientoId" />

                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-2 fw-semibold shadow-sm d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>Confirmar ingreso a taller</span>
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            const $form = $('#formRevision');

            // ================================================
            // APROBAR REVISIÓN
            // ================================================

            $('#btnAprobar').on('click', function () {

                Swal.fire({
                    title: '¿Aprobar revisión?',
                    text: 'La solicitud será autorizada y quedará registrada para seguimiento.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#800705',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, autorizar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {

                    if (!result.isConfirmed) {
                        return;
                    }

                    $('#aprobadaInput').val('true');

                    // El rechazo no requiere datos cuando se aprueba.
                    // Los valores existentes no se usan para autorizar.
                    $form.trigger('submit');
                });
            });

            // ================================================
            // RECHAZAR SOLICITUD
            // ================================================

            $('#btnRechazar').on('click', function () {

                const observaciones =
                    ($('#Observaciones').val() || '').trim();

                const tipoRechazo =
                    $('#tipoRechazoSelect').val();

                if (!observaciones) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Observaciones requeridas',
                        text: 'Debe indicar el motivo del rechazo.',
                        confirmButtonColor: '#800705'
                    });

                    $('#Observaciones').trigger('focus');
                    return;
                }

                if (!tipoRechazo) {

                    Swal.fire({
                        icon: 'warning',
                        title: 'Tipo de rechazo requerido',
                        text: 'Seleccione el tipo de rechazo.',
                        confirmButtonColor: '#800705'
                    });

                    $('#tipoRechazoSelect').trigger('focus');
                    return;
                }

                Swal.fire({
                    title: '¿Rechazar solicitud?',
                    text: 'La solicitud será rechazada y se procesará la liberación presupuestal que corresponda.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc3545',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Sí, rechazar',
                    cancelButtonText: 'Cancelar'
                }).then(function (result) {

                    if (!result.isConfirmed) {
                        return;
                    }

                    $('#aprobadaInput').val('false');

                    $form.trigger('submit');
                });
            });
        });
    </script>
}


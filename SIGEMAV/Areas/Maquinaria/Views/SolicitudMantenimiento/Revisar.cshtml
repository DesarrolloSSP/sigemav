@using SIGEMAV.Models.ViewModels.Maquinaria
@model RevisionSolicitudViewModel

<div class="card shadow-sm border-0">

	<div class="card-header bg-white">
		<div class="d-flex justify-content-between align-items-center">

			<h4 class="fw-bold mb-0">
				Revisión de solicitud de mantenimiento
			</h4>

			<div>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>
					Regresar

				</a>

			</div>

		</div>
	</div>


	@if (ViewBag.Error != null)
	{
		<div class="alert alert-danger alert-dismissible fade show"
			 role="alert">

			<i class="bi bi-exclamation-triangle-fill me-2"></i>

			@ViewBag.Error

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert">
			</button>

		</div>
	}



	<div class="card-body">

		<div class="row g-4">

			<!-- IZQUIERDA -->
			<div class="col-xl-9">

				<form asp-action="Revisar"
					  method="post"
					  id="formRevision">

					@Html.AntiForgeryToken()

					<input asp-for="SolicitudMantenimientoId" type="hidden" />

					<input asp-for="TipoRechazoSolicitudId"
						   id="hiddenTipoRechazo"
						   type="hidden" />

					<input asp-for="Observaciones"
						   id="hiddenObservaciones"
						   type="hidden" />

					<input type="hidden"
						   id="aprobadaInput"
						   name="aprobada" />


					<!-- DATOS -->
					<div class="card border mb-4">

						@* <div class="card-header border-bottom bg-white"> *@
						<div class="card-header"
							 style="background:#EEF2F7;
							border-bottom:1px solid #D6DCE5;">

							<h6 class="fw-bold mb-0">

								<i class="bi bi-file-earmark-text me-2 text-primary"></i>

								Datos generales de la solicitud

							</h6>

						</div>

						<div class="card-body">

							<div class="row g-4">

								<div class="col-md-3">
									<label class="text-muted small">Folio</label>
									<div class="fw-semibold">@Model.Folio</div>
								</div>

								<div class="col-md-3">
									<label class="text-muted small">Área</label>
									<div>@Model.AreaSolicitante</div>
								</div>

								<div class="col-md-3">
									<label class="text-muted small">Vehículo</label>
									<div>@Model.Vehiculo</div>
								</div>

								<div class="col-md-3">
									<label class="text-muted small">Taller</label>
									<div>@Model.Taller</div>
								</div>

							</div>

						</div>

					</div>


					<!-- CONCEPTOS -->

					<div class="card border mb-4">

						<div class="card-header"
							 style="background:#EEF2F7;
							border-bottom:1px solid #D6DCE5;">

							<div class="d-flex justify-content-between">

								<h6 class="fw-bold mb-0">

									<i class="bi bi-tools me-2 text-success"></i>

									Servicios solicitados

								</h6>

								<span class="badge bg-light text-dark">

									@Model.Conceptos.Count concepto(s)

								</span>

							</div>

						</div>

						<div class="card-body p-0">

							<table class="table table-hover mb-0">

								<thead style="background:#F8FAFC;">

									<tr>

										<th>Servicio</th>

										<th class="text-center">
											Cantidad
										</th>

										<th class="text-end">
											Mano de obra
										</th>

										<th class="text-end">
											Refacciones
										</th>

									</tr>

								</thead>

								<tbody>

									@foreach (var item in Model.Conceptos)
									{
										<tr>

											<td>@item.ConceptoServicioNombre</td>

											<td>@item.Cantidad</td>

											<td>
												@item.CostoEstimadoManoObra.ToString("C")
											</td>

											<td>
												@item.CostoEstimadoRefacciones.ToString("C")
											</td>

										</tr>
									}

								</tbody>

							</table>

						</div>

					</div>


					<!-- HISTORICO -->

					<div class="card border mb-4">

						<div class="card-header"
							 style="background:#EEF2F7;
							border-bottom:1px solid #D6DCE5;">

							<div class="d-flex justify-content-between">

								<div>

									<h6 class="fw-bold mb-0">

										<i class="bi bi-clock-history me-2 text-warning"></i>

										Historial de mantenimientos ejecutados

									</h6>

									<small class="text-muted">

										Base histórica para validación técnica

									</small>

								</div>

							</div>

						</div>

						<div class="card-body">

							@if (Model.HistorialTecnicoUnidad.Any())
							{

								<div class="table-responsive">

									<table class="table table-sm">

										<thead>

											<tr>

												<th>Fecha</th>
												<th>Servicio</th>
												<th>KM</th>
												<th>Costo</th>
												<th>Días</th>
												<th></th>

											</tr>

										</thead>

										<tbody>

											@foreach (var h in Model.HistorialTecnicoUnidad)
											{

												<tr>

													<td>
														@h.Fecha.ToString("dd/MM/yyyy")
													</td>

													<td>
														@h.Concepto
													</td>

													<td>
														@h.Kilometraje
													</td>

													<td>
														@h.Costo.ToString("C")
													</td>

													<td>
														@h.DiasDesdeUltimo
													</td>

													<td>

														@if (h.EsRecurrencia)
														{
															<span class="badge bg-danger">
																Recurrente
															</span>
														}

													</td>

												</tr>

											}

										</tbody>

									</table>

								</div>

							}

						</div>

					</div>


					<!-- DICTAMEN -->

					<div class="card border">

						<div class="card-header"
							 style="background:#EEF2F7;
							border-bottom:1px solid #D6DCE5;">

							<h6 class="fw-bold mb-0">

								<i class="bi bi-pencil-square me-2 text-danger"></i>

								Resolución de revisión técnica

							</h6>

						</div>

						<div class="card-body">

							<textarea asp-for="Observaciones"
									  rows="5"
									  class="form-control">
                    </textarea>

							<div class="mt-3">

								<select asp-for="TipoRechazoSolicitudId"
										asp-items="Model.TiposRechazo"
										class="form-select"
										id="tipoRechazoSelect">

									<option value="">
										Seleccione tipo rechazo
									</option>

								</select>

							</div>

						</div>

					</div>




					@if (Model.EstatusSolicitudMantenimientoId >= 5)
					{
						
							@if (Model.EstatusSolicitudMantenimientoId == 6)
							{
							<div class="d-flex justify-content-end gap-2 mt-4">

								@* <button id="btnRechazar"
										type="button"
										class="btn btn-danger">
									Rechazar
								</button> *@
								<button id="btnAprobar"
										type="button"
										class="btn btn-success">
									Autorizar revisión
								</button>
							</div>
							}
							else
							{
							<div class="d-flex justify-content-end gap-2 mt-4">
								<button type="button" class="btn btn-secondary" disabled>
									<i class="bi bi-lock-fill me-1"></i>
									Solicitud ya autorizada
								</button>
							</div>
							}
					}
					else
					{
						<div class="d-flex justify-content-end gap-2 mt-4">

							<button id="btnRechazar"
									type="button"
									class="btn btn-danger">
								Rechazar
							</button>
							<button id="btnAprobar"
									type="button"
									class="btn btn-success">
								Autorizar revisión
							</button>
						</div>
					}





                    

				</form>

			</div>


			<!-- PANEL DERECHO FLEET -->
			<div class="col-lg-3">

				<div class="sticky-top" style="top:20px;">

					<div class="card border shadow-sm">

						<div class="card-header text-white" style="background:#243447;">

							<div>

								<h5 class="mb-0">
									<i class="bi bi-clipboard2-pulse me-2"></i>
									Panel de apoyo para revisión técnica
								</h5>

								<small class="opacity-75">
									Explicación automática para soporte de decisión de mantenimiento
								</small>

							</div>

						</div>

						<div class="card-body">

							<!-- VARIABLES -->
							@{

								//viene de MantenimientoDetalle
								var recurrencias = Model.HistorialTecnicoUnidad.Count(x => x.EsRecurrencia);

								// viene de MantenimientoDetalle y mantenimiento registrado en <= 30 dias
								var mantenimientoReciente = Model.ResumenHistorico?.UltimaFecha != null &&
								(DateTime.Now - Model.ResumenHistorico.UltimaFecha.Value).TotalDays <= 30;

								// Información descriptiva (todavía NO participa en la decisión)
								var tieneInversionAcumulada =
									Model.ResumenHistorico != null &&
									Model.ResumenHistorico.CostoAcumulado > 0;

								/*
									Riesgo operativo:
									- Alto → recurrencia repetitiva
									- Medio → falta de mantenimiento reciente
									- Bajo → comportamiento estable

									Nota:
									El costo acumulado se conserva como contexto
									pero deja de determinar el riesgo automáticamente.
								*/

								//si servicios realizados iguales >= 3
								var riesgoAlto = recurrencias >= 3;

								//
								var riesgoMedio = !riesgoAlto && !mantenimientoReciente;
							}

							<!-- ESTADO GLOBAL -->
							<h6 class="text-black">🚨 Estado de la unidad</h6>

							@if (riesgoAlto)
							{
								<div class="alert alert-danger py-2">
									🔴 Requiere intervención
								</div>
							}
							else if (riesgoMedio)
							{
								<div class="alert alert-warning py-2">
									🟠 Requiere revisión preventiva
								</div>
							}
							else
							{
								<div class="alert alert-success py-2">
									🟢 Condición estable
								</div>
							}

							<hr />

							<!-- EXPLICACIÓN DE DECISIÓN -->
							<h6>Explicación de decisión</h6>

							<div class="small">

								<ul class="list-unstyled mb-0">

									<li class="mb-2">
										<strong>Recurrencias:</strong>
										@recurrencias
										<div class="text-muted">
											Indica repetición de fallas o servicios similares en la unidad.
										</div>
									</li>

									<li class="mb-2">
										<strong>Último mantenimiento:</strong>
										@(Model.ResumenHistorico?.UltimaFecha?.ToString("dd/MM/yyyy") ?? "N/A")
										<div class="text-muted">
											@(mantenimientoReciente
												? "La unidad ha recibido mantenimiento recientemente."
												: "No hay mantenimiento reciente, lo que incrementa el riesgo operativo.")
										</div>
									</li>

									<li class="mb-2">

										<strong>Nivel de inversión acumulada:</strong>
										@Model.ResumenHistorico?.CostoAcumulado.ToString("C")

										<div class="text-muted">
											@(tieneInversionAcumulada
												? "Representa el gasto histórico registrado para la unidad y sirve como referencia durante la revisión técnica."
												: "No existe historial de inversión registrado para esta unidad.")
										</div>

									</li>

								</ul>

							</div>

							@*  <hr />

                            <!-- INTERPRETACIÓN FINAL -->
                            <h6 class="fw-bold">Conclusión operativa</h6>

                            <div class="text-center">

                                @if (riesgoAlto)
                                {
                                    <div class="badge bg-danger fs-6">
                                        REVISIÓN OBLIGATORIA
                                    </div>
                                    <div class="small mt-2">
                                        Se recomienda validar la viabilidad del mantenimiento antes de aprobar.
                                    </div>
                                }
                                else if (riesgoMedio)
                                {
                                    <div class="badge bg-warning fs-6">
                                        REVISIÓN PREVENTIVA
                                    </div>
                                    <div class="small mt-2">
                                        Se sugiere inspección antes de autorizar nuevos trabajos.
                                    </div>
                                }
                                else
                                {
                                    <div class="badge bg-success fs-6">
                                        APROBACIÓN SEGURA
                                    </div>
                                    <div class="small mt-2">
                                        La unidad presenta condiciones estables.
                                    </div>
                                }

                            </div> *@

						</div>

					</div>

				</div>

			</div>




		</div>

	</div>

</div>





@section Scripts {
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


	<script>

		$(document).ready(function () {

		// APROBAR

		$('#btnAprobar').click(function () {

		const observaciones =
		$('#Observaciones').val();

		$('#hiddenObservaciones')
		.val(observaciones);

		Swal.fire({

		title: '¿Aprobar revisión?',

		text: 'La solicitud será autorizada y quedará registrada para seguimiento.',

		icon: 'question',

		showCancelButton: true,

		confirmButtonColor: '#800705',

		cancelButtonColor: '#6c757d',

		confirmButtonText: 'Sí, autorizar',

		cancelButtonText: 'Cancelar'

		}).then((result) => {

		if (result.isConfirmed) {

		$('#aprobadaInput').val('true');

		$('#formRevision').submit();
		}

		});

		});

		// RECHAZAR

		$('#btnRechazar').click(function () {

		const observaciones =
		$('#Observaciones').val();

		const tipoRechazo =
		$('#tipoRechazoSelect').val();

		if (!observaciones.trim()) {

		Swal.fire({

		icon: 'warning',

		title: 'Observaciones requeridas',

		text: 'Debe indicar el motivo del rechazo.',

		confirmButtonColor: '#800705'
		});

		return;
		}

		if (!tipoRechazo) {

		Swal.fire({

		icon: 'warning',

		title: 'Tipo rechazo requerido',

		text: 'Seleccione el tipo de rechazo.',

		confirmButtonColor: '#800705'
		});

		return;
		}

		$('#hiddenObservaciones')
		.val(observaciones);

		$('#hiddenTipoRechazo')
		.val(tipoRechazo);

		Swal.fire({

		title: '¿Rechazar solicitud?',

		text: 'La solicitud será rechazada y quedará registrada para seguimiento.',

		icon: 'info',

		showCancelButton: true,

		confirmButtonColor: '#dc3545',

		cancelButtonColor: '#6c757d',

		confirmButtonText: 'Sí, rechazar',

		cancelButtonText: 'Cancelar'

		}).then((result) => {

		if (result.isConfirmed) {

		$('#aprobadaInput').val('false');

		$('#formRevision').submit();
		}

		});

		});

		});

	</script>



}

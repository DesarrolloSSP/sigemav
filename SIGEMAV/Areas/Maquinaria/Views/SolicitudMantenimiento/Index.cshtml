@model SIGEMAV.Models.ViewModels.Maquinaria.PaginacionViewModel<SIGEMAV.Models.ViewModels.Maquinaria.SolicitudMantenimientoViewModel >

@* @{
	ViewData["Title"] = "Solicitudes de Mantenimiento";
}
 *@
<div class="container-fluid px-2 px-md-3">
	<div class="card shadow-sm border-0 w-100">

		<div class="card-header bg-white d-flex justify-content-between align-items-center">

			<div>

				<h4 class="fw-bold mb-0">
					Solicitudes de mantenimiento
				</h4>

				<small class="text-muted">
					Gestión administrativa y seguimiento de solicitudes
				</small>

			</div>

			<div>

				<a asp-action="Create"
				   class="btn text-light"
				   style="background-color:#800705">

					<i class="bi bi-plus-circle me-1"></i>
					Nueva solicitud

				</a>

			</div>

		</div>

		<div class="card-body">

			@if (!Model.Registros.Any())
			{
				<div class="alert alert-info text-center mb-0">

					<i class="bi bi-info-circle me-2"></i>
					No existen solicitudes registradas.

				</div>
			}
			else
			{
				<div class="w-100">

					<table class="table table-hover align-middle table-sm" style="width:100%; font-size:0.88rem;">


						<thead class="table-light">

							<tr>

								<th>Folio</th>

								<th>Oficio</th>

								<th>Fecha</th>

								<th>Área</th>

								<th>Unidad</th>

								<th>Vehículo</th>

								<th>Tipo</th>

								<th>Taller</th>

								<th>Cotización</th>

								<th>Servicios</th>

								<th>Estatus</th>

								<th class="text-center"
									style="width:180px;">

									Acciones

								</th>

							</tr>

						</thead>

						<tbody>

							@foreach (var item in Model.Registros)
							{
								<tr>

									<td class="fw-semibold">
										@item.Folio
									</td>

									<td>
										@item.NumeroOficio
									</td>

									<td>
										@item.FechaSolicitud.ToString("dd/MM/yyyy")
									</td>

									<td>
										@item.AreaSolicitante
									</td>

									<td>

										<div class="fw-bold">
											@item.NumeroSerie
										</div>

										<small class="text-muted">
											@item.PlacaActual
										</small>

									</td>

									<td>

										@item.MarcaNombre
										@item.ModeloNombre

									</td>

									<td>
										@item.TipoMantenimiento
									</td>

									<td>
										@item.TallerNombre
									</td>

									<td>

										@if (item.ImporteCotizacion.HasValue)
										{
											<span class="fw-semibold">
												@item.ImporteCotizacion.Value.ToString("C")
											</span>
										}
										else
										{
											<span class="text-muted">
												Pendiente
											</span>
										}

									</td>






									<td>

										@if (item.TotalConceptos == 0)
										{
											<span class="badge bg-danger">
												Sin servicios
											</span>
										}
										else
										{
											<span class="badge bg-success">

												@item.TotalConceptos servicios

											</span>
										}

									</td>








									<td>

										<span class="badge bg-@item.ColorEstatus">

											@item.Estatus

										</span>

									</td>

									@* <td class="text-center">

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                               asp-route-id="@item.SolicitudMantenimientoId"
                                               class="btn btn-outline-secondary btn-sm"
                                               title="Detalle">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                               asp-route-id="@item.SolicitudMantenimientoId"
                                               class="btn btn-outline-primary btn-sm"
                                               title="Editar">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="Delete"
                                               asp-route-id="@item.SolicitudMantenimientoId"
                                               class="btn btn-outline-danger btn-sm"
                                               title="Eliminar">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td> *@






									<td class="text-center">

										<div class="btn-group" role="group">

											<!-- Details -->
											<a asp-action="Detalle"
											   asp-route-id="@item.SolicitudMantenimientoId"
											   class="btn btn-outline-dark btn-sm"
											   title="Detalle">

												<i class="bi bi-list-check"></i>

											</a>


												<!-- DSP -->
											<a asp-action="DSP"
											   asp-route-id="@item.SolicitudMantenimientoId"
											   class="btn btn-outline-success btn-sm"
											   title="DSP">

												<i class="bi bi-cash-stack"></i>

											</a>



											<!-- Revisión -->
											<a asp-action="Revisar"
											   asp-route-id="@item.SolicitudMantenimientoId"
											   class="btn btn-outline-primary btn-sm"
											   title="Revisión">

												<i class="bi bi-clipboard-check"></i>

											</a>

										


											@if (item.EstatusSolicitudMantenimientoId == 5)
											{
												<a asp-action="IngresarATaller"
												   asp-route-id="@item.SolicitudMantenimientoId"
												   class="btn btn-outline-dark btn-sm"
												   title="Ingresar al taller">

													<i class="bi bi-car-front-fill"></i>
												</a>
											}


											@if (item.EstatusSolicitudMantenimientoId == 7)
											{
												<a asp-controller="Mantenimiento"
												asp-action="Edit"
												asp-route-solicitudId="@item.SolicitudMantenimientoId"
												class="btn btn-outline-primary btn-sm"
												title="Administrar mantenimiento">

													<i class="bi bi-wrench-adjustable"></i>

												</a>
											}



											<!-- Editar -->
											<a asp-action="Edit"
											   asp-route-id="@item.SolicitudMantenimientoId"
											   class="btn btn-outline-secondary btn-sm"
											   title="Editar">

												<i class="bi bi-pencil-square"></i>

											</a>

										</div>

									</td>







								</tr>
							}

						</tbody>

					</table>

				</div>

				<div class="d-flex justify-content-between align-items-center mt-4">

					<div class="text-muted small">
						Mostrando
						<strong>@Model.Registros.Count</strong>
						de
						<strong>@Model.TotalRegistros</strong>
						registros
					</div>

					<nav>

						<ul class="pagination pagination-sm mb-0">

							<!-- Primera -->
							<li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
								<a class="page-link"
								   asp-route-pagina="1">
									<i class="bi bi-chevron-double-left"></i>
								</a>
							</li>

							<!-- Anterior -->
							<li class="page-item @(!Model.TieneAnterior ? "disabled" : "")">
								<a class="page-link"
								   asp-route-pagina="@(Model.PaginaActual - 1)">
									<i class="bi bi-chevron-left"></i>
								</a>
							</li>

							@{
								int inicio = Math.Max(1, Model.PaginaActual - 2);
								int fin = Math.Min(Model.TotalPaginas, Model.PaginaActual + 2);
							}

							@for (int i = inicio; i <= fin; i++)
							{
								<li class="page-item @(i == Model.PaginaActual ? "active" : "")">

									<a class="page-link"
									   asp-route-pagina="@i">
										@i
									</a>

								</li>
							}

							<!-- Siguiente -->
							<li class="page-item @(!Model.TieneSiguiente ? "disabled" : "")">
								<a class="page-link"
								   asp-route-pagina="@(Model.PaginaActual + 1)">
									<i class="bi bi-chevron-right"></i>
								</a>
							</li>

							<!-- ultima -->
							<li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
								<a class="page-link"
								   asp-route-pagina="@Model.TotalPaginas">
									<i class="bi bi-chevron-double-right"></i>
								</a>
							</li>

						</ul>

					</nav>

				</div>
			}

		</div>

	</div>
</div>


@section Scripts {

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	@if (TempData["Success"] != null)
	{
		<script>

			Swal.fire({

			icon: 'success',

			title: 'Operación realizada',

			text: '@TempData["Success"]',

			confirmButtonColor: '#800705'

			});

		</script>
	}

}
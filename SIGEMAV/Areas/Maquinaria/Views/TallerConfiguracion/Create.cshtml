

@model SIGEMAV.Models.ViewModels.Maquinaria.TallerConfiguracionCreateViewModel


<div class="card shadow-sm">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div class="card-header bg-light">

        <h4 class="mb-1">
            <i class="mdi mdi-link-variant me-2"></i>
            Asociar taller
        </h4>

        <div class="text-muted">
            Asigne una configuración presupuestal al taller seleccionado.
        </div>

    </div>


    <!-- ===================================================== -->
    <!-- FORMULARIO -->
    <!-- ===================================================== -->

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- ================================================= -->
            <!-- TALLER -->
            <!-- ================================================= -->

            <div class="mb-4">

                <label asp-for="TallerId"
                       class="form-label fw-semibold">
                </label>

                <select asp-for="TallerId"
                        asp-items="Model.Talleres"
                        class="form-select">

                    <option value="">
                        -- Seleccione un taller --
                    </option>

                </select>

                <span asp-validation-for="TallerId"
                      class="text-danger">
                </span>

                <div class="form-text">
                    Solo se muestran talleres activos que no tienen
                    una configuración presupuestal activa.
                </div>

            </div>


            <!-- ================================================= -->
            <!-- CONFIGURACIÓN PRESUPUESTAL -->
            <!-- ================================================= -->

            <div class="mb-4">

                <label asp-for="TallerConfiguracionPresupuestalId"
                       class="form-label fw-semibold">
                </label>

                <select asp-for="TallerConfiguracionPresupuestalId"
                        asp-items="Model.ConfiguracionesPresupuestales"
                        class="form-select">

                    <option value="">
                        -- Seleccione una configuración --
                    </option>

                </select>

                <span asp-validation-for="TallerConfiguracionPresupuestalId"
                      class="text-danger">
                </span>

                <div class="form-text">
                    La misma configuración presupuestal puede utilizarse
                    en varios talleres.
                </div>

            </div>


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <div class="form-check form-switch mb-4">

                <input asp-for="Activo"
                       class="form-check-input"
                       type="checkbox" />

                <label asp-for="Activo"
                       class="form-check-label">
                </label>

            </div>


            <!-- ================================================= -->
            <!-- ACCIONES -->
            <!-- ================================================= -->

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="mdi mdi-arrow-left me-1"></i>
                    Cancelar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="mdi mdi-content-save me-1"></i>
                    Asociar taller

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@using SIGEMAV.Areas.Maquinaria.DTOs
@model IEnumerable<TallerConfiguracionDto>


<div class="card shadow-sm">

    <!-- ===================================================== -->
    <!-- ENCABEZADO -->
    <!-- ===================================================== -->

    <div class="card-header bg-light">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h4 class="mb-1">
                    <i class="mdi mdi-link-variant me-2"></i>
                    Configuración de talleres y presupuestos
                </h4>

                <div class="text-muted">
                    Asociación de talleres con su configuración presupuestal.
                </div>

            </div>

            <div>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="mdi mdi-plus me-1"></i>
                    Asociar taller

                </a>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- INFORMACIÓN -->
    <!-- ===================================================== -->

    <div class="card-body border-bottom">

        <div class="alert alert-info mb-0">

            <i class="mdi mdi-information-outline me-2"></i>

            Cada taller utiliza una configuración presupuestal.
            Una misma configuración puede estar asociada a varios talleres.

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <div class="card-body">

        @if (Model.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Taller
                            </th>

                            <th>
                                RFC
                            </th>

                            <th>
                                Ubicación
                            </th>

                            <th>
                                Contrato
                            </th>

                            <th>
                                Recurso
                            </th>

                            <th class="text-end">
                                Monto máximo
                            </th>

                            <th class="text-center">
                                Estado
                            </th>

                            <th class="text-center">
                                Acciones
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    <div class="fw-semibold">
                                        @item.TallerNombre
                                    </div>

                                </td>

                                <td>
                                    @item.RFC
                                </td>

                                <td>
                                    @item.Ubicacion
                                </td>

                                <td>
                                    @item.Contrato
                                </td>

                                <td>
                                    @item.RecursoNombre
                                </td>

                                <td class="text-end">

                                    @item.MontoMaximo.ToString(
                                        "C2",
                                        new System.Globalization.CultureInfo("es-MX"))

                                </td>

                                <td class="text-center">

                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">
                                            <i class="mdi mdi-check-circle me-1"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="mdi mdi-close-circle me-1"></i>
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                  @*   <a asp-action="Edit"
                                       asp-route-id="@item.TallerId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Editar">

                                        <i class="bi bi-pencil-square"></i>

                                    </a> *@


                                    <a asp-action="Edit"
                                       asp-route-tallerId="@item.TallerId"
                                       asp-route-configuracionId="@item.TallerConfiguracionPresupuestalId"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Editar">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-5">

                <i class="mdi mdi-link-variant-off display-4 text-muted"></i>

                <h5 class="mt-3">
                    No existen asociaciones registradas
                </h5>

                <p class="text-muted mb-4">
                    Actualmente no hay talleres asociados a una configuración presupuestal.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="mdi mdi-plus me-1"></i>
                    Asociar taller

                </a>

            </div>
        }

    </div>

</div>
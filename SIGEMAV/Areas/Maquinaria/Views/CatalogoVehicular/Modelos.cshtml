@model SIGEMAV.Models.ViewModels.Maquinaria.ModeloIndexViewModel


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-truck me-2"></i>Catálogo de modelos</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearModelo">
            <i class="bi bi-plus-circle me-1"></i> Nuevo modelo
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaModelos">
                    <thead class="table-light">
                        <tr>
                            @* <th>ID</th> *@
                            <th>Marca</th>
                            <th>Modelo</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Modelos)
                        {
                            <tr>
                                @* <td>@item.ModeloId</td> *@
                                <td><span class="badge bg-light text-dark border">@item.MarcaNombre</span></td>
                                <td class="fw-semibold">@item.ModeloNombre</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarModelo(@item.ModeloId, @item.MarcaId, '@item.ModeloNombre', @item.Activo.ToString().ToLower())">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarModelo" asp-route-id="@item.ModeloId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas desactivar este modelo?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Modelo -->
<div class="modal fade" id="modalCrearModelo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="ModeloCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo modelo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Marca</label>
                    <select name="marcaId" class="form-select" asp-items="Model.MarcasSelectList" required>
                        <option value="">-- Seleccione una marca --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre del modelo</label>
                    <input type="text" name="modeloNombre" class="form-control" required maxlength="100" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Modelo -->
<div class="modal fade" id="modalEditarModelo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <!-- Corregido: asp-action apunta a ModeloEditar -->
        <form asp-action="ModeloEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="modeloId" id="editModeloId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar modelo</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Marca</label>
                    <select name="marcaId" id="editModeloMarcaId" class="form-select" asp-items="Model.MarcasSelectList" required>
                        <option value="">-- Seleccione una marca --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nombre del modelo</label>
                    <input type="text" name="modeloNombre" id="editModeloNombre" class="form-control" required maxlength="100" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activo" id="editModeloActivo" value="true">
                    <label class="form-check-label" for="editModeloActivo">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-modelos.js" asp-append-version="true"></script>
}
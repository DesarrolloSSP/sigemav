@using System.Text.Encodings.Web
@model SIGEMAV.Models.ViewModels.Maquinaria.TransmisionIndexViewModel


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-gear-wide-connected me-2"></i>Catálogo de transmisiones</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearTransmision">
            <i class="bi bi-plus-circle me-1"></i> Nueva transmisión
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaTransmisiones">
                    <thead class="table-light">
                        <tr>
                            @* <th>ID</th> *@
                            <th>Nombre de la transmisión</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Transmisiones)
                        {
                            <tr>
                                @* <td>@item.TransmisionId</td> *@
                                <td class="fw-semibold">@item.TransmisionNombre</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarTransmision(@item.TransmisionId, '@Html.Raw(JavaScriptEncoder.Default.Encode(item.TransmisionNombre))', @item.Activo.ToString().ToLower())">
                                        @* onclick="abrirModalEditarTransmision(@item.TransmisionId, '@item.TransmisionNombre', @item.Activo.ToString().ToLower())"> *@


                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarTransmision" asp-route-id="@item.TransmisionId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas desactivar esta transmisión?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Transmisión -->
<div class="modal fade" id="modalCrearTransmision" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="TransmisionCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nueva transmisión</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de la transmisión</label>
                    <input type="text" name="transmisionNombre" class="form-control" required maxlength="100" placeholder="Ej. Automática, Estándar, CVT..." />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Transmisión -->
<div class="modal fade" id="modalEditarTransmision" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="TransmisionEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="transmisionId" id="editTransmisionId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar transmisión</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de la transmisión</label>
                    <input type="text" name="transmisionNombre" id="editTransmisionNombre" class="form-control" required maxlength="100" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activo" id="editTransmisionActivo" value="true">
                    <label class="form-check-label" for="editTransmisionActivo">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-transmisiones.js" asp-append-version="true"></script>
}



@model SIGEMAV.Models.ViewModels.Maquinaria.ColorIndexViewModel

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-palette me-2"></i>Catálogo de colores</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearColor">
            <i class="bi bi-plus-circle me-1"></i> Nuevo color
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaColores">
                    <thead class="table-light">
                        <tr>
                            @* <th>ID</th> *@
                            <th>Nombre del color</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Colores)
                        {
                            <tr>
                                @* <td>@item.ColorId</td> *@
                                <td class="fw-semibold">@item.ColorNombre</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarColor(@item.ColorId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.ColorNombre))', @item.Activo.ToString().ToLower())">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarColor" asp-route-id="@item.ColorId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas desactivar este color?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Color -->
<div class="modal fade" id="modalCrearColor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="ColorCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo color</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del color</label>
                    <input type="text" name="colorNombre" class="form-control" required maxlength="50" placeholder="Ej. Blanco, Rojo, Azul perla..." />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Color -->
<div class="modal fade" id="modalEditarColor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="ColorEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="colorId" id="editColorId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar color</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre del color</label>
                    <input type="text" name="colorNombre" id="editColorNombre" class="form-control" required maxlength="50" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activo" id="editColorActivo" value="true">
                    <label class="form-check-label" for="editColorActivo">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-colores.js" asp-append-version="true"></script>
}




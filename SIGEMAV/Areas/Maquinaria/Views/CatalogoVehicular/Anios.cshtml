@model SIGEMAV.Models.ViewModels.Maquinaria.AnioIndexViewModel


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Catálogo de años</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearAnio">
            <i class="bi bi-plus-circle me-1"></i> Nuevo año
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaAnios">
                    <thead class="table-light">
                        <tr>
                            @* <th>ID</th> *@
                            <th>Descripción / Año</th>
                            <th>Fecha de creación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Anios)
                        {
                            <tr>
                                @* <td>@item.AnioId</td> *@
                                <td class="fw-semibold">@item.AnioDescripcion</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarAnio(@item.AnioId, '@item.AnioDescripcion', @item.Activo.ToString().ToLower())">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarAnio" asp-route-id="@item.AnioId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas desactivar este año?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Desactivar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Año -->
<div class="modal fade" id="modalCrearAnio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AnioCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo año</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Descripción del año</label>
                    <input type="text" name="anioDescripcion" class="form-control" required maxlength="50" placeholder="Ej. 2026" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Año -->
<div class="modal fade" id="modalEditarAnio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="AnioEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="anioId" id="editAnioId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar año</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Descripción del año</label>
                    <input type="text" name="anioDescripcion" id="editAnioDescripcion" class="form-control" required maxlength="50" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="activo" id="editAnioActivo" value="true">
                    <label class="form-check-label" for="editAnioActivo">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-anios.js" asp-append-version="true"></script>
}
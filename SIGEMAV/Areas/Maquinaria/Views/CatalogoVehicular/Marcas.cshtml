@model SIGEMAV.Models.ViewModels.Maquinaria.MarcaIndexViewModel


<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-tags me-2"></i>Catálogo de marcas</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearMarca">
            <i class="bi bi-plus-circle me-1"></i> Nueva marca
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaMarcas">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre de la Marca</th>
                            <th>Fecha Creación</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Se itera sobre Model.Marcas en lugar de Model directamente -->
                        @foreach (var item in Model.Marcas)
                        {
                            <tr>
                                <td>@item.MarcaId</td>
                                <td class="fw-semibold">@item.MarcaNombre</td>
                                <td>@item.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarMarca(@item.MarcaId, '@item.MarcaNombre', @item.Activo.ToString().ToLower())">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarMarca" asp-route-id="@item.MarcaId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas desactivar esta marca?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar / Desactivar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Marca -->
<div class="modal fade" id="modalCrearMarca" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="MarcaCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nueva marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de la marca</label>
                    <input type="text" name="MarcaNombre" class="form-control" required maxlength="100" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Marca -->
<div class="modal fade" id="modalEditarMarca" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="MarcaEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MarcaId" id="editMarcaId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar marca</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nombre de la marca</label>
                    <input type="text" name="MarcaNombre" id="editMarcaNombre" class="form-control" required maxlength="100" />
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="Activo" id="editMarcaActivo" value="true">
                    <label class="form-check-label" for="editMarcaActivo">Activo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-marcas.js" asp-append-version="true"></script>
}
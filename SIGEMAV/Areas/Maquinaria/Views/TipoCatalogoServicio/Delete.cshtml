@using SIGEMAV.Models.ViewModels.Maquinaria


@model TipoCatalogoServicioDeleteViewModel

@{
    ViewData["Title"] = "Eliminar Tipo Catálogo";
}

<div class="container-fluid">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="fw-bold mb-0 text-danger">
                        Eliminar tipo de catálogo
                    </h4>

                    <small class="text-muted">
                        Confirmación de eliminación lógica
                    </small>

                </div>

                <div>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-1"></i>
                        Regresar

                    </a>

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle me-2"></i>

                Está a punto de eliminar el siguiente registro.

            </div>

            <dl class="row">

             @*    <dt class="col-sm-3">
                    Id
                </dt> *@

         @*        <dd class="col-sm-9">
                    @Model.TipoCatalogoServicioId
                </dd>
 *@
                <dt class="col-sm-3">
                    Nombre
                </dt>

                <dd class="col-sm-9">
                    @Model.TipoCatalogoServicioNombre
                </dd>

                <dt class="col-sm-3">
                    Estatus
                </dt>

                <dd class="col-sm-9">

                    @if (Model.Activo)
                    {
                        <span class="badge bg-success">
                            Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Inactivo
                        </span>
                    }

                </dd>

            </dl>

            <hr />

            <form asp-action="Delete" method="post"id="formDelete">

                @Html.AntiForgeryToken()

                <input asp-for="TipoCatalogoServicioId" type="hidden" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Eliminar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $('#formDelete').submit(function (e) {

        e.preventDefault();

        const form = this;

        Swal.fire({

        title: '¿Eliminar registro?',

        text: 'El registro será desactivado.',

        icon: 'warning',

        showCancelButton: true,

        confirmButtonColor: '#dc3545',

        cancelButtonColor: '#6c757d',

        confirmButtonText: 'Sí, eliminar',

        cancelButtonText: 'Cancelar'

        }).then((result) => {

        if (result.isConfirmed) {

        form.submit();
        }

        });

        });

        });

    </script>

}



@using SIGEMAV.Models.ViewModels.Maquinaria

@model ConfiguracionValidacionTecnicaIndexViewModel

<div class="container">

    <div class="card shadow-sm">

        <!-- HEADER -->
        <div class="card-header text-white" style="background:#800705">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">
                    Configuración de validación técnica
                </h5>

                <a asp-action="Edit"
                   class="btn btn-light btn-sm">
                    + Nuevo
                </a>

            </div>

        </div>

        <!-- BODY -->
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>
                            <th>Tipo catálogo</th>
                            <th>Concepto</th>
                            <th>Solicitudes abiertas</th>
                            <th>Recurrencia</th>
                            <th>Días</th>
                            <th>Estados afectados</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Items == null || !Model.Items.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted">
                                    No existen configuraciones registradas
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @item.TipoCatalogoServicioNombre
                                    </td>

                                    <td>
                                        @item.ConceptoServicioNombre
                                    </td>

                                    <td>
                                        @Html.Raw(item.ValidarSolicitudesAbiertas
                                                ? "<span class='badge bg-success'>Sí</span>"
                                                : "<span class='badge bg-secondary'>No</span>"
                                        )
                                    </td>

                                    <td>
                                        @Html.Raw(
                                            item.ValidarRecurrencia
                                                ? "<span class='badge bg-success'>Sí</span>"
                                                : "<span class='badge bg-secondary'>No</span>"
                                        )
                                    </td>

                                    <td>
                                        @(item.DiasRecurrencia ?? 0)
                                    </td>

                                    <td>
                                        @Html.Raw(
                                        @item.EstatusSolicitudMantenimientoNombre ?? "-"
                                        )
                                    </td>

                                    <td>
                                        @if (item.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ConfiguracionValidacionTecnicaId"
                                           class="btn btn-sm btn-primary">
                                            Editar
                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


</div>



@model SIGEMAV.Models.ViewModels.Maquinaria.MunicipioIndexViewModel

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0"><i class="bi bi-geo-alt me-2"></i>Catálogo de municipios</h3>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalCrearMunicipio">
            <i class="bi bi-plus-circle me-1"></i> Nuevo municipio
        </button>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="tablaMunicipios">
                    <thead class="table-light">
                        <tr>
                            @* <th>ID</th> *@
                            <th>Nombre</th>
                            <th>Cve Municipio</th>
                            <th>Zona</th>
                            <th>Delegación</th>
                            <th>Región</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Municipios)
                        {
                            <tr>
                                @* <td>@item.MunicipioId</td> *@
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.CveMun</td>
                                <td>@item.Zona</td>
                                <td>@item.Delegacion</td>
                                <td>@item.TcmunicipioRegion</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1"
                                            onclick="abrirModalEditarMunicipio(@item.MunicipioId, '@Html.Raw(System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.Nombre ?? ""))', '@item.CveMun', '@item.CveZona', '@item.Zona', '@item.CveDeleg', '@item.Delegacion', @((item.TcmunicipioAlerta ?? false).ToString().ToLower()), @((item.TcmunicipioIndigena ?? false).ToString().ToLower()), '@item.TcmunicipioRegion', @((item.TcmunicipioCpdh ?? false).ToString().ToLower()))">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="EliminarMunicipio" asp-route-id="@item.MunicipioId" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Seguro que deseas eliminar este municipio?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Crear Municipio -->
<div class="modal fade" id="modalCrearMunicipio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-action="MunicipioCrear" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title">Nuevo municipio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre del municipio</label>
                    <input type="text" name="Nombre" class="form-control" required maxlength="150" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Clave municipio (CveMunicipio)</label>
                    <input type="text" name="CveMun" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cve Zona</label>
                    <select name="CveZona" class="form-select">
                        <option value="">Seleccione...</option>
                        <option value="1">CENTRO</option>
                        <option value="2">NORTE</option>
                        <option value="3">SUR</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Nombre de Zona</label>
                    <input type="text" name="Zona" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cve Delegación</label>
                    <select name="CveDeleg" class="form-select">
                        <option value="">Seleccione...</option>
                        @for (int i = 1; i <= 24; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Nombre de Delegación</label>
                    <input type="text" name="Delegacion" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Región</label>
                    <input type="text" name="TcmunicipioRegion" class="form-control" maxlength="100" />
                </div>
                @* <div class="col-md-6 d-flex align-items-center gap-3 pt-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="TcmunicipioAlerta" value="true" id="crearAlerta">
                        <label class="form-check-label" for="crearAlerta">Alerta</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="TcmunicipioIndigena" value="true" id="crearIndigena">
                        <label class="form-check-label" for="crearIndigena">Indígena</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="TcmunicipioCpdh" value="true" id="crearCpdh">
                        <label class="form-check-label" for="crearCpdh">CPDH</label>
                    </div>
                </div> *@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Editar Municipio -->
<div class="modal fade" id="modalEditarMunicipio" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form asp-action="MunicipioEditar" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MunicipioId" id="editMunicipioId" />
            <div class="modal-header">
                <h5 class="modal-title">Editar Municipio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre del Municipio</label>
                    <input type="text" name="Nombre" id="editNombre" class="form-control" required maxlength="150" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Clave Municipio (CveMun)</label>
                    <input type="text" name="CveMun" id="editCveMun" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cve Zona</label>
                    <!-- Agregado: id="editCveZona" -->
                    <select name="CveZona" id="editCveZona" class="form-select">
                        <option value="">Seleccione...</option>
                        <option value="1">CENTRO</option>
                        <option value="2">NORTE</option>
                        <option value="3">SUR</option>
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Zona</label>
                    <input type="text" name="Zona" id="editZona" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Cve Delegación</label>
                    <!-- Agregado: id="editCveDeleg" -->
                    <select name="CveDeleg" id="editCveDeleg" class="form-select">
                        <option value="">Seleccione...</option>
                        @for (int i = 1; i <= 24; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Delegación</label>
                    <input type="text" name="Delegacion" id="editDelegacion" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Región</label>
                    <input type="text" name="TcmunicipioRegion" id="editTcmunicipioRegion" class="form-control" maxlength="100" />
                </div>
               @*  <div class="col-md-6 d-flex align-items-center gap-3 pt-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="TcmunicipioAlerta" value="true" id="editTcmunicipioAlerta">
                        <label class="form-check-label" for="editTcmunicipioAlerta">Alerta</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="TcmunicipioIndigena" value="true" id="editTcmunicipioIndigena">
                        <label class="form-check-label" for="editTcmunicipioIndigena">Indígena</label>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="TcmunicipioCpdh" value="true" id="editTcmunicipioCpdh">
                        <label class="form-check-label" for="editTcmunicipioCpdh">CPDH</label>
                    </div>
                </div> *@
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Actualizar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/catalogo-municipios.js" asp-append-version="true"></script>
}
@* @using SIGEMAV.Models.ViewModels.Maquinaria

@model TallerEditViewModel

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <div class="d-flex flex-column flex-md-row
            justify-content-between
            align-items-md-center
            gap-3">

            <div>
                <h4 class="mb-1">
                    Editar taller
                </h4>

                <p class="text-muted mb-0">
                    Actualiza la información administrativa y financiera del taller.
                </p>

            </div>
            <div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Regresar

                </a>

            </div>

        </div>

    </div>
    <div class="card-body">
        <form asp-action="Edit"
              asp-route-id="@Model.TallerId"
              method="post"
              id="formEdit">

            @Html.AntiForgeryToken()

            <input asp-for="TallerId"
                   type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <!-- ================================================= -->
            <!-- DATOS GENERALES -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">
                    <i class="bi bi-info-circle me-2"></i>
                    Datos generales
                </h5>

                <p class="text-muted small mb-3">
                    Información de identificación del taller.
                </p>


                <div class="row g-3">

                    <div class="col-12 col-lg-6">

                        <label asp-for="RazonSocial"
                               class="form-label">
                        </label>

                        <input asp-for="RazonSocial"
                               class="form-control"
                               maxlength="100"
                               autocomplete="organization"
                               placeholder="Ingrese la razón social" />

                        <span asp-validation-for="RazonSocial"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-6 col-lg-3">

                        <label asp-for="Rfc"
                               class="form-label">
                        </label>

                        <input asp-for="Rfc"
                               class="form-control text-uppercase"
                               maxlength="13"
                               autocomplete="off"
                               placeholder="Ingrese el RFC" />

                        <span asp-validation-for="Rfc"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-6 col-lg-3">

                        <label asp-for="Contrato"
                               class="form-label">
                        </label>

                        <input asp-for="Contrato"
                               class="form-control"
                               maxlength="15"
                               autocomplete="off"
                               placeholder="Número de contrato" />

                        <span asp-validation-for="Contrato"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Ubicacion"
                               class="form-label">
                        </label>

                        <input asp-for="Ubicacion"
                               class="form-control"
                               maxlength="150"
                               autocomplete="street-address"
                               placeholder="Ingrese la ubicación del taller" />

                        <span asp-validation-for="Ubicacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- DATOS ADMINISTRATIVOS -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">
                    <i class="bi bi-diagram-3 me-2"></i>
                    Datos administrativos
                </h5>

                <p class="text-muted small mb-3">
                    Selecciona el recurso, banco y objetivo de mantenimiento,
                    e indica la información financiera asociada al taller.
                </p>


                <div class="row g-3">


                    <div class="col-12 col-md-6">

                        <label asp-for="RecursoId"
                               class="form-label">
                        </label>

                        <select asp-for="RecursoId"
                                asp-items="Model.Recursos"
                                class="form-select">

                            <option value="">
                                -- Seleccione un recurso --
                            </option>

                        </select>

                        <span asp-validation-for="RecursoId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-6">

                        <label asp-for="ObjetivoMantenimientoId"
                               class="form-label">
                        </label>

                        <select asp-for="ObjetivoMantenimientoId"
                                asp-items="Model.ObjetivosMantenimiento"
                                class="form-select">

                            <option value="">
                                -- Seleccione un objetivo --
                            </option>

                        </select>

                        <span asp-validation-for="ObjetivoMantenimientoId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-6">

                        <label asp-for="BancoId"
                               class="form-label">
                        </label>

                        <select asp-for="BancoId"
                                asp-items="Model.Bancos"
                                class="form-select">

                            <option value="">
                                -- Seleccione un banco --
                            </option>

                        </select>

                        <span asp-validation-for="BancoId"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-6">

                        <label asp-for="Fianza"
                               class="form-label">
                        </label>

                        <input asp-for="Fianza"
                               class="form-control"
                               maxlength="25"
                               autocomplete="off"
                               placeholder="Ingrese la fianza" />

                        <span asp-validation-for="Fianza"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12">

                        <label asp-for="Clabe"
                               class="form-label">
                        </label>

                        <input asp-for="Clabe"
                               class="form-control"
                               maxlength="18"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="Ingrese la CLABE interbancaria de 18 dígitos" />

                        <span asp-validation-for="Clabe"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- DATOS PRESUPUESTALES -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">
                    <i class="bi bi-cash-stack me-2"></i>
                    Datos presupuestales
                </h5>

                <p class="text-muted small mb-3">
                    Define los montos autorizados para la operación del taller.
                </p>


                <div class="row g-3">


                    <div class="col-12 col-md-6">

                        <label asp-for="MontoMinimo"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="MontoMinimo"
                                   class="form-control text-end"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="Ingrese el monto mínimo" />

                        </div>

                        <span asp-validation-for="MontoMinimo"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-12 col-md-6">

                        <label asp-for="MontoMaximo"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="MontoMaximo"
                                   class="form-control text-end"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="Ingrese el monto máximo" />

                        </div>

                        <span asp-validation-for="MontoMaximo"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- CONTROL DE PRESUPUESTO -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Control de presupuesto
                </h5>

                <p class="text-muted small mb-3">
                    Define los niveles de disponibilidad que activarán
                    la alerta preventiva y la alerta crítica del contrato.
                </p>


                <div class="row g-3">


                    <!-- ============================================= -->
                    <!-- ALERTA PREVENTIVA -->
                    <!-- ============================================= -->

                    <div class="col-12 col-lg-6">

                        <div class="card border h-100">

                            <div class="card-body">

                                <h6 class="mb-1">
                                    <i class="bi bi-bell me-2"></i>
                                    Alerta preventiva
                                </h6>

                                <p class="text-muted small mb-3">
                                    Cuando el saldo disponible alcance este
                                    porcentaje, se notificará que el contrato
                                    se está acercando al límite.
                                </p>


                                <label asp-for="PorcentajeAlerta"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <input asp-for="PorcentajeAlerta"
                                           class="form-control text-end"
                                           type="number"
                                           min="0.01"
                                           max="100"
                                           step="0.01"
                                           placeholder="Ej. 10" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                                <span asp-validation-for="PorcentajeAlerta"
                                      class="text-danger">
                                </span>


                                <div class="mt-3">

                                    <label asp-for="MontoAlerta"
                                           class="form-label">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            $
                                        </span>

                                        <input asp-for="MontoAlerta"
                                               class="form-control text-end"
                                               type="text"
                                               readonly />

                                    </div>

                                    <div class="form-text">
                                        Calculado automáticamente con base
                                        en el monto máximo.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ============================================= -->
                    <!-- ALERTA CRÍTICA -->
                    <!-- ============================================= -->

                    <div class="col-12 col-lg-6">

                        <div class="card border h-100">

                            <div class="card-body">

                                <h6 class="mb-1">
                                    <i class="bi bi-exclamation-octagon me-2"></i>
                                    Alerta crítica
                                </h6>

                                <p class="text-muted small mb-3">
                                    Cuando el saldo disponible alcance este
                                    porcentaje, se restringirá la operación
                                    normal y solamente podrán autorizarse
                                    servicios urgentes.
                                </p>


                                <label asp-for="PorcentajeCritico"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <input asp-for="PorcentajeCritico"
                                           class="form-control text-end"
                                           type="number"
                                           min="0.01"
                                           max="100"
                                           step="0.01"
                                           placeholder="Ej. 3" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>

                                <span asp-validation-for="PorcentajeCritico"
                                      class="text-danger">
                                </span>


                                <div class="mt-3">

                                    <label asp-for="MontoCritico"
                                           class="form-label">
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            $
                                        </span>

                                        <input asp-for="MontoCritico"
                                               class="form-control text-end"
                                               type="text"
                                               readonly />

                                    </div>

                                    <div class="form-text">
                                        Calculado automáticamente con base
                                        en el monto máximo.
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">
                    <i class="bi bi-toggle2-on me-2"></i>
                    Estado
                </h5>

                <p class="text-muted small mb-3">
                    Define si el taller quedará disponible para operación.
                </p>


                <div class="form-check form-switch">

                    <input asp-for="Activo"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="Activo"
                           class="form-check-label">
                    </label>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <div class="d-flex flex-column flex-sm-row
                justify-content-end
                gap-2
                pt-3
                border-top">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-lg me-1"></i>
                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>
                    Guardar cambios

                </button>

            </div>

        </form>
    </div>
</div>




    @section Scripts
    {
        @{
            await Html.RenderPartialAsync(
                "_ValidationScriptsPartial");
        }

        <script>

                document.addEventListener(
                    "DOMContentLoaded",
                    function() {
                        const montoMaximo =
                            document.getElementById("MontoMaximo");

                        const porcentajeAlerta =
                            document.getElementById("PorcentajeAlerta");

                        const montoAlerta =
                            document.getElementById("MontoAlerta");

                        const porcentajeCritico =
                            document.getElementById("PorcentajeCritico");

                        const montoCritico =
                            document.getElementById("MontoCritico");


                        // =================================================
                        // VALIDAR ELEMENTOS
                        // =================================================

                        if (
                            !montoMaximo ||
                            !porcentajeAlerta ||
                            !montoAlerta ||
                            !porcentajeCritico ||
                            !montoCritico
                        ) {
                            return;
                        }


                        // =================================================
                        // FORMATEAR MONTO
                        // =================================================

                        function formatearMonto(valor) {
                            if (
                                valor === null ||
                                valor === undefined ||
                                valor === "" ||
                                isNaN(valor)
                            ) {
                                return "";
                            }

                            return Number(valor).toLocaleString(
                                "es-MX",
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                });
                        }


                        // =================================================
                        // CALCULAR ALERTA PREVENTIVA
                        // =================================================

                        function calcularMontoAlerta() {
                            const maximo =
                                parseFloat(montoMaximo.value);

                            const porcentaje =
                                parseFloat(porcentajeAlerta.value);


                            if (
                                isNaN(maximo) ||
                                isNaN(porcentaje)
                            ) {
                                montoAlerta.value = "";

                                return;
                            }


                            montoAlerta.value =
                                formatearMonto(
                                    maximo *
                                    porcentaje /
                                    100);
                        }


                        // =================================================
                        // CALCULAR ALERTA CRÍTICA
                        // =================================================

                        function calcularMontoCritico() {
                            const maximo =
                                parseFloat(montoMaximo.value);

                            const porcentaje =
                                parseFloat(porcentajeCritico.value);


                            if (
                                isNaN(maximo) ||
                                isNaN(porcentaje)
                            ) {
                                montoCritico.value = "";

                                return;
                            }


                            montoCritico.value =
                                formatearMonto(
                                    maximo *
                                    porcentaje /
                                    100);
                        }


                        // =================================================
                        // ACTUALIZAR
                        // =================================================

                        function actualizarMontos() {
                            calcularMontoAlerta();
                            calcularMontoCritico();
                        }


                        // =================================================
                        // EVENTOS
                        // =================================================

                        montoMaximo.addEventListener(
                            "input",
                            actualizarMontos);

                        porcentajeAlerta.addEventListener(
                            "input",
                            actualizarMontos);

                        porcentajeCritico.addEventListener(
                            "input",
                            actualizarMontos);


                        // =================================================
                        // INICIALIZAR CON VALORES EXISTENTES
                        // =================================================

                        actualizarMontos();
                    });

        </script>

    }




 *@



 @using SIGEMAV.Models.ViewModels.Maquinaria

@model TallerEditViewModel

<div class="card shadow-sm">

    <!-- ========================================================= -->
    <!-- ENCABEZADO -->
    <!-- ========================================================= -->

    <div class="card-header bg-light">

        <div class="d-flex flex-column flex-md-row
                    justify-content-between
                    align-items-md-center
                    gap-3">

            <div>

                <h4 class="mb-1">
                    <i class="bi bi-building me-2"></i>
                    Editar taller
                </h4>

                <p class="text-muted mb-0">
                    Actualiza la información administrativa y operativa del taller.
                </p>

            </div>


            <div>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Regresar

                </a>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- CUERPO -->
    <!-- ========================================================= -->

    <div class="card-body">

        <form asp-action="Edit"
              asp-route-id="@Model.TallerId"
              method="post"
              id="formEdit">

            @Html.AntiForgeryToken()


            <!-- ================================================= -->
            <!-- IDENTIFICADOR -->
            <!-- ================================================= -->

            <input asp-for="TallerId"
                   type="hidden" />


            <!-- ================================================= -->
            <!-- VALIDACIONES -->
            <!-- ================================================= -->

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <!-- ================================================= -->
            <!-- DATOS GENERALES -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-info-circle me-2"></i>

                    Datos generales

                </h5>

                <p class="text-muted small mb-3">

                    Información de identificación y ubicación
                    del taller.

                </p>


                <div class="row g-3">


                    <!-- ========================================= -->
                    <!-- RAZÓN SOCIAL -->
                    <!-- ========================================= -->

                    <div class="col-12 col-lg-6">

                        <label asp-for="RazonSocial"
                               class="form-label">
                        </label>

                        <input asp-for="RazonSocial"
                               class="form-control"
                               maxlength="200"
                               autocomplete="organization"
                               placeholder="Ingrese la razón social" />

                        <span asp-validation-for="RazonSocial"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ========================================= -->
                    <!-- RFC -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6 col-lg-3">

                        <label asp-for="Rfc"
                               class="form-label">
                        </label>

                        <input asp-for="Rfc"
                               class="form-control text-uppercase"
                               maxlength="13"
                               autocomplete="off"
                               placeholder="Ingrese el RFC" />

                        <span asp-validation-for="Rfc"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ========================================= -->
                    <!-- UBICACIÓN -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6 col-lg-3">

                        <label asp-for="Ubicacion"
                               class="form-label">
                        </label>

                        <input asp-for="Ubicacion"
                               class="form-control"
                               maxlength="300"
                               autocomplete="street-address"
                               placeholder="Ingrese la ubicación del taller" />

                        <span asp-validation-for="Ubicacion"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- DATOS ADMINISTRATIVOS -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-diagram-3 me-2"></i>

                    Datos administrativos

                </h5>

                <p class="text-muted small mb-3">

                    Información administrativa y bancaria
                    asociada a la ubicación del taller.

                </p>


                <div class="row g-3">


                    <!-- ========================================= -->
                    <!-- BANCO -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="BancoId"
                               class="form-label">
                        </label>

                        <select asp-for="BancoId"
                                asp-items="Model.Bancos"
                                class="form-select">

                            <option value="">
                                -- Seleccione un banco --
                            </option>

                        </select>

                        <span asp-validation-for="BancoId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ========================================= -->
                    <!-- OBJETIVO DE MANTENIMIENTO -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="ObjetivoMantenimientoId"
                               class="form-label">
                        </label>

                        <select asp-for="ObjetivoMantenimientoId"
                                asp-items="Model.ObjetivosMantenimiento"
                                class="form-select">

                            <option value="">
                                -- Seleccione un objetivo --
                            </option>

                        </select>

                        <span asp-validation-for="ObjetivoMantenimientoId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ========================================= -->
                    <!-- FIANZA -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="Fianza"
                               class="form-label">
                        </label>

                        <input asp-for="Fianza"
                               class="form-control"
                               maxlength="50"
                               autocomplete="off"
                               placeholder="Ingrese la fianza" />

                        <span asp-validation-for="Fianza"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ========================================= -->
                    <!-- CLABE -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="Clabe"
                               class="form-label">
                        </label>

                        <input asp-for="Clabe"
                               class="form-control"
                               maxlength="18"
                               inputmode="numeric"
                               autocomplete="off"
                               placeholder="Ingrese la CLABE interbancaria de 18 dígitos" />

                        <span asp-validation-for="Clabe"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- CONFIGURACIÓN PRESUPUESTAL -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-cash-stack me-2"></i>

                    Configuración presupuestal

                </h5>

                <p class="text-muted small mb-3">

                    Información de la configuración presupuestal
                    asociada al contrato y recurso. Estos datos
                    son compartidos por las ubicaciones que utilizan
                    la misma configuración y no se modifican desde
                    la edición del taller.

                </p>


                <div class="alert alert-info d-flex align-items-start gap-2">

                    <i class="bi bi-info-circle-fill mt-1"></i>

                    <div>

                        <strong>Información de consulta.</strong>

                        <div class="small">

                            Para modificar los montos o los niveles
                            de control presupuestal deberá utilizarse
                            la administración de la configuración
                            presupuestal correspondiente.

                        </div>

                    </div>

                </div>


                <div class="row g-3">


                    <!-- ========================================= -->
                    <!-- RECURSO -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="RecursoNombre"
                               class="form-label">
                        </label>

                        <input asp-for="RecursoNombre"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- ========================================= -->
                    <!-- CONTRATO -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="Contrato"
                               class="form-label">
                        </label>

                        <input asp-for="Contrato"
                               class="form-control"
                               readonly />

                    </div>


                    <!-- ========================================= -->
                    <!-- MONTO MÍNIMO -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="MontoMinimo"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="MontoMinimo"
                                   class="form-control text-end"
                                   value="@(Model.MontoMinimo?.ToString("N2"))"
                                   readonly />

                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- MONTO MÁXIMO -->
                    <!-- ========================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="MontoMaximo"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="MontoMaximo"
                                   class="form-control text-end"
                                   value="@(Model.MontoMaximo?.ToString("N2"))"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- CONTROL DE PRESUPUESTO -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    Control de presupuesto

                </h5>

                <p class="text-muted small mb-3">

                    Niveles configurados para determinar las alertas
                    de disponibilidad presupuestal.

                </p>


                <div class="row g-3">


                    <!-- ========================================= -->
                    <!-- ALERTA PREVENTIVA -->
                    <!-- ========================================= -->

                    <div class="col-12 col-lg-6">

                        <div class="card border h-100">

                            <div class="card-body">

                                <h6 class="mb-1">

                                    <i class="bi bi-bell me-2"></i>

                                    Alerta preventiva

                                </h6>


                                <p class="text-muted small mb-3">

                                    Nivel de disponibilidad configurado
                                    para generar la alerta preventiva.

                                </p>


                                <div class="row g-3">


                                    <!-- ========================= -->
                                    <!-- PORCENTAJE -->
                                    <!-- ========================= -->

                                    <div class="col-12">

                                        <label asp-for="PorcentajeAlerta"
                                               class="form-label">
                                        </label>

                                        <div class="input-group">

                                            <input asp-for="PorcentajeAlerta"
                                                   class="form-control text-end"
                                                   value="@(Model.PorcentajeAlerta?.ToString("N2"))"
                                                   readonly />

                                            <span class="input-group-text">
                                                %
                                            </span>

                                        </div>

                                    </div>


                                    <!-- ========================= -->
                                    <!-- MONTO -->
                                    <!-- ========================= -->

                                    <div class="col-12">

                                        <label asp-for="MontoAlerta"
                                               class="form-label">
                                        </label>

                                        <div class="input-group">

                                            <span class="input-group-text">
                                                $
                                            </span>

                                            <input asp-for="MontoAlerta"
                                                   class="form-control text-end"
                                                   value="@(Model.MontoAlerta?.ToString("N2"))"
                                                   readonly />

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ========================================= -->
                    <!-- ALERTA CRÍTICA -->
                    <!-- ========================================= -->

                    <div class="col-12 col-lg-6">

                        <div class="card border h-100">

                            <div class="card-body">

                                <h6 class="mb-1">

                                    <i class="bi bi-exclamation-octagon me-2"></i>

                                    Alerta crítica

                                </h6>


                                <p class="text-muted small mb-3">

                                    Nivel de disponibilidad configurado
                                    para determinar la condición crítica
                                    del presupuesto.

                                </p>


                                <div class="row g-3">


                                    <!-- ========================= -->
                                    <!-- PORCENTAJE -->
                                    <!-- ========================= -->

                                    <div class="col-12">

                                        <label asp-for="PorcentajeCritico"
                                               class="form-label">
                                        </label>

                                        <div class="input-group">

                                            <input asp-for="PorcentajeCritico"
                                                   class="form-control text-end"
                                                   value="@(Model.PorcentajeCritico?.ToString("N2"))"
                                                   readonly />

                                            <span class="input-group-text">
                                                %
                                            </span>

                                        </div>

                                    </div>


                                    <!-- ========================= -->
                                    <!-- MONTO -->
                                    <!-- ========================= -->

                                    <div class="col-12">

                                        <label asp-for="MontoCritico"
                                               class="form-label">
                                        </label>

                                        <div class="input-group">

                                            <span class="input-group-text">
                                                $
                                            </span>

                                            <input asp-for="MontoCritico"
                                                   class="form-control text-end"
                                                   value="@(Model.MontoCritico?.ToString("N2"))"
                                                   readonly />

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-toggle2-on me-2"></i>

                    Estado

                </h5>

                <p class="text-muted small mb-3">

                    Define si el taller quedará disponible
                    para operación.

                </p>


                <div class="form-check form-switch">

                    <input asp-for="Activo"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="Activo"
                           class="form-check-label">
                    </label>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- BOTONES -->
            <!-- ================================================= -->

            <div class="d-flex flex-column flex-sm-row
                        justify-content-end
                        gap-2
                        pt-3
                        border-top">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-lg me-1"></i>

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Guardar cambios

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}


@model SIGEMAV.Models.ViewModels.Maquinaria.TallerConfiguracionPresupuestalViewModel

@{
    ViewData["Title"] = "Editar configuración presupuestal";
}

<form asp-action="EditarConfiguracionPresupuestal"
      method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="TallerConfiguracionPresupuestalId" />

    <div class="card shadow-sm">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <div class="card-header bg-light">

            <div class="d-flex
                align-items-center
                gap-2">

                <div class="text-primary">

                    <i class="bi bi-wallet2 fs-4"></i>

                </div>

                <div>

                    <h4 class="mb-0">
                        Editar configuración presupuestal
                    </h4>

                    <small class="text-muted">
                        Actualización de límites y umbrales
                    </small>

                </div>

            </div>

        </div>


        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <!-- ================================================= -->
            <!-- IDENTIDAD -->
            <!-- ================================================= -->

            <div class="card border mb-4">

                <div class="card-header bg-light">

                    <strong>
                        <i class="bi bi-file-earmark-text me-1"></i>
                        Identificación contractual
                    </strong>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label class="form-label">
                                Contrato
                            </label>

                            <input value="@Model.Contrato"
                                   class="form-control bg-light"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Recurso
                            </label>

                            <input value="@Model.RecursoNombre"
                                   class="form-control bg-light"
                                   readonly />

                        </div>

                    </div>


                    <div class="alert alert-info mt-3 mb-0">

                        <div class="d-flex gap-2">

                            <i class="bi bi-info-circle"></i>

                            <div class="small">

                                El contrato y recurso forman la identidad
                                de la configuración y no pueden modificarse.
                                Para otra combinación debe crearse una nueva
                                configuración.

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- INFORMACIÓN DE USO -->
            <!-- ================================================= -->

            <div class="row g-3 mb-4">

                <div class="col-md-4">

                    <div class="card border h-100">

                        <div class="card-body">

                            <div class="text-muted small">
                                Talleres asociados
                            </div>

                            <div class="fs-4 fw-semibold">
                                @Model.CantidadTalleres
                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="card border h-100">

                        <div class="card-body">

                            <div class="text-muted small">
                                Talleres activos
                            </div>

                            <div class="fs-4 fw-semibold">
                                @Model.CantidadTalleresActivos
                            </div>

                        </div>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="card border h-100">

                        <div class="card-body">

                            <div class="text-muted small">
                                Controles presupuestales
                            </div>

                            <div class="fs-4 fw-semibold">
                                @Model.CantidadControles
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- MONTOS -->
            <!-- ================================================= -->

            <div class="card border mb-4">

                <div class="card-header bg-light">

                    <strong>
                        <i class="bi bi-cash-stack me-1"></i>
                        Límites presupuestales
                    </strong>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="MontoMinimo"
                                   class="form-label">
                                Monto mínimo
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="MontoMinimo"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="MontoMinimo"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="MontoMaximo"
                                   class="form-label">
                                Monto máximo
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="MontoMaximo"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="MontoMaximo"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                No puede reducirse por debajo de los importes
                                ya ejercidos o comprometidos.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- UMBRALES -->
            <!-- ================================================= -->

            <div class="card border mb-4">

                <div class="card-header bg-light">

                    <strong>
                        <i class="bi bi-speedometer2 me-1"></i>
                        Umbrales de disponibilidad
                    </strong>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="PorcentajeAlerta"
                                   class="form-label">
                                Porcentaje de alerta
                            </label>

                            <div class="input-group">

                                <input asp-for="PorcentajeAlerta"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01" />

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>

                            <span asp-validation-for="PorcentajeAlerta"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="PorcentajeCritico"
                                   class="form-label">
                                Porcentaje crítico
                            </label>

                            <div class="input-group">

                                <input asp-for="PorcentajeCritico"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01" />

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>

                            <span asp-validation-for="PorcentajeCritico"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <div class="row g-3 mt-1">

                        <div class="col-md-6">

                            <label class="form-label">
                                Monto de alerta calculado
                            </label>

                            <input value="@(Model.MontoAlerta?.ToString("C") ?? "No definido")"
                                   class="form-control bg-light"
                                   readonly />

                        </div>


                        <div class="col-md-6">

                            <label class="form-label">
                                Monto crítico calculado
                            </label>

                            <input value="@(Model.MontoCritico?.ToString("C") ?? "No definido")"
                                   class="form-control bg-light"
                                   readonly />

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <div class="card border">

                <div class="card-header bg-light">

                    <strong>
                        <i class="bi bi-toggle-on me-1"></i>
                        Estado
                    </strong>

                </div>

                <div class="card-body">

                    <div class="form-check form-switch">

                        <input asp-for="Activo"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="Activo"
                               class="form-check-label">

                            Configuración activa

                        </label>

                    </div>

                    <div class="form-text">
                        Una configuración no podrá desactivarse mientras
                        tenga talleres activos asociados.
                    </div>

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <div class="card-footer d-flex
            justify-content-end
            gap-2">

            <a asp-action="ConfiguracionPresupuestal"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>

                Cancelar

            </a>


            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-circle me-1"></i>

                Guardar cambios

            </button>

        </div>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
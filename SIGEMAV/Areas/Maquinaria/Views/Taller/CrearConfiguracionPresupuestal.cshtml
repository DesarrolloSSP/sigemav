@model SIGEMAV.Models.ViewModels.Maquinaria.TallerConfiguracionPresupuestalViewModel

@* @{
    ViewData["Title"] = "Nueva configuración presupuestal";
} *@

<form asp-action="CrearConfiguracionPresupuestal"
      method="post">

    @Html.AntiForgeryToken()

    <div class="card shadow-sm">

        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <div class="card-header bg-light">

            <div class="d-flex
                        flex-column
                        flex-md-row
                        justify-content-between
                        align-items-md-center
                        gap-3">

                <div>

                    <div class="d-flex align-items-center gap-2">

                        <div class="text-primary">

                            <i class="bi bi-wallet2 fs-4"></i>

                        </div>

                        <div>

                            <h4 class="mb-0">
                                Nueva configuración presupuestal
                            </h4>

                            <small class="text-muted">
                                Define el contrato, recurso y límites
                                presupuestales
                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- BODY -->
        <!-- ===================================================== -->

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>


            <!-- ================================================= -->
            <!-- IDENTIFICACIÓN -->
            <!-- ================================================= -->

            <div class="card border mb-4">

                <div class="card-header bg-light">

                    <strong>

                        <i class="bi bi-file-earmark-text me-1"></i>

                        Identificación contractual

                    </strong>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <div class="col-md-7">

                            <label asp-for="Contrato"
                                   class="form-label">

                                Contrato

                            </label>

                            <input asp-for="Contrato"
                                   class="form-control"
                                   maxlength="200"
                                   placeholder="Número o referencia del contrato" />

                            <span asp-validation-for="Contrato"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                El contrato, junto con el recurso,
                                identifica la configuración presupuestal.
                            </div>

                        </div>


                        <div class="col-md-5">

                            <label asp-for="RecursoId"
                                   class="form-label">

                                Recurso

                            </label>

                            <select asp-for="RecursoId"
                                    asp-items="Model.Recursos"
                                    class="form-select">

                                <option value="">
                                    Seleccione un recurso
                                </option>

                            </select>

                            <span asp-validation-for="RecursoId"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- LÍMITES PRESUPUESTALES -->
            <!-- ================================================= -->

            <div class="card border mb-4">

                <div class="card-header bg-light">

                    <strong>

                        <i class="bi bi-cash-stack me-1"></i>

                        Límites presupuestales

                    </strong>

                </div>

                <div class="card-body">

                    <div class="row g-3">

                        <!-- ===================================== -->
                        <!-- MONTO MÍNIMO -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            <label asp-for="MontoMinimo"
                                   class="form-label">

                                Monto mínimo

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="MontoMinimo"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="MontoMinimo"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Referencia contractual mínima.
                            </div>

                        </div>


                        <!-- ===================================== -->
                        <!-- MONTO MÁXIMO -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            <label asp-for="MontoMaximo"
                                   class="form-label">

                                Monto máximo

                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    $
                                </span>

                                <input asp-for="MontoMaximo"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="MontoMaximo"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Límite máximo contractual de la configuración.
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- UMBRALES -->
            <!-- ================================================= -->

            <div class="card border">

                <div class="card-header bg-light">

                    <strong>

                        <i class="bi bi-speedometer2 me-1"></i>

                        Umbrales de disponibilidad

                    </strong>

                </div>

                <div class="card-body">

                    <div class="alert alert-info">

                        <div class="d-flex gap-2">

                            <i class="bi bi-info-circle fs-5"></i>

                            <div class="small">

                                Los porcentajes representan el nivel de
                                <strong>presupuesto disponible restante</strong>
                                que determina una condición de alerta o crítica.

                                El sistema calculará automáticamente los
                                montos correspondientes.

                            </div>

                        </div>

                    </div>


                    <div class="row g-3">

                        <!-- ===================================== -->
                        <!-- ALERTA -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            <label asp-for="PorcentajeAlerta"
                                   class="form-label">

                                Porcentaje de alerta

                            </label>

                            <div class="input-group">

                                <input asp-for="PorcentajeAlerta"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01" />

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>

                            <span asp-validation-for="PorcentajeAlerta"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ===================================== -->
                        <!-- CRÍTICO -->
                        <!-- ===================================== -->

                        <div class="col-md-6">

                            <label asp-for="PorcentajeCritico"
                                   class="form-label">

                                Porcentaje crítico

                            </label>

                            <div class="input-group">

                                <input asp-for="PorcentajeCritico"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="0.01" />

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>

                            <span asp-validation-for="PorcentajeCritico"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>


                    <div class="alert alert-light border mt-3 mb-0">

                        <div class="small text-muted">

                            <strong>Ejemplo:</strong>

                            con un monto máximo de $1,000,000,
                            una alerta del 30% representa
                            $300,000 de presupuesto disponible.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- FOOTER -->
        <!-- ===================================================== -->

        <div class="card-footer d-flex
                    justify-content-end
                    gap-2">

            <a asp-action="ConfiguracionPresupuestal"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>

                Cancelar

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-circle me-1"></i>

                Crear configuración

            </button>

        </div>

    </div>

</form>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}



@model IEnumerable<SIGEMAV.Areas.Maquinaria.DTOs.TallerControlPresupuestalDto>

@{
    // ViewData["Title"] = "Control presupuestal";

    string? busqueda = ViewBag.Busqueda as string;

    short? ejercicio = ViewBag.Ejercicio as short?;

    bool? activo = ViewBag.Activo as bool?;
}

<div class="card shadow-sm">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="card-header bg-light">

        <div class="d-flex
            flex-column
            flex-md-row
            justify-content-between
            align-items-md-center
            gap-3">

            <div>

                <div class="d-flex align-items-center gap-2">

                    <div class="text-primary">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>

                    <div>

                        <h4 class="mb-0">
                            Control presupuestal
                        </h4>

                        <small class="text-muted">
                            Administración del presupuesto anual por configuración contractual
                        </small>

                    </div>

                </div>

            </div>

            <div>

                <a asp-action="CrearControlPresupuestal"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>

                    Nuevo control

                </a>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- FILTROS -->
    <!-- ===================================================== -->

    <div class="card-body border-bottom">

        <form asp-action="ControlPresupuestal"
              method="get">

            <div class="row g-3 align-items-end">

                <!-- BÚSQUEDA -->

                <div class="col-md-5">

                    <label class="form-label">
                        Buscar
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               name="busqueda"
                               value="@busqueda"
                               class="form-control"
                               placeholder="Por contrato o recurso..." />

                    </div>

                </div>


                <!-- EJERCICIO -->

                <div class="col-md-2">

                    <label class="form-label">
                        Ejercicio
                    </label>

                    <input type="number"
                           name="ejercicio"
                           value="@ejercicio"
                           class="form-control"
                           min="2000"
                           max="2100" />

                </div>


                <!-- ESTADO -->

                <div class="col-md-2">

                    <label class="form-label">
                        Estado
                    </label>

                    <select name="activo"
                            class="form-select">

                        <option value="">
                            Todos
                        </option>

                        @if (activo == true)
                        {
                            <option value="true"
                                    selected>
                                Activos
                            </option>
                        }
                        else
                        {
                            <option value="true">
                                Activos
                            </option>
                        }

                        @if (activo == false)
                        {
                            <option value="false"
                                    selected>
                                Inactivos
                            </option>
                        }
                        else
                        {
                            <option value="false">
                                Inactivos
                            </option>
                        }

                    </select>

                </div>


                <!-- ACCIONES -->

                <div class="col-md-3">

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Buscar

                        </button>

                        <a asp-action="ControlPresupuestal"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle me-1"></i>

                            Limpiar

                        </a>

                    </div>

                </div>

            </div>

        </form>

    </div>


    <!-- ===================================================== -->
    <!-- TABLA -->
    <!-- ===================================================== -->

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            Contrato
                        </th>

                        <th>
                            Recurso
                        </th>

                        <th class="text-center">
                            Ejercicio
                        </th>

                        <th class="text-end">
                            Asignado
                        </th>

                        <th class="text-end">
                            Comprometido
                        </th>

                        <th class="text-end">
                            Ejercido
                        </th>

                        <th class="text-end">
                            Disponible
                        </th>

                        <th class="text-center">
                            Estado
                        </th>

                        <th class="text-center"
                            style="width: 90px;">

                            Acciones

                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model == null ||
                         !Model.Any())
                    {
                        <tr>

                            <td colspan="9"
                                class="text-center py-5">

                                <div class="text-muted">

                                    <i class="bi bi-wallet2 fs-1"></i>

                                    <h5 class="mt-3 mb-2">
                                        No se encontraron controles presupuestales
                                    </h5>

                                    <p class="mb-0">
                                        No existen registros que coincidan con los filtros seleccionados.
                                    </p>

                                </div>

                            </td>

                        </tr>
                    }
                    else
                    {
                        foreach (var control in Model)
                        {
                            <tr>

                                <!-- CONTRATO -->

                                <td>

                                    <div class="fw-semibold">
                                        @control.Contrato
                                    </div>

                                </td>


                                <!-- RECURSO -->

                                <td>

                                    @control.RecursoNombre

                                </td>


                                <!-- EJERCICIO -->

                                <td class="text-center">

                                    <span class="badge bg-light-primary text-primary">
                                        @control.Ejercicio
                                    </span>

                                </td>


                                <!-- ASIGNADO -->

                                <td class="text-end">

                                    @control.PresupuestoAsignado.ToString("C2")

                                </td>


                                <!-- COMPROMETIDO -->

                                <td class="text-end">

                                    @control.PresupuestoComprometido.ToString("C2")

                                </td>


                                <!-- EJERCIDO -->

                                <td class="text-end">

                                    @control.PresupuestoEjercido.ToString("C2")

                                </td>


                                <!-- DISPONIBLE -->

                                <td class="text-end">

                                    <span class="fw-semibold">
                                        @control.PresupuestoDisponible.ToString("C2")
                                    </span>

                                </td>


                                <!-- ESTADO -->

                                <td class="text-center">

                                    @if (control.Activo)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Activo

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Inactivo

                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->

                                <td class="text-center">

                                    <a asp-action="EditarControlPresupuestal"
                                       asp-route-id="@control.IdControlTaller"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Editar control presupuestal"
                                       aria-label="Editar control presupuestal">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="MontoMinimo"
                                   class="form-control text-end"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="Ingrese el monto mínimo" />

                        </div>

                        <span asp-validation-for="MontoMinimo"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- MONTO MÁXIMO -->
                    <!-- ================================================= -->

                    <div class="col-12 col-md-6">

                        <label asp-for="MontoMaximo"
                               class="form-label">
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                $
                            </span>

                            <input asp-for="MontoMaximo"
                                   class="form-control text-end"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="Ingrese el monto máximo" />

                        </div>

                        <span asp-validation-for="MontoMaximo"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- CONTROL DE PRESUPUESTO -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-exclamation-triangle me-2"></i>

                    Control de presupuesto

                </h5>


                <p class="text-muted small mb-3">

                    Define los niveles de disponibilidad que activarán
                    la alerta preventiva y la alerta crítica.

                </p>


                <div class="row g-3">


                    <!-- ================================================= -->
                    <!-- ALERTA PREVENTIVA -->
                    <!-- ================================================= -->

                    <div class="col-12 col-lg-6">

                        <div class="card border h-100">

                            <div class="card-body">

                                <h6 class="mb-1">

                                    <i class="bi bi-bell me-2"></i>

                                    Alerta preventiva

                                </h6>


                                <p class="text-muted small mb-3">

                                    Nivel de disponibilidad presupuestal
                                    a partir del cual se generará una
                                    alerta preventiva.

                                </p>


                                <label asp-for="PorcentajeAlerta"
                                       class="form-label">
                                </label>


                                <div class="input-group">

                                    <input asp-for="PorcentajeAlerta"
                                           class="form-control text-end"
                                           type="number"
                                           min="0.01"
                                           max="100"
                                           step="0.01"
                                           placeholder="Ej. 10" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>


                                <span asp-validation-for="PorcentajeAlerta"
                                      class="text-danger">
                                </span>


                                <div class="mt-3">

                                    <label asp-for="MontoAlerta"
                                           class="form-label">
                                    </label>


                                    <div class="input-group">

                                        <span class="input-group-text">
                                            $
                                        </span>

                                        <input asp-for="MontoAlerta"
                                               class="form-control text-end"
                                               type="text"
                                               readonly />

                                    </div>


                                    <div class="form-text">

                                        Se calcula automáticamente como
                                        porcentaje del monto máximo.

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- ALERTA CRÍTICA -->
                    <!-- ================================================= -->

                    <div class="col-12 col-lg-6">

                        <div class="card border h-100">

                            <div class="card-body">

                                <h6 class="mb-1">

                                    <i class="bi bi-exclamation-octagon me-2"></i>

                                    Alerta crítica

                                </h6>


                                <p class="text-muted small mb-3">

                                    Nivel mínimo de disponibilidad
                                    presupuestal que determina una
                                    condición crítica.

                                </p>


                                <label asp-for="PorcentajeCritico"
                                       class="form-label">
                                </label>


                                <div class="input-group">

                                    <input asp-for="PorcentajeCritico"
                                           class="form-control text-end"
                                           type="number"
                                           min="0.01"
                                           max="100"
                                           step="0.01"
                                           placeholder="Ej. 3" />

                                    <span class="input-group-text">
                                        %
                                    </span>

                                </div>


                                <span asp-validation-for="PorcentajeCritico"
                                      class="text-danger">
                                </span>


                                <div class="mt-3">

                                    <label asp-for="MontoCritico"
                                           class="form-label">
                                    </label>


                                    <div class="input-group">

                                        <span class="input-group-text">
                                            $
                                        </span>

                                        <input asp-for="MontoCritico"
                                               class="form-control text-end"
                                               type="text"
                                               readonly />

                                    </div>


                                    <div class="form-text">

                                        Se calcula automáticamente como
                                        porcentaje del monto máximo.

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <hr class="my-4" />


            <!-- ================================================= -->
            <!-- ESTADO -->
            <!-- ================================================= -->

            <div class="mb-4">

                <h5 class="mb-1">

                    <i class="bi bi-toggle2-on me-2"></i>

                    Estado

                </h5>


                <p class="text-muted small mb-3">

                    Define si la ubicación del taller quedará
                    disponible para operación.

                </p>


                <div class="form-check form-switch">

                    <input asp-for="Activo"
                           class="form-check-input"
                           role="switch" />

                    <label asp-for="Activo"
                           class="form-check-label">
                    </label>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ACCIONES -->
            <!-- ================================================= -->

            <div class="d-flex flex-column flex-sm-row
                        justify-content-end
                        gap-2
                        pt-3
                        border-top">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-lg me-1"></i>

                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Registrar taller

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }


    <!-- ========================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function ()
            {

                // =================================================
                // RFC EN MAYÚSCULAS
                // =================================================

                const rfc =
                    document.getElementById("Rfc");


                if (rfc)
                {
                    rfc.addEventListener(
                        "input",
                        function ()
                        {
                            this.value =
                                this.value.toUpperCase();
                        });
                }


                // =================================================
                // CLABE: SOLO DÍGITOS
                // =================================================

                const clabe =
                    document.getElementById("Clabe");


                if (clabe)
                {
                    clabe.addEventListener(
                        "input",
                        function ()
                        {
                            this.value =
                                this.value
                                    .replace(/\D/g, "")
                                    .substring(0, 18);
                        });
                }


                // =================================================
                // REFERENCIAS
                // =================================================

                const montoMaximo =
                    document.getElementById("MontoMaximo");

                const porcentajeAlerta =
                    document.getElementById("PorcentajeAlerta");

                const montoAlerta =
                    document.getElementById("MontoAlerta");

                const porcentajeCritico =
                    document.getElementById("PorcentajeCritico");

                const montoCritico =
                    document.getElementById("MontoCritico");


                // =================================================
                // VALIDAR ELEMENTOS
                // =================================================

                if (
                    !montoMaximo ||
                    !porcentajeAlerta ||
                    !montoAlerta ||
                    !porcentajeCritico ||
                    !montoCritico
                )
                {
                    return;
                }


                // =================================================
                // FORMATEAR MONTO
                // =================================================

                function formatearMonto(valor)
                {
                    if (
                        valor === null ||
                        valor === undefined ||
                        valor === "" ||
                        isNaN(valor)
                    )
                    {
                        return "";
                    }

                    return Number(valor).toLocaleString(
                        "es-MX",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                }


                // =================================================
                // CALCULAR ALERTA PREVENTIVA
                // =================================================

                function calcularMontoAlerta()
                {
                    const maximo =
                        parseFloat(montoMaximo.value);

                    const porcentaje =
                        parseFloat(porcentajeAlerta.value);


                    if (
                        isNaN(maximo) ||
                        isNaN(porcentaje)
                    )
                    {
                        montoAlerta.value = "";

                        return;
                    }


                    const resultado =
                        maximo * porcentaje / 100;


                    montoAlerta.value =
                        formatearMonto(resultado);
                }


                // =================================================
                // CALCULAR ALERTA CRÍTICA
                // =================================================

                function calcularMontoCritico()
                {
                    const maximo =
                        parseFloat(montoMaximo.value);

                    const porcentaje =
                        parseFloat(porcentajeCritico.value);


                    if (
                        isNaN(maximo) ||
                        isNaN(porcentaje)
                    )
                    {
                        montoCritico.value = "";

                        return;
                    }


                    const resultado =
                        maximo * porcentaje / 100;


                    montoCritico.value =
                        formatearMonto(resultado);
                }


                // =================================================
                // ACTUALIZAR MONTOS
                // =================================================

                function actualizarMontos()
                {
                    calcularMontoAlerta();
                    calcularMontoCritico();
                }


                // =================================================
                // EVENTOS
                // =================================================

                montoMaximo.addEventListener(
                    "input",
                    actualizarMontos);

                porcentajeAlerta.addEventListener(
                    "input",
                    actualizarMontos);

                porcentajeCritico.addEventListener(
                    "input",
                    actualizarMontos);


                // =================================================
                // INICIALIZAR
                // =================================================

                actualizarMontos();

            });

    </script>

}


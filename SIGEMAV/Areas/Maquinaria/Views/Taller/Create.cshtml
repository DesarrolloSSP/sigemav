                    Cancelar

                </a>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-check-lg me-1"></i>

                    Registrar taller

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                // =================================================
                // RFC EN MAYÚSCULAS
                // =================================================

                const rfc =
                    document.getElementById(
                        "Rfc");


                if (rfc) {

                    rfc.addEventListener(
                        "input",
                        function () {

                            this.value =
                                this.value
                                    .toUpperCase();

                        });

                }

            });

    </script>




    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function ()
            {
                const montoMaximo =
                    document.getElementById("MontoMaximo");

                const porcentajeAlerta =
                    document.getElementById("PorcentajeAlerta");

                const montoAlerta =
                    document.getElementById("MontoAlerta");

                const porcentajeCritico =
                    document.getElementById("PorcentajeCritico");

                const montoCritico =
                    document.getElementById("MontoCritico");


                // =================================================
                // FORMATEAR MONTO
                // =================================================

                function formatearMonto(valor)
                {
                    if (
                        valor === null ||
                        valor === undefined ||
                        valor === "" ||
                        isNaN(valor)
                    )
                    {
                        return "";
                    }

                    return Number(valor).toLocaleString(
                        "es-MX",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        });
                }


                // =================================================
                // CALCULAR ALERTA PREVENTIVA
                // =================================================

                function calcularMontoAlerta()
                {
                    const maximo =
                        parseFloat(montoMaximo.value);

                    const porcentaje =
                        parseFloat(porcentajeAlerta.value);


                    if (
                        isNaN(maximo) ||
                        isNaN(porcentaje)
                    )
                    {
                        montoAlerta.value = "";

                        return;
                    }


                    const resultado =
                        maximo * porcentaje / 100;


                    montoAlerta.value =
                        formatearMonto(resultado);
                }


                // =================================================
                // CALCULAR ALERTA CRÍTICA
                // =================================================

                function calcularMontoCritico()
                {
                    const maximo =
                        parseFloat(montoMaximo.value);

                    const porcentaje =
                        parseFloat(porcentajeCritico.value);


                    if (
                        isNaN(maximo) ||
                        isNaN(porcentaje)
                    )
                    {
                        montoCritico.value = "";

                        return;
                    }


                    const resultado =
                        maximo * porcentaje / 100;


                    montoCritico.value =
                        formatearMonto(resultado);
                }


                // =================================================
                // ACTUALIZAR
                // =================================================

                function actualizarMontos()
                {
                    calcularMontoAlerta();
                    calcularMontoCritico();
                }


                // =================================================
                // EVENTOS
                // =================================================

                montoMaximo.addEventListener(
                    "input",
                    actualizarMontos);

                porcentajeAlerta.addEventListener(
                    "input",
                    actualizarMontos);

                porcentajeCritico.addEventListener(
                    "input",
                    actualizarMontos);


                // =================================================
                // INICIALIZAR
                // =================================================

                actualizarMontos();
            });

    </script>




}


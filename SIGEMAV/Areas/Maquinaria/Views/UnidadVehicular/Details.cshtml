@model SIGEMAV.Models.ViewModels.Maquinaria.UnidadVehicularDetailsViewModel

@* @{
    ViewData["Title"] = "Detalle Unidad Vehicular";
} *@








<div class="card shadow-sm border-0 mb-4">

	<div class="card-header bg-white">

		<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
			<div>
				<h4 class="fw-bold mb-0">
					Detalle de la unidad vehicular
				</h4>

				<small class="text-muted">
					Información general
				</small>

			</div>

			<div class="d-flex gap-2">

				<a asp-action="Edit"
				   asp-route-id="@Model.UnidadVehicularId"
				   class="btn btn-outline-primary">

					<i class="bi bi-pencil-square me-1"></i>
					Editar

				</a>

				<a asp-action="Index"
				   class="btn btn-outline-secondary">

					<i class="bi bi-arrow-left me-1"></i>
					Regresar

				</a>

			</div>

		</div>

	</div>




	<div class="card-header bg-light">

		<h5 class="fw-bold mb-0">
			<i class="bi bi-truck me-2"></i>
			Información de la unidad
		</h5>

	</div>

	<div class="card-body">

		<div class="row g-3">

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">No. Económico</small>
				<div class="fw-bold">@Model.NumeroEconomico</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Placa</small>
				<span class="badge bg-primary fs-6">@Model.PlacaActual</span>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Serie</small>
				<div class="fw-semibold">@Model.NumeroSerie</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Año</small>
				<div>@Model.AnioNombre</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Marca</small>
				<div>@Model.MarcaNombre</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Modelo</small>
				<div>@Model.ModeloNombre</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Color</small>
				<div>@Model.ColorNombre</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Transmisión</small>
				<div>@Model.TransmisionNombre</div>
			</div>

			<div class="col-xl-3 col-md-6">
				<small class="text-muted d-block">Cilindros</small>
				<div>@Model.CilindroNombre</div>
			</div>

		</div>

	</div>

</div>






<div class="card shadow-sm border-0">

	<div class="card-header bg-light">

		<h5 class="fw-bold mb-0">

			<i class="bi bi-geo-alt me-2"></i>

			Ubicación y control

		</h5>

	</div>

	<div class="card-body">

		<div class="row g-3">

			<div class="col-lg-3">

				<small class="text-muted d-block">
					Área
				</small>

				<div class="fw-semibold">
					@Model.AreaNombre
				</div>

			</div>

			<div class="col-lg-3">

				<small class="text-muted d-block">
					Municipio
				</small>

				<div>
					@Model.MunicipioNombre
				</div>

			</div>

			<div class="col-lg-3">

				<small class="text-muted d-block">
					Fecha de registro
				</small>

				<div>
					@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
				</div>

			</div>

			<div class="col-lg-3">

				<small class="text-muted d-block">
					Estatus
				</small>

				@if (Model.Activo)
				{
					<span class="badge bg-success">
						Activo
					</span>
				}
				else
				{
					<span class="badge bg-danger">
						Inactivo
					</span>
				}

			</div>

		</div>

	</div>

</div>






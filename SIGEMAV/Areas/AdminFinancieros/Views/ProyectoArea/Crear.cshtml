
@using SIGEMAV.Models.ViewModels.Financieros.Proyecto
@model ProyectoAreaCrudVM

@{
    ViewData["Title"] = "Asignar Proyecto - Área";
}

<div class="container-fluid">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between
        align-items-md-center
        mb-4">

        <div>

            <h3 class="fw-bold mb-1">
                Asignar Proyecto - Área
            </h3>

            <p class="text-muted mb-0">
                Registro de relación entre proyecto y área
            </p>

        </div>

        <div class="mt-3 mt-md-0">

            <a asp-action="Index"
                   class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Regresar

            </a>

        </div>

    </div>


    <!-- CARD -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <form asp-action="Crear"
                  method="post">

                <!-- VALIDACIONES -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row">

                    <!-- PROYECTO -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="IdProyecto"
                               class="form-label">
                        </label>

                        <select asp-for="IdProyecto"
                                asp-items="Model.Proyectos"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                        </select>

                        <span asp-validation-for="IdProyecto"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- AREA -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="IdArea"
                               class="form-label">
                        </label>

                        <select asp-for="IdArea"
                                asp-items="Model.Areas"
                                class="form-select">

                            <option value="">
                                Seleccione...
                            </option>

                        </select>

                        <span asp-validation-for="IdArea"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ACTIVO -->
                    <div class="col-md-3 mb-3">

                        <label class="form-label d-block">
                            Estatus
                        </label>

                        <div class="form-check form-switch mt-2">

                            <input asp-for="Activo"
                                   class="form-check-input" />

                            <label asp-for="Activo"
                                   class="form-check-label">
                            </label>

                        </div>

                    </div>

                </div>


                <!-- BOTONES -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Guardar

                    </button>

                    <a asp-action="Index"
                           class="btn btn-outline-secondary">

                        Cancelar

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
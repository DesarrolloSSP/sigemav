@using SIGEMAV.Models.ViewModels.Financieros.Proyecto
@model DispEditarVM

@{
	ViewData["Title"] = "Editar Disponibilidad Presupuestal";
}

<div class="container-fluid">

	<!-- ENCABEZADO -->
	<div class="d-flex flex-column flex-md-row
		justify-content-between
		align-items-md-center
		mb-4">

		<div>

			<h3 class="fw-bold mb-1">
				Editar DSP
			</h3>

			<p class="text-muted mb-0">
				Actualización de dictamen de suficiencia presupuestal
			</p>

		</div>

		<div class="mt-3 mt-md-0">

			<a asp-action="Index"
			   class="btn btn-outline-secondary">

				<i class="bi bi-arrow-left"></i>
				Regresar

			</a>

		</div>

	</div>


	<!-- CARD -->
	<div class="card shadow-sm border-0">

		<div class="card-body">

		
			<form method="post"
				  enctype="multipart/form-data">

				<!-- ID -->
				<input asp-for="IdDatosDsp"
					   type="hidden" />


				<input type="hidden"
					   name="recargar"
					   id="recargar"
					   value="false" />

				<!-- VALIDACIONES -->
				<div asp-validation-summary="ModelOnly"
					 class="text-danger mb-3">
				</div>


				<div class="row">

					<!-- OBJETO GASTO -->
					<div class="col-md-6 mb-3">

						<label asp-for="IdObjetoGasto"
							   class="form-label">
						</label>

						<select asp-for="IdObjetoGasto"
								asp-items="Model.ObjetosGasto"
								class="form-select"
								onchange="recargarFormulario()">

							<option value="">
								Seleccione...
							</option>

						</select>

						<span asp-validation-for="IdObjetoGasto"
							  class="text-danger">
						</span>

					</div>


					<!-- DESCRIPCIÓN -->
					<div class="col-md-6 mb-3">

						<label asp-for="DescripcionObjetoGasto"
							   class="form-label">
						</label>

						<input asp-for="DescripcionObjetoGasto"
							   class="form-control"
							   readonly />

					</div>


					<!-- CLAVE AdminFinancieros -->
					<div class="col-md-6 mb-3">

						<label asp-for="IdClaveAdmin"
							   class="form-label">
						</label>

						<select asp-for="IdClaveAdmin"
								asp-items="Model.ClavesAdministrativas"
								class="form-select"
								onchange="recargarFormulario()">

							<option value="">
								Seleccione...
							</option>

						</select>

						<span asp-validation-for="IdClaveAdmin"
							  class="text-danger">
						</span>

					</div>


					<!-- PROYECTO -->
					<div class="col-md-6 mb-3">

						<label asp-for="IdProyecto"
							   class="form-label">
						</label>

						<select asp-for="IdProyecto"
								asp-items="Model.Proyectos"
								class="form-select"
								onchange="this.form.submit()">

							<option value="">
								Seleccione...
							</option>

						</select>

						<span asp-validation-for="IdProyecto"
							  class="text-danger">
						</span>

					</div>


					<!-- AREA -->
					<div class="col-md-6 mb-3">

						<label asp-for="IdArea"
							   class="form-label">
						</label>

						<select asp-for="IdArea"
								asp-items="Model.AreasUsuarias"
								class="form-select">

							<option value="">
								Seleccione...
							</option>

						</select>

						<span asp-validation-for="IdArea"
							  class="text-danger">
						</span>

					</div>


					<!-- IMPORTE -->
					<div class="col-md-6 mb-3">

						<label asp-for="Importe"
							   class="form-label">
						</label>

						<div class="input-group">

							<span class="input-group-text">
								$
							</span>

							<input name="Importe"
								   id="Importe"
								   type="text"
								   class="form-control text-end shadow-sm"
								   value="@(Model.Importe.HasValue
																																																																																									 ? Model.Importe.Value.ToString("N2")
																																																																																		 : "")" />

						</div>

						<span asp-validation-for="Importe"
							  class="text-danger">
						</span>

					</div>


					<!-- NO DSP -->

					<div class="col-md-6">

						<label asp-for="IDsp"
							   class="form-label fw-semibold">
						</label>

						<select asp-for="IDsp"
								asp-items="Model.ListadoDsp"
								class="form-select shadow-sm"
								onchange="this.form.submit()">

							<option value="">
								Seleccione...
							</option>

						</select>

						<span asp-validation-for="IDsp"
							  class="text-danger small">
						</span>

					</div>


					<!-- PDF ACTUAL -->
					@* <div class="col-md-6 mb-3">

						<label class="form-label">
							PDF actual
						</label>

						<div>

							@if (!string.IsNullOrEmpty(Model.RutaArchivo))
							{

								
<a asp-action="VerPdf"
									   asp-route-id="@Model.IdDatosDsp"
									   target="_blank"
									   class="btn btn-outline-secondary"
									   title="Ver PDF">

									<i class="bi bi-file-earmark-pdf"></i>
									Ver PDF actual
								</a>
							}
							else
							{
								<span class="text-muted">
									Sin archivo PDF
								</span>
							}

						</div>

					</div>

 *@
					<!-- NUEVO PDF -->
					@* 	<div class="col-md-6 mb-3">

						<label asp-for="ArchivoPdf"
							   class="form-label">
						</label>

						<input asp-for="ArchivoPdf"
							   type="file"
							   accept=".pdf"
							   class="form-control" />

						<small class="text-muted">
							Opcional. Solo seleccione si desea reemplazar el PDF.
						</small>

						<span asp-validation-for="ArchivoPdf"
							  class="text-danger">
						</span>

					</div> *@


					<!-- ACTIVO -->
					<div class="col-md-3 mb-3">

						<label class="form-label d-block">
							Estatus
						</label>

						<div class="form-check form-switch mt-2">

							<input asp-for="Activo"
								   class="form-check-input" />

							<label asp-for="Activo"
								   class="form-check-label">
							</label>

						</div>

					</div>

				</div>


				<!-- BOTONES -->

				<div class="row mt-4">

						
					<div class="d-flex gap-2">

				

						<button type="submit"
								formaction="@Url.Action("Editar", "DispPresupuestal", new { area = "AdminFinancieros" })"
								onclick="document.getElementById('recargar').value='false'"
								class="btn btn-warning px-4 shadow-sm">

							<i class="bi bi-pencil-square me-1"></i>
							Actualizar

						</button>

					               

						@* <button type="submit"
							formaction="@Url.Action("Concentrado", "Dsp", new { area = "AdminFinancieros" })"
							onclick="document.getElementById('recargar').value='false'"
							class="btn btn-outline-secondary px-4 shadow-sm">
						<i class="bi bi-pencil-square me-1"></i>
						Cancelar

					</button> *@

						<button type="button"
								onclick="window.location.href='@Url.Action("Index", "DispPresupuestal", new { area = "AdminFinancieros" })'"
								class="btn btn-outline-secondary px-4 shadow-sm">

							<i class="bi bi-x-circle me-1"></i>
							Cancelar

						</button>

					</div>

				</div>
			</form>

		</div>

	</div>

</div>


@section Scripts {

	<partial name="_ValidationScriptsPartial" />
	

	<script>

		function recargarFormulario() {

			document.getElementById("recargar")
				.value = "true";

			document.forms[0].submit();
		}

	</script>

	


}
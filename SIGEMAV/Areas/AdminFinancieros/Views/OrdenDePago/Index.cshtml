@model SIGEMAV.Models.ViewModels.OrdeDePago.OrdenDePagoConsultaVM

@{
    ViewData["Title"] = "Orden de Pago";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h4 class="mb-0">
            <i class="bi bi-receipt"></i>
            Generar Orden de Pago
        </h4>
    </div>

    <div class="card-body">
        <form method="post">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label asp-for="NumeroOficio" class="form-label">
                        Número de oficio
                    </label>

                    <input asp-for="NumeroOficio"
                           class="form-control"
                           placeholder="Ejemplo: SSP/AYG/OPV/251/2026" />

                    <span asp-validation-for="NumeroOficio"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <div class="d-flex gap-2">

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                            Buscar
                        </button>

                        @if (Model.Detalles != null && Model.Detalles.Any())
                        {
                            <a asp-area="AdminFinancieros"
                               asp-controller="OrdenDePago"
                               asp-action="ExportarExcel"
                               asp-route-folio="@Model.NumeroOficio"
                               class="btn btn-success"
                               title="Generar Orden de Pago en Excel">

                                <i class="bi bi-file-earmark-excel"></i>
                                Exportar Excel
                            </a>
                        }

                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@if (Model.Detalles != null && Model.Detalles.Any())
{
    var grupos = Model.Detalles
        .GroupBy(x => x.Partida)
        .OrderBy(x =>
            x.Key == "COMBUSTIBLES" ? 1 :
            x.Key == "REFACCIONES" ? 2 :
            x.Key == "MANTENIMIENTO" ? 3 : 4)
        .ToList();

    var totalGeneral = Model.Detalles.Sum(x => x.Importe);

    <div class="card shadow-sm mt-4">

        <div class="card-header bg-white">
            <h5 class="mb-0">
                Resultados encontrados
            </h5>
            <small class="text-muted">
                Oficio: @Model.NumeroOficio
            </small>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Factura</th>
                            <th>Fecha</th>
                            <th>Proveedor</th>
                            <th>Concepto</th>
                            <th>Clave presupuestal</th>
                            <th class="text-center">Cantidad</th>
                            <th class="text-end">Importe</th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var grupo in grupos)
                        {
                            var subtotalPartida = grupo.Sum(x => x.Importe);

                            <tr class="table-secondary">
                                <th colspan="7">
                                    @grupo.Key
                                </th>
                            </tr>

                            @foreach (var item in grupo)
                            {
                                <tr>
                                    <td>
                                        @($"{item.Serie} {item.Folio}")
                                    </td>

                                    <td>
                                        @item.FechaFactura.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        <div>@item.RazonSocial</div>
                                        <small class="text-muted">
                                            @item.RFCEmisor
                                        </small>
                                    </td>

                                    <td>
                                        <div>@item.Descripcion</div>
                                        <small class="text-muted">
                                            @item.ConceptoServicioNombre
                                            @if (!string.IsNullOrWhiteSpace(item.PlacaActual))
                                            {
                                                <span> | @item.PlacaActual</span>
                                            }
                                        </small>
                                    </td>

                                    <td>
                                        @item.ClaveObjGasto
                                    </td>


                                    <td class="text-center">
                                        @item.Cantidad
                                    </td>


                                    <td class="text-end fw-bold">
                                        @item.Importe.ToString("C")
                                    </td>
                                </tr>
                            }

                            <tr class="table-light">
                                <th colspan="6" class="text-end">
                                    Subtotal @grupo.Key
                                </th>

                                <th class="text-end text-primary">
                                    @subtotalPartida.ToString("C")
                                </th>
                            </tr>
                        }

                    </tbody>

                    <tfoot>
                        <tr class="table-success">
                            <th colspan="6" class="text-end">
                                TOTAL GENERAL
                            </th>

                            <th class="text-end fs-5">
                                @totalGeneral.ToString("C")
                            </th>
                        </tr>
                    </tfoot>

                </table>

            </div>

        </div>
    </div>
}

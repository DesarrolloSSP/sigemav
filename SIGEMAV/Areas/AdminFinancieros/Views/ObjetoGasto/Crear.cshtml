@using SIGEMAV.Models.ViewModels.Financieros
@model ObjetoGastoCrudVM

@{
	ViewData["Title"] = "Nuevo Objeto Gasto";
}

<div class="container-fluid">

	<!-- ENCABEZADO -->
	<div class="d-flex flex-column flex-md-row
		justify-content-between
		align-items-md-center
		mb-4">

		<div>

			<h3 class="fw-bold mb-1">
				Nuevo Objeto Gasto
			</h3>

			<p class="text-muted mb-0">
				Registro de catálogo objeto del gasto
			</p>

		</div>

		<div class="mt-3 mt-md-0">

			<a asp-action="Index"
				   class="btn btn-outline-secondary">

				<i class="bi bi-arrow-left"></i>
				Regresar

			</a>

		</div>

	</div>


	<!-- CARD -->
	<div class="card shadow-sm border-0">

		<div class="card-body">

			<form asp-action="Crear"
				  method="post">

				<!-- VALIDACIONES -->
				<div asp-validation-summary="ModelOnly"
					 class="alert alert-danger">
				</div>


				<div class="row">

					<!-- CLAVE -->
					<div class="col-md-4 mb-3">

						<label asp-for="ClaveObjGasto"
							   class="form-label">
						</label>

						<input asp-for="ClaveObjGasto"
							   class="form-control"
							   maxlength="10"
							   autocomplete="off" />

						<span asp-validation-for="ClaveObjGasto"
							  class="text-danger">
						</span>

					</div>


					<!-- ESTATUS -->
					<div class="col-md-3 mb-3">

						<label class="form-label d-block">
							Estatus
						</label>

						<div class="form-check form-switch mt-2">

							<input asp-for="Activo"
								   class="form-check-input" />

							<label asp-for="Activo"
								   class="form-check-label">
							</label>

						</div>

					</div>


					<!-- DESCRIPCIÓN -->
					<div class="col-md-12 mb-3">

						<label asp-for="Descripcion"
							   class="form-label">
						</label>

						<textarea asp-for="Descripcion"
								  class="form-control"
								  rows="4"
									  maxlength="200">
                        </textarea>

							<span asp-validation-for="Descripcion"
								  class="text-danger">
							</span>

						</div>

					</div>


					<!-- BOTONES -->
					<div class="d-flex gap-2">

						<button type="submit"
								class="btn btn-primary">

							<i class="bi bi-save"></i>
							Guardar

						</button>

					


						<a asp-action="Index" class="btn btn-outline-secondary">
							<i class="bi bi-x-circle-fill"></i>
							Regresar
						</a>

					</div>

				</form>

			</div>

		</div>

	</div>


	@section Scripts {

		<partial name="_ValidationScriptsPartial" />

	}
@using SIGEMAV.Models.ViewModels.Financieros.Proyecto
@model ProyectoCrudVM

@{
	ViewData["Title"] = "Editar Proyecto";
}

<div class="container-fluid">

	<!-- ENCABEZADO -->
	<div class="d-flex flex-column flex-md-row
		justify-content-between
		align-items-md-center
		mb-4">

		<div>

			<h3 class="fw-bold mb-1">
				Editar Proyecto
			</h3>

			<p class="text-muted mb-0">
				Actualización de proyecto
			</p>

		</div>

		<div class="mt-3 mt-md-0">

			<a asp-action="Index"
				   class="btn btn-outline-secondary">

				<i class="bi bi-arrow-left"></i>
				Regresar

			</a>

		</div>

	</div>


	<!-- CARD -->
	<div class="card shadow-sm border-0">

		<div class="card-body">

			<form asp-action="Editar"
				  method="post">

				<!-- ID -->
				<input asp-for="IdProyecto"
					   type="hidden" />


				<!-- VALIDACIONES -->
				<div asp-validation-summary="ModelOnly"
					 class="alert alert-danger">
				</div>


				<div class="row">

					<!-- CLAVE AdminFinancieros -->
					<div class="col-md-6 mb-3">

						<label asp-for="IdClaveAdmin"
							   class="form-label">
						</label>

						<select asp-for="IdClaveAdmin"
								asp-items="Model.ClavesAdministrativas"
								class="form-select">

							<option value="">
								Seleccione...
							</option>

						</select>

						<span asp-validation-for="IdClaveAdmin"
							  class="text-danger">
						</span>

					</div>


					<!-- ESTATUS -->
					<div class="col-md-3 mb-3">

						<label class="form-label d-block">
							Estatus
						</label>

						<div class="form-check form-switch mt-2">

							<input asp-for="Activo"
								   class="form-check-input" />

							<label asp-for="Activo"
								   class="form-check-label">
							</label>

						</div>

					</div>


					<!-- CLAVE PROYECTO -->
					<div class="col-md-6 mb-3">

						<label asp-for="ClaveProyecto"
							   class="form-label">
						</label>

						<input asp-for="ClaveProyecto"
							   class="form-control"
							   maxlength="50"
							   autocomplete="off" />

						<span asp-validation-for="ClaveProyecto"
							  class="text-danger">
						</span>

					</div>


					<!-- DESCRIPCIÓN -->
					<div class="col-md-12 mb-3">

						<label asp-for="Descripcion"
							   class="form-label">
						</label>

						<textarea asp-for="Descripcion"
								  class="form-control"
								  rows="4"
									  maxlength="200">
                        </textarea>

							<span asp-validation-for="Descripcion"
								  class="text-danger">
							</span>

						</div>

					</div>


					<!-- BOTONES -->
					<div class="d-flex gap-2">

						<button type="submit"
								class="btn btn-warning">

							<i class="bi bi-pencil-square"></i>
							Actualizar

						</button>

						<a asp-action="Index"
							   class="btn btn-outline-secondary">

							Cancelar

						</a>

					</div>

				</form>

			</div>

		</div>

	</div>


	@section Scripts {

		<partial name="_ValidationScriptsPartial" />

	}
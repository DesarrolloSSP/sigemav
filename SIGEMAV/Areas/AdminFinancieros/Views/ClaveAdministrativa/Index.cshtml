@using SIGEMAV.Models.ViewModels.Financieros.ClaveAdministrativa
@model IEnumerable<ClaveAdministrativaCrudVM>

@{
	ViewData["Title"] = "Catálogo Clave Administrativa";
}

<div class="container-fluid py-3">

	<!-- ENCABEZADO -->
	<div class="card border-0 shadow-sm mb-4">

		<div class="card-body">

			<div class="d-flex flex-column flex-md-row
				justify-content-between
				align-items-md-center">

				<div>

					<h2 class="fw-bold text-dark mb-1">

						<i class="bi bi-building-fill-gear
							text-primary me-2">
						</i>

						Catálogo Clave Administrativa

					</h2>

					<p class="text-muted mb-0">
						Administración de claves administrativas
					</p>

				</div>

				<div class="mt-3 mt-md-0">

					<a asp-action="Crear"
					   class="btn btn-primary px-4 shadow-sm">

						<i class="bi bi-plus-circle me-1"></i>
						Nuevo registro

					</a>

				</div>

			</div>

		</div>

	</div>


	<!-- ALERTA -->
	@if (TempData["Mensaje"] != null)
	{
		<div id="mensajeAlerta"
			 class="alert alert-success alert-dismissible fade show shadow-sm border-0"
			 role="alert">

			<i class="bi bi-check-circle-fill me-2"></i>

			@TempData["Mensaje"]

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert">
			</button>

		</div>
	}


	<!-- TABLA -->
	<div class="card border-0 shadow-sm rounded-4 overflow-hidden">

		<div class="card-body p-0">

			<div class="table-responsive">

				<table class="table table-hover align-middle mb-0">

					<thead class="table-light">

						<tr class="text-secondary">

							<th class="ps-4 py-3">
								Clave administrativa
							</th>

							<th width="140"
								class="text-center py-3">

								Estatus

							</th>

							<th width="180"
								class="text-center py-3 pe-4">

								Acciones

							</th>

						</tr>

					</thead>

					<tbody>

						@if (Model.Any())
						{
							@foreach (var item in Model)
							{
								<tr>

									<!-- CLAVE -->
									<td class="fw-bold ps-4 text-dark">

										@item.ClaveAdmin

									</td>


									<!-- ESTATUS -->
									<td class="text-center">

										          @if (item.Activo)
                                        {
                                            <span class="badge rounded-pill
                                                bg-success-subtle
                                                text-success
                                                px-3 py-2">

                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Activo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill
                                                bg-danger-subtle
                                                text-danger
                                                px-3 py-2">

                                                <i class="bi bi-x-circle-fill me-1"></i>
                                                Inactivo

                                            </span>
                                        }

                                       


									</td>


									<!-- ACCIONES -->
									<td class="text-center pe-4">

										<div class="d-flex justify-content-center
											gap-2">

											<!-- EDITAR -->
											<a asp-action="Editar"
											   asp-route-id="@item.IdClaveAdmin"
											   class="btn btn-sm
												btn-outline-primary
												rounded-pill px-3
												shadow-sm"
											   title="Editar">

												<i class="bi bi-pencil-square"></i>
												
											</a>



											@if (item.Activo)
											{
												<a asp-area="AdminFinancieros"
												   asp-action="Desactivar"
												   asp-route-id="@item.IdClaveAdmin"
												   class="btn btn-sm
													btn-outline-success
													rounded-pill px-3
													shadow-sm"
												   title="Activo - Clic para desactivar"
												   onclick="return confirm('¿Desea desactivar el registro?')">
													<i class="bi bi-check-circle-fill"></i>
													
												</a>
											}
											else
											{
												<a asp-area="AdminFinancieros"
												   asp-action="Activar"
												   asp-route-id="@item.IdClaveAdmin"
												   class="btn btn-sm
													btn-outline-danger
													rounded-pill px-3
													shadow-sm"
												   title="Inactivo - Clic para activar"
												   onclick="return confirm('¿Desea activar el registro?')">

													<i class="bi bi-x-circle-fill"></i>

													

												</a>
											}

										</div>

									</td>

								</tr>
							}
						}
						else
						{
							<tr>

								<td colspan="3"
									class="text-center py-5">

									<div class="d-flex
										flex-column
										align-items-center">

										<i class="bi bi-folder-x
											display-5
											text-muted
											mb-3">
										</i>

										<h5 class="text-muted">
											No existen registros
										</h5>

										<p class="text-muted mb-0">
											Aún no se han agregado claves administrativas
										</p>

									</div>

								</td>

							</tr>
						}

					</tbody>

				</table>

			</div>

		</div>

	</div>

</div>


@section Scripts {

	<script>

		setTimeout(function () {

			let alerta =
				document.getElementById('mensajeAlerta');

			if (alerta) {

				alerta.style.transition =
					"all 0.5s ease";

				alerta.style.opacity = "0";

				alerta.style.marginTop = "0";

				alerta.style.marginBottom = "0";

				alerta.style.padding = "0";

				alerta.style.height = "0";

				setTimeout(function () {

					alerta.remove();

				}, 500);

			}

		}, 3000);

	</script>

}
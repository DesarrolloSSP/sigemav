@using SIGEMAV.Models.ViewModels.Financieros.ClaveAdministrativa
@model ClaveAdministrativaCrudVM

@{
	ViewData["Title"] = "Editar Clave Administrativa";
}

<div class="container-fluid">

	<!-- ENCABEZADO -->
	<div class="d-flex flex-column flex-md-row
		justify-content-between
		align-items-md-center
		mb-4">

		<div>

			<h3 class="fw-bold mb-1">
				Editar Clave Administrativa
			</h3>

			<p class="text-muted mb-0">
				Actualización de clave administrativa
			</p>

		</div>

		<div class="mt-3 mt-md-0">

			<a asp-action="Index"
				   class="btn btn-outline-secondary">

				<i class="bi bi-arrow-left"></i>
				Regresar

			</a>

		</div>

	</div>


	<!-- CARD -->
	<div class="card shadow-sm border-0">

		<div class="card-body">

			<form asp-action="Editar"
				  method="post">

				<!-- ID -->
				<input asp-for="IdClaveAdmin"
					   type="hidden" />


				<div asp-validation-summary="ModelOnly"
					 class="alert alert-danger">
				</div>


				<div class="row">

					<!-- CLAVE -->
					<div class="col-md-6 mb-3">

						<label asp-for="ClaveAdmin"
							   class="form-label">
						</label>

						<input asp-for="ClaveAdmin"
							   class="form-control"
							   maxlength="50"
							   autocomplete="off" />

						<span asp-validation-for="ClaveAdmin"
							  class="text-danger">
						</span>

					</div>


					<!-- ACTIVO -->
					<div class="col-md-3 mb-3">

						<label class="form-label d-block">
							Estatus
						</label>

						<div class="form-check form-switch mt-2">

							<input asp-for="Activo"
								   class="form-check-input" />

							<label asp-for="Activo"
								   class="form-check-label">
							</label>

						</div>

					</div>

				</div>


				<!-- BOTONES -->
				<div class="d-flex gap-2">

					<button type="submit"
							class="btn btn-warning">

						<i class="bi bi-pencil-square"></i>
						Actualizar

					</button>

					<a asp-action="Index"
						   class="btn btn-outline-secondary">

						Cancelar

					</a>

				</div>

			</form>

		</div>

	</div>

</div>

@section Scripts {

	<partial name="_ValidationScriptsPartial" />

}
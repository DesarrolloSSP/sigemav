@model SIGEMAV.Models.ViewModels.Financieros.Dsp.DspVM

@{
	ViewData["Title"] = "Nuevo DSP";
}




@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show auto-hide-alert"
		 role="alert">

		<i class="bi bi-exclamation-triangle-fill me-2"></i>

		@TempData["Error"]

		<button type="button"
				class="btn-close"
				data-bs-dismiss="alert">
		</button>

	</div>
}


<div class="container-fluid">

	<form asp-area="AdminFinancieros"
		  asp-controller="Dsp"
		  asp-action="Create"
		  method="post"
		  enctype="multipart/form-data">

		<div class="card shadow-sm border-0">

			<div class="card-header bg-white">

				<div class="d-flex justify-content-between align-items-center">

					<div>

						<h3 class="fw-bold mb-0">
							<i class="bi bi-file-earmark-plus"></i>
							Nuevo DSP
						</h3>

						<small class="text-muted">
							Captura de DSP
						</small>

					</div>

					

					<a asp-area="AdminFinancieros"
					   asp-controller="Dsp"
					   asp-action="Index"
					   class="btn btn-outline-secondary">
						<i class="bi bi-arrow-left"></i>
						Regresar
					</a>

					

				</div>

			</div>

			<div class="card-body">

				<div asp-validation-summary="ModelOnly"
					 class="alert alert-danger">
				</div>

				<div class="row">

					<div class="col-md-3 mb-3">

						<label asp-for="Fecha"
							   class="form-label fw-semibold">
							Fecha
						</label>

						<input asp-for="Fecha"
							   type="date"
							   class="form-control" />

						<span asp-validation-for="Fecha"
							  class="text-danger">
						</span>

					</div>

					
					<div class="col-md-3 mb-3">

						<label asp-for="NoDsp"
							   class="form-label fw-semibold">
							No. Dsp
						</label>

						<div class="input-group">

							<span class="input-group-text">
								#
							</span>

							<input asp-for="NoDsp"
								   class="form-control text-end" />

						</div>

						<span asp-validation-for="NoDsp"
							  class="text-danger">
						</span>
					</div>

					<div class="col-md-3 mb-3">

						<label asp-for="Importe"
							   class="form-label fw-semibold">
							Importe
						</label>

						<div class="input-group">

							<span class="input-group-text">
								$
							</span>

							<input asp-for="Importe"
								   class="form-control text-end" />

						</div>

						<span asp-validation-for="Importe"
							  class="text-danger">
						</span>

					</div>




				</div>

				<div class="row">

					<div class="col-md-12 mb-3">

						<label asp-for="Descripcion"
							   class="form-label fw-semibold">
							Descripción
						</label>

						<textarea asp-for="Descripcion"
								  class="form-control"
								  rows="4">
                        </textarea>

						<span asp-validation-for="Descripcion"
							  class="text-danger">
						</span>

					</div>

				</div>

				<div class="row">

					<div class="col-md-6 mb-3">

						<label asp-for="Archivo"
							   class="form-label fw-semibold">
						</label>

						<input asp-for="Archivo"
							   type="file"
							   class="form-control"
							   accept=".pdf" />

						<small class="text-muted">
							Solo archivos PDF
						</small>

						<span asp-validation-for="Archivo"
							  class="text-danger">
						</span>



					</div>

				</div>

				<hr />

				<div class="d-flex justify-content-end gap-2">

					<a asp-area="AdminFinancieros"
					   asp-controller="Dsp"
					   asp-action="Index"
					   class="btn btn-outline-secondary">

						<i class="bi bi-x-circle"></i>
						Cancelar
					</a>

					<button type="submit"
							class="btn btn-primary">

						<i class="bi bi-save"></i>
						Guardar DSP
					</button>

				</div>

			</div>

		</div>

	</form>

</div>

@section Scripts {

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}




}
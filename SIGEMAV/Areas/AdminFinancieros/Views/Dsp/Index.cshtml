@model IEnumerable<SIGEMAV.Models.ViewModels.Financieros.Dsp.DspVM>

@{
	ViewData["Title"] = "DSP";
}

<div class="container-fluid">


	@if (TempData["Error"] != null)
	{
		<div class="alert alert-danger alert-dismissible fade show auto-hide-alert"
			 role="alert">

			<i class="bi bi-exclamation-triangle-fill me-2"></i>

			@TempData["Error"]

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert">
			</button>

		</div>
	}

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show auto-hide-alert"
			 role="alert">

			<i class="bi bi-check-circle-fill me-2"></i>

			@TempData["Success"]

			<button type="button"
					class="btn-close"
					data-bs-dismiss="alert">
			</button>

		</div>
	}

	<div class="card shadow-sm border-0">

		<div class="card-header bg-white">

			
			

			<div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

				<div>

					<h3 class="fw-bold mb-0">
						<i class="bi bi-folder2-open"></i>
						DSP
					</h3>

					<small class="text-muted">
						Administración de DSP registrados
					</small>

				</div>

				<div class="d-flex align-items-center gap-2">

					<label for="filtroEstado"
						   class="fw-semibold mb-0">

						Estado:

					</label>

					<select id="filtroEstado"
							class="form-select form-select-sm"
							onchange="cambiarFiltro()"
							style="width:180px;">

						<option value="1" selected>
							Activos
						</option>

						<option value="0">
							Inactivos
						</option>

						<option value="-1">
							Todos
						</option>

					</select>

					<a asp-area="AdminFinancieros"
					   asp-controller="Dsp"
					   asp-action="Create"
					   class="btn btn-primary">

						<i class="bi bi-plus-circle"></i>

						Nuevo DSP

					</a>

				</div>

			</div>

		</div>

		<div class="card-body">

			<div class="table-responsive">

				<table class="table table-hover align-middle">

					<thead class="table-light">

						<tr>

							<th class="text-center py-3 pe-4">Fecha</th>

							<th class="text-center py-3 pe-4">
								No. Dsp
							</th>

							<th class="text-center py-3 pe-4">
								Descripción
							</th>

							<th class="text-center py-3 pe-4">
								Importe
							</th>

							<th class="text-center py-3 pe-4">
								Archivo
							</th>

							<th class="text-center py-3 pe-4">
								Estatus
							</th>

							<th class="text-center py-3 pe-4">
								Acciones
							</th>

						</tr>

					</thead>

					<tbody>

						@if (Model.Any())
						{
							@foreach (var item in Model)
							{
								<tr>

									<td class="fw-semibold">

										@(item.Fecha?.ToString("dd/MM/yyyy"))

									</td>

									<td class="fw-semibold">

										@item.NoDsp

									</td>

									<td>

										@item.Descripcion

									</td>

									<td class="text-end fw-bold text-success">

										@(item.Importe?.ToString("C"))

									</td>

									<td>

										@if (!string.IsNullOrEmpty(item.RutaArchivo))
										{
											<a asp-area="AdminFinancieros"
											   asp-controller="Dsp"
											   asp-action="VerPdf"
											   asp-route-id="@item.IdDsp"
											   target="_blank"
											   class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm">
												<i class="bi bi-file-earmark-pdf"></i>
												Ver PDF
											</a>
										}
										else
										{
											<span class="badge bg-secondary">
												Sin archivo
											</span>
										}

									</td>


									<td class="text-center">

										@if (item.Activo == true)
										{
											<span class="badge bg-success px-3 py-2">

												<i class="bi bi-check-circle"></i>
												ACTIVA

											</span>
										}
										else if (item.Activo == false)
										{
											<span class="badge bg-danger px-3 py-2">

												<i class="bi bi-x-circle"></i>
												CANCELADA

											</span>
										}
										else
										{
											<span class="badge bg-secondary px-3 py-2">

												@item.Activo

											</span>
										}

									</td>


								

									<td class="text-center pe-4">

										<div class="d-flex
											justify-content-center
											gap-2">

											<!-- EDITAR -->
											<a asp-area="AdminFinancieros"
											   asp-controller="Dsp"
											   asp-action="Edit"
											   asp-route-id="@item.IdDsp"
											   class="btn btn-sm
												btn-outline-primary
												rounded-pill px-3
												shadow-sm"
											   title="Editar">

												<i class="bi bi-pencil-square"></i>
												Editar
											</a>

										
											@if (item.Activo)
											{
												<a asp-area="AdminFinancieros"
												   asp-action="Desactivar"
												   asp-route-id="@item.IdDsp"
												   class="btn btn-sm
													btn-outline-success
													rounded-pill px-3
													shadow-sm"
												   title="Activo - Clic para desactivar"
												   onclick="return confirm('¿Desea desactivar el registro?')">

													<i class="bi bi-check-circle-fill"></i>

													Activo

												</a>
											}
											else
											{
												<a asp-area="AdminFinancieros"
												   asp-action="Activar"
												   asp-route-id="@item.IdDsp"
												   class="btn btn-sm
													btn-outline-danger
													rounded-pill px-3
													shadow-sm"
												   title="Inactivo - Clic para activar"
												   onclick="return confirm('¿Desea activar el registro?')">

													<i class="bi bi-x-circle-fill"></i>

													Inactivo

												</a>
											}

											
										</div>

									</td>

								</tr>
							}
						}
						else
						{
							<tr>

								<td colspan="5">

									<div class="text-center py-5">

										<i class="bi bi-inbox fs-1 text-muted"></i>

										<h5 class="mt-3">
											No existen registros
										</h5>

										<p class="text-muted">
											Comienza agregando un nuevo DSP.
										</p>

									</div>

								</td>

							</tr>
						}

					</tbody>

				</table>

			</div>

		</div>

	</div>

</div>

@section Scripts {

	<script>

		function cambiarFiltro() {

			var estado =
				document.getElementById("filtroEstado").value;

			window.location.href =
				'/AdminFinancieros/Dsp/Index?estado=' + estado;
		}

	</script>
}

						
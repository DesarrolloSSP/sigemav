@using System.Security.Claims



@{
	var roles = User.Claims
		.Where(x => x.Type == ClaimTypes.Role)
		.Select(x => x.Value)
		.ToList();

	bool esSysadmin = roles.Contains("Sysadmin");
}



<!DOCTYPE html>
<html lang="es">

<head>

	<meta charset="utf-8" />

	<meta name="viewport" content="width=device-width, initial-scale=1.0" />

	<title>@ViewData["Title"] - SIGEMAV</title>

	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

	<link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

	<link rel="stylesheet" href="~/SIGEMAV.styles.css" asp-append-version="true" />

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>

<body>

	<div class="app">

		<!-- SIDEBAR -->
		<aside id="sidebar" class="sidebar">

			<div class="sidebar-header">

				<img src="~/img/logo/SIGEMAV_blanco.png" class="logo-img" alt="SIGEMAV" />

			</div>

			<nav class="sidebar-menu">


				<div class="menu-section">
					<a asp-area="" asp-controller="Home"
					   asp-action="Index"
					   class="menu-parent">

						<div>
							<i class="bi bi-house-door-fill"></i>
							<span>INICIO</span>
						</div>

					</a>

				</div>


				@if (roles.Contains("AdminFinancieros") || esSysadmin)
				{
					<div class="menu-section">

						<button type="button" class="menu-parent">

							<div>

								<i class="bi bi-cash-stack"></i>

								<span>FINANCIEROS</span>

							</div>

							<i class="bi bi-chevron-down"></i>

						</button>

						<div class="submenu">

							<a asp-area="AdminFinancieros"
							   asp-controller="Dsp"
							   asp-action="Index">

								<i class="bi bi-file-earmark-text"></i>

								<span>DSP</span>

							</a>

							<a asp-area="AdminFinancieros"
							   asp-controller="DispPresupuestal"
							   asp-action="Index">

								<i class="bi bi-cash-stack"></i>

								<span>Disponibilidad Presupuestal</span>

							</a>

							<a asp-area="AdminFinancieros"
							   asp-controller="Odp"
							   asp-action="Index">

								<i class="bi bi-receipt"></i>

								<span>Órdenes de Pago</span>

							</a>

						</div>

					</div>

					<div class="menu-section">

						<button type="button" class="menu-parent">

							<div>

								<i class="bi bi-folder2-open"></i>

								<span>CATÁLOGOS</span>

							</div>

							<i class="bi bi-chevron-down"></i>

						</button>

						<div class="submenu">

							<a asp-area="AdminFinancieros" asp-controller="ObjetoGasto"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Objeto Gasto</span>

							</a>

							<a asp-area="AdminFinancieros" asp-controller="ClaveAdministrativa"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Clave Administrativa</span>

							</a>

							<a asp-area="AdminFinancieros" asp-controller="Proyecto"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Proyecto</span>

							</a>

							<a asp-area="AdminFinancieros" asp-controller="ProyectoArea"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Proyecto - Área</span>

							</a>

						</div>

					</div>
				}

				@if (roles.Contains("AdminMaquinaria") || esSysadmin)
				{
					<div class="menu-section">

						<button type="button" class="menu-parent">

							<div>

								<i class="bi bi-folder2-open"></i>

								<span>GESTIÓN DE VEHÍCULOS</span>

							</div>

							<i class="bi bi-chevron-down"></i>

						</button>

						<div class="submenu">

							<a asp-area="Maquinaria" asp-controller="UnidadVehicular"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Plantilla vehicular</span>

							</a>

							<a asp-area="Maquinaria" asp-controller="SolicitudMantenimiento"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Solicitudes de Mantenimiento</span>

							</a>

							<a asp-area="Maquinaria" asp-controller="Mantenimiento"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Mantenimiento</span>

							</a>

							<a asp-area="Maquinaria" asp-controller="Transferencia"
							   asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Transferencias</span>

							</a>

						</div>

					</div>



					<div class="menu-section">

						<button type="button" class="menu-parent">

							<div>

								<i class="bi bi-folder2-open"></i>

								<span>CATÁLOGOS</span>

							</div>

							<i class="bi bi-chevron-down"></i>

						</button>

						<div class="submenu">

							<a asp-area="Maquinaria" asp-controller="TipoCatalogoServicio" asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Tipo de catálogo de servicio</span>

							</a>

							<a asp-area="Maquinaria" asp-controller="ConceptoServicio" asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Conceptos de Servicio</span>

							</a>

							<a asp-area="Maquinaria" asp-controller="ConceptoServicioCosto" asp-action="Index">

								<i class="bi bi-folder"></i>

								<span>Costos de Servicio</span>

							</a>

							<a asp-area="Maquinaria" asp-controller="ConfiguracionValidacionTecnica" asp-action="index">

								<i class="bi bi-folder"></i>

								Configuración de Validación Técnica

							</a>

						</div>

					</div>


				}

			</nav>

		</aside>


		<!-- FONDO OSCURO MÓVIL -->
		<div id="sidebarOverlay"></div>


		<!-- MAIN -->
		<div class="app-main">

			<header class="topbar">

				<button id="btnMenu"
						class="btn-menu">

					<i class="bi bi-list"></i>

				</button>

				<div class="topbar-title">

					@ViewData["Title"]

				</div>

								
				<div class="topbar-user">

					<span>
						<i class="bi bi-person-circle"></i>
						@User.Identity?.Name
					</span>

					@if (roles.Any())
					{
						<span class="text-muted">
							(@string.Join(" | ", roles))
						</span>
					}

					<span>|</span>

					<form asp-area="Account"
						  asp-controller="Account"
						  asp-action="Logout"
						  method="post">

						@Html.AntiForgeryToken()

						<button type="submit"
								class="logout-link">

							Cerrar sesión

						</button>

					</form>

				</div>


			</header>


			
		

			<!-- CONTENIDO GRAL. -->
			<main class="content">

				@RenderBody()

			</main>

						
			
			<footer class="footer">

				<div class="footer-text">

					Se prohíbe la reproducción total o parcial contenida en este sistema informático sin el consentimiento expreso y por escrito de la Secretaría de Seguridad Pública del Estado de Veracruz. © @DateTime.Now.Year - Derechos Reservados.

				</div>

			</footer>

		</div>

	</div>

		

	


	<script>

			document.addEventListener('DOMContentLoaded', function () {

				const sidebar = document.getElementById('sidebar');
				const btnMenu = document.getElementById('btnMenu');
				const overlay = document.getElementById('sidebarOverlay');

				// Menú hamburguesa
				btnMenu.addEventListener('click', function () {

					if (window.innerWidth <= 1200) {

						sidebar.classList.toggle('mobile-open');
						overlay.classList.toggle('show');

					} else {

						sidebar.classList.toggle('collapsed');

					}

				});

				// Submenús
				document.querySelectorAll('.menu-parent').forEach(menu => {

					menu.addEventListener('click', function () {

						const submenu = this.nextElementSibling;

						if (!submenu ||
							!submenu.classList.contains('submenu'))
							return;

						submenu.classList.toggle('show');

						const icon =
							this.querySelector('.bi-chevron-down');

						if (icon)
							icon.classList.toggle('chevron-rotate');

					});

				});

				// Cerrar menú al seleccionar opción
				document.querySelectorAll('.sidebar a').forEach(link => {

					link.addEventListener('click', () => {

						if (window.innerWidth <= 1200) {

							sidebar.classList.remove('mobile-open');
							overlay.classList.remove('show');

						}

					});

				});

				// Cerrar al tocar fondo oscuro
				overlay.addEventListener('click', function () {

					sidebar.classList.remove('mobile-open');
					overlay.classList.remove('show');

				});

			});

	</script>




	<script>
			document.addEventListener('DOMContentLoaded', function () {

				setTimeout(function () {

					document
						.querySelectorAll('.auto-hide-alert')
						.forEach(function (alert) {

							let bsAlert =
								bootstrap.Alert.getOrCreateInstance(alert);

							bsAlert.close();

						});

				}, 4000);

			});
	</script>





	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/dsp.js" asp-append-version="true"></script>
	<partial name="_AlertsPartial" />
	@await RenderSectionAsync("Scripts", required: false)

</body>

</html>



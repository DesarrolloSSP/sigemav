@using System.Security.Claims

@{
    var roles = User.Claims
     .Where(x => x.Type == ClaimTypes.Role)
     .Select(x => x.Value.Trim())
     .ToList();

    bool esSysadmin = roles.Any(x =>
     x.Equals("Sysadmin", StringComparison.OrdinalIgnoreCase));

    bool esAdminFinancieros = roles.Any(x =>
     x.Equals("AdminFinancieros", StringComparison.OrdinalIgnoreCase));

    bool esAdminMaquinaria = roles.Any(x =>
     x.Equals("AdminMaquinaria", StringComparison.OrdinalIgnoreCase));

    bool esAreaOperativa = roles.Any(x =>
    x.Equals("AreaOperativa", StringComparison.OrdinalIgnoreCase));

}








<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

@if (TempData["Success"] != null)
{
    <script>

        Swal.fire({

        icon: 'success',

        title: 'Operación realizada',

        text: '@TempData["Success"]',

        confirmButtonColor: '#800705'

        });

    </script>
}

@if (TempData["Error"] != null)
{
    <script>

        Swal.fire({

        icon: 'error',

        title: 'Error',

        text: '@TempData["Error"]',

        confirmButtonColor: '#800705'

        });

    </script>
}

@if (TempData["Warning"] != null)
{
    <script>

        Swal.fire({

        icon: 'warning',

        title: 'Atención',

        text: '@TempData["Warning"]',

        confirmButtonColor: '#800705'

        });

    </script>
}

@if (TempData["Info"] != null)
{
    <script>

        Swal.fire({

        icon: 'info',

        title: 'Información',

        text: '@TempData["Info"]',

        confirmButtonColor: '#800705'

        });

    </script>
}


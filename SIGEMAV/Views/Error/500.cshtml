@{
    ViewData["Title"] = "Error Interno";
}

<div class="container py-5">

    <div class="text-center">

        <img src="~/img/logo/SIGEMAV_01.png"
             alt="SIGEMAV"
             style="max-width:220px;"
             class="mb-4" />

        <h1 class="display-1 text-danger fw-bold">
            500
        </h1>

        <h2 class="mb-3">
            Error Interno del Sistema
        </h2>

        <p class="lead text-muted">

            Ocurrió un error inesperado durante el procesamiento de la solicitud.

        </p>

        <p class="text-secondary">

            Si el problema persiste, comuníquese con el área de Tecnologías de la Información.

        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-primary btn-lg">

            <i class="bi bi-house-door-fill"></i>
            Regresar al Inicio

        </a>

    </div>

</div>